# Source control for the offline CSNZ mod: code, configuration, data tables and notes only.

# copies of the game's original files and runtime logs
mod/backup/
mod/logs/
*.log

# third-party tools (downloaded, not ours)
mod/tools/ghidra/
mod/tools/rea/
mod/tools/rea-npm/
mod/tools/cheatengine-mcp-bridge/

# build outputs (rebuilt from source)
*.obj
*.asi
*.exe
*.dll
*.pdb
*.lib
*.exp
*.ilk
__pycache__/
*.pyc

# private keys and certificates
*.pem
*.key

# server runtime state: user databases and their backups, logs
*.db3
mod/server/CSNZ_Server/bin/Logs/
mod/server/CSNZ_Server/bin/Data/*.before-*
mod/server/CSNZ_Server/bin/Data/*.broken-*

# shop assets exported from the game's files (mod/tools/export_shop_assets.py)
mod/web/shop/models/
mod/web/shop/icons/
mod/web/pictures.json
mod/web/shop/sounds/
mod/web/shop/promo/
# medal icons and table exported from the game (mod/tools/gen_medals.py)

# shortcuts
*.lnk

# CSNZ_Server source checkout (rebuilt from upstream + mod/server/patches)
mod/server/src-repo/

# crash dumps
*.mdmp
*.dmp
mod/web/profile/medals/
mod/web/missions/npc/

# release builds (mod/tools/release/build_release.py) and the launcher's build and per-PC files
dist/
launcher/bin/
launcher/obj/
launcher.json
launcher-check.txt
# Steam bridge: build output and runtime files
mod/tools/steambridge/out/
mod/tools/steambridge/bin/
mod/tools/steambridge/obj/
mod/server/CSNZ_Server/bin/Data/RemoteRooms.json
mod/server/CSNZ_Server/bin/Data/SteamIdentity.json
mod/server/CSNZ_Server/bin/Data/StudioNet.json
mod/server/CSNZ_Server/bin/Data/GuestCheckouts.json
mod/server/CSNZ_Server/bin/Data/GuestBackups/
mod/server/CSNZ_Server/bin/Data/SteamBridge.stop

# the developer's own player install (launcher + release, like everyone else's): not part of the sources
/Play/

# Studio maps made by players (the sample-map list templates.json is shipped)
mod/server/CSNZ_Server/bin/Data/Studio/*
!mod/server/CSNZ_Server/bin/Data/Studio/templates.json
!mod/server/CSNZ_Server/bin/Data/Studio/resources/
mod/server/CSNZ_Server/bin/Data/Studio/resources/*
!mod/server/CSNZ_Server/bin/Data/Studio/resources/tmpl_*.vxl
