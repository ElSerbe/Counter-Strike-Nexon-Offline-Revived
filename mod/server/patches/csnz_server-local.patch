+void CMedalManager::OnKill(CGameMatchUserStat* stat, CGameMatch* match, const GameMatch_KillEvent& ev)
+{
+	auto& c = stat->m_Counters;
+	// victimKillType: the killer's side in the high byte (0x100 / 0x200), flags in the low one (1: headshot)
+	if (ev.victimKillType & 1)
+		c["Headshots"]++;
+	if (ev.victimUserID == 0)
+		c["BotKills"]++;
+	if (ev.gunID > 0 && g_pItemTable->GetRowIdx(to_string(ev.gunID)) >= 0)
+	{
+		switch (g_pItemTable->GetCell<int>("Category", to_string(ev.gunID)))
+		{
+		case 1: c["PistolKills"]++; break;
+		case 2: c["ShotgunKills"]++; break;
+		case 3: c["SmgKills"]++; break;
+		case 4: c["RifleKills"]++; break;
+		case 5: c["MgKills"]++; break;
+		case 6: c["GrenadeKills"]++; break;
+		case 11: c["MeleeKills"]++; break;
+		}
+	}
+	if (IsZombieModeOffline(match->m_nGameMode))
+	{
+		if (ev.killerTeam == 1)
+			c["Infections"]++;
+		else if (ev.killerTeam == 2 && ev.victimTeam == 1)
+			c["ZombieKills"]++;
+	}
+}
