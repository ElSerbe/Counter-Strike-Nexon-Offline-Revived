+json CWarbondManager::BuildState(IUser* user)
+{
+	// a page asked for by the game (once)
+	string openView;
+	auto view = m_OpenView.find(user->GetID());
+	if (view != m_OpenView.end())
+	{
+		openView = view->second;
+		m_OpenView.erase(view);
+	}
+	if (!openView.empty())
+		return { { "openView", openView } };
+
+	CUserCharacter character = user->GetCharacter(UFLAG_LOW_POINTS | UFLAG_LOW_GAMENAME);
+
+	vector<WarbondUnlock_s> unlocks;
+	g_UserDatabase.GetWarbondUnlocks(user->GetID(), unlocks);
+
+	// "owned" means it's in the inventory right now: items unlocked earlier can be gone (used for crafting,
+	// deleted...), and then they can be unlocked again. Unlock records only count the medals spent per pass.
+	set<int> owned = OwnedItems(user);
+	map<int, int> spent;
+	set<int> unlockedBefore, passes;
+	for (auto& u : unlocks)
+	{
+		// itemID 0 records the pass itself being bought; any unlock in a pass also counts as owning it
+		// (items bought before passes had a price)
+		passes.insert(u.warbondID);
+		if (!u.itemID)
+			continue;
+		spent[u.warbondID] += u.cost;
+		unlockedBefore.insert(u.itemID);
+	}
+
+	json state;
+	state["character"] = character.gameName;
+	state["medals"] = character.points;
+	// the character the player has selected, shown holding weapons in the 3D preview
+	state["characterItem"] = user->GetCharacterExtended(EXT_UFLAG_CHARACTERID).characterID;
+
+	state["warbonds"] = json::array();
+	for (auto& w : m_Warbonds)
+	{
+		json jw = { { "id", w.id }, { "name", w.name }, { "type", w.type }, { "description", w.description },
+			{ "image", w.image }, { "spent", spent[w.id] }, { "cost", w.cost }, { "purchased", w.cost <= 0 || passes.count(w.id) > 0 } };
+		if (w.theme.size() == 2)
+			jw["theme"] = w.theme;
+		int total = 0, have = 0;
+		jw["pages"] = json::array();
+		for (size_t p = 0; p < w.pages.size(); p++)
+		{
+			const WarbondPage& page = w.pages[p];
+			json jp = { { "unlock", page.unlockSpent }, { "unlocked", spent[w.id] >= page.unlockSpent }, { "title", page.title } };
+			jp["items"] = json::array();
+			for (auto& item : page.items)
+			{
+				bool isOwned = !item.repeatable && owned.count(item.itemID) > 0;
+				bool rebuy = !item.repeatable && !isOwned && unlockedBefore.count(item.itemID) > 0;
+				total += !item.repeatable;
+				have += isOwned;
+				jp["items"].push_back({ { "id", item.itemID }, { "cost", rebuy ? RebuyCost(item.cost) : item.cost }, { "fullCost", item.cost },
+					{ "owned", isOwned }, { "rebuy", rebuy }, { "repeatable", item.repeatable }, { "days", item.days },
+					{ "name", !item.name.empty() ? item.name : m_ItemNames.count(item.itemID) ? m_ItemNames[item.itemID] : ItemCell(item.itemID, "Name") }, { "category", CategoryName(item.itemID) },
+					{ "resource", ItemCell(item.itemID, "recourcename") }, { "stats", WeaponStats(item.itemID) } });
+			}
+			jw["pages"].push_back(jp);
+		}
+		jw["owned"] = have;
+		jw["total"] = total;
+		state["warbonds"].push_back(jw);
+	}
+
+	AdvanceOrders(user, -1, { { "Level", user->GetCharacter(UFLAG_LOW_LEVEL).level }, { "TotalUnlocks", CountItemUnlocks(user) } });
+
+	vector<OrderProgress_s> progress;
+	g_UserDatabase.GetOrderProgress(user->GetID(), progress);
+	state["orders"] = json::array();
+	for (auto& o : m_Orders)
+	{
+		int periodStart = CurrentPeriodStart(o.period);
+		OrderProgress_s current = { o.id, periodStart, 0, false };
+		for (auto& p : progress)
+			if (p.orderID == o.id && p.periodStart == periodStart)
+				current = p;
+		int periodLength = o.period == "Weekly" ? 7 * 86400 : o.period == "Challenge" ? 0 : 86400;
+		state["orders"].push_back({ { "id", o.id }, { "period", o.period }, { "group", o.group }, { "text", o.text }, { "progress", min(current.progress, o.target) },
+			{ "target", o.target }, { "reward", o.reward }, { "tickets", o.tickets }, { "completed", current.completed },
+			{ "resetsIn", periodLength ? max(0, periodStart + periodLength - (int)time(NULL)) : 0 } });
+	}
+
+	return state;
+}
+
+json CWarbondManager::Unlock(IUser* user, int warbondID, int itemID, int quantity, int& status)
+{
+	auto fail = [&](int code, const char* message)
+	{
+		status = code;
+		return json{ { "error", message } };
+	};
+
+	const Warbond* warbond = NULL;
+	for (auto& w : m_Warbonds)
+		if (w.id == warbondID)
+			warbond = &w;
+	if (!warbond)
+		return fail(400, "Unknown battle pass.");
+
+	const WarbondPage* page = NULL;
+	const WarbondItem* item = NULL;
+	for (auto& p : warbond->pages)
+		for (auto& i : p.items)
+			if (i.itemID == itemID)
+			{
+				page = &p;
+				item = &i;
+			}
+	if (!item)
+		return fail(400, "That item isn't in this battle pass.");
+
+	vector<WarbondUnlock_s> unlocks;
+	g_UserDatabase.GetWarbondUnlocks(user->GetID(), unlocks);
+	int spent = 0;
+	bool rebuy = false, purchased = warbond->cost <= 0;
+	for (auto& u : unlocks)
+	{
+		purchased |= u.warbondID == warbondID;
+		if (u.warbondID == warbondID && u.itemID)
+			spent += u.cost;
+		rebuy |= u.itemID == itemID;
+	}
+	if (!purchased)
+		return fail(409, "Unlock this battle pass first.");
+	if (item->repeatable)
+	{
+		// supplies: any quantity, nothing is recorded (they don't count towards pages or orders)
+		quantity = min(max(quantity, 1), 99);
+		int total = item->cost * quantity;
+		if (spent < page->unlockSpent)
+			return fail(409, "This page is still locked.");
+		if (user->GetCharacter(UFLAG_LOW_POINTS).points < total)
+			return fail(409, "Not enough medals.");
+		int added = item->days ? g_ItemManager.AddItem(user->GetID(), user, itemID, 1, item->days * quantity) : ITEM_ADD_SUCCESS;
+		for (int n = 0; !item->days && n < quantity && added == ITEM_ADD_SUCCESS; n++)
+			added = g_ItemManager.AddItem(user->GetID(), user, itemID, 1, 0);
+		if (added == ITEM_ADD_INVENTORY_FULL)
+			return fail(409, "Your inventory is full.");
+		if (added != ITEM_ADD_SUCCESS)
+			return fail(500, "Couldn't add the item.");
+		user->UpdatePoints(-total);
+		Logger().Info("WarbondManager: user %d bought %d x item %d (supplies) for %d medals\n", user->GetID(), quantity, itemID, total);
+		return BuildState(user);
+	}
+	if (OwnedItems(user).count(itemID))
+		return fail(409, "You already own this item.");
+	// items unlocked before and lost since (used for crafting, deleted...) cost half to get back
+	int cost = rebuy ? RebuyCost(item->cost) : item->cost;
+	if (spent < page->unlockSpent)
+		return fail(409, "This page is still locked.");
+
+	CUserCharacter character = user->GetCharacter(UFLAG_LOW_POINTS);
+	if (character.points < cost)
+		return fail(409, "Not enough medals.");
+
+	int added = g_ItemManager.AddItem(user->GetID(), user, itemID, 1, 0);
+	if (added == ITEM_ADD_INVENTORY_FULL)
+		return fail(409, "Your inventory is full.");
+	if (added != ITEM_ADD_SUCCESS)
+		return fail(500, "Couldn't add the item.");
+
+	user->UpdatePoints(-cost);
+	g_UserDatabase.AddWarbondUnlock(user->GetID(), { warbondID, itemID, cost });
+	Logger().Info("WarbondManager: user %d %s item %d from battle pass %d for %d medals\n", user->GetID(), rebuy ? "bought back" : "unlocked", itemID, warbondID, cost);
+	AdvanceOrders(user, -1, { { "Unlocks", 1 }, { "TotalUnlocks", CountItemUnlocks(user) } });
+
+	return BuildState(user);
+}
+
+json CWarbondManager::UnlockPass(IUser* user, int warbondID, int& status)
+{
+	auto fail = [&](int code, const char* message)
+	{
+		status = code;
+		return json{ { "error", message } };
+	};
+
+	const Warbond* warbond = NULL;
+	for (auto& w : m_Warbonds)
+		if (w.id == warbondID)
+			warbond = &w;
+	if (!warbond)
+		return fail(400, "Unknown battle pass.");
+	if (warbond->cost <= 0)
+		return fail(409, "This battle pass is free.");
+
+	vector<WarbondUnlock_s> unlocks;
+	g_UserDatabase.GetWarbondUnlocks(user->GetID(), unlocks);
+	for (auto& u : unlocks)
+		if (u.warbondID == warbondID)
+			return fail(409, "You already have this battle pass.");
+
+	CUserCharacter character = user->GetCharacter(UFLAG_LOW_POINTS);
+	if (character.points < warbond->cost)
+		return fail(409, "Not enough medals.");
+
+	user->UpdatePoints(-warbond->cost);
+	g_UserDatabase.AddWarbondUnlock(user->GetID(), { warbondID, 0, warbond->cost });
+	Logger().Info("WarbondManager: user %d unlocked battle pass %d for %d medals\n", user->GetID(), warbondID, warbond->cost);
+
+	return BuildState(user);
+}
+
+int CWarbondManager::CountItemUnlocks(IUser* user)
+{
+	vector<WarbondUnlock_s> unlocks;
+	g_UserDatabase.GetWarbondUnlocks(user->GetID(), unlocks);
+	int count = 0;
+	for (auto& u : unlocks)
+		count += u.itemID != 0;
+	return count;
+}
+
+/**
+ * Advances daily/weekly orders and permanent challenges with what just happened. Order types:
+ *   Matches, Wins, Kills, TopPlayer (finished 1st), Unlocks (battle pass items), LevelUps: add up
+ *   BestKills (kills in one match), Level (level reached), TotalUnlocks: the best value counts
+ * gameMode -1: not a match event (only orders without "GameModes" apply).
+ */
+void CWarbondManager::AdvanceOrders(IUser* user, int gameMode, const map<string, int>& events)
+{
+	static const set<string> bestValue = { "BestKills", "Level", "TotalUnlocks" };
+
+	vector<OrderProgress_s> progress;
+	g_UserDatabase.GetOrderProgress(user->GetID(), progress);
+	for (auto& o : m_Orders)
+	{
+		auto event = events.find(o.type);
+		if (event == events.end() || event->second <= 0)
+			continue;
+		if (!o.gameModes.empty() && find(o.gameModes.begin(), o.gameModes.end(), gameMode) == o.gameModes.end())
+			continue;
+
+		int periodStart = CurrentPeriodStart(o.period);
+		OrderProgress_s current = { o.id, periodStart, 0, false };
+		for (auto& p : progress)
+			if (p.orderID == o.id && p.periodStart == periodStart)
+				current = p;
+		if (current.completed)
+			continue;
+
+		int value = bestValue.count(o.type) ? max(current.progress, event->second) : current.progress + event->second;
+		value = min(value, o.target);
+		if (value == current.progress)
+			continue;
+		current.progress = value;
+		if (current.progress >= o.target)
+		{
+			current.completed = true;
+			int medals = PenalizedMedals(user, o.reward);
+			user->UpdatePoints(medals);
+			string reward = o.reward ? va("+%d medals%s", medals, medals < o.reward ? " (sv_cheats)" : "") : "";
+			if (o.tickets)
+				reward += string(reward.empty() ? "" : ", ") + va("+%d Bingo Ticket%s", o.tickets, o.tickets == 1 ? "" : "s");
+			g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(),
+				va("%s complete: %s (%s)", o.period == "Challenge" ? "Challenge" : "Order", o.text.c_str(), reward.c_str()));
+			if (o.tickets)
+				g_BingoManager.GiveTickets(user, o.tickets, NULL);
+			// statistics for the medals: orders done, weekly ones, days with every daily order done
+			g_MedalManager.AddCounter(user, "OrdersDone", 1);
+			if (o.period == "Weekly")
+				g_MedalManager.AddCounter(user, "WeeklyOrdersDone", 1);
+			if (o.period == "Daily")
+			{
+				bool allDaily = true;
+				for (auto& other : m_Orders)
+				{
+					if (other.period != "Daily" || other.id == o.id)
+						continue;
+					bool done = false;
+					for (auto& p : progress)
+						if (p.orderID == other.id && p.periodStart == periodStart && p.completed)
+							done = true;
+					allDaily &= done;
+				}
+				if (allDaily)
+					g_MedalManager.AddCounter(user, "PerfectDays", 1);
+			}
+		}
+		g_UserDatabase.SetOrderProgress(user->GetID(), current);
+		// later orders of this call see it (several daily orders can finish in the same match)
+		bool known = false;
+		for (auto& p : progress)
+			if (p.orderID == current.orderID)
+				p = current, known = true;
+		if (!known)
+			progress.push_back(current);
+	}
+}
+
+int CWarbondManager::CountHeadshots(const map<int, int>& killTypes)
+{
+	if (m_Medals.headshotKillType < 0)
+		return 0;
+	auto it = killTypes.find(m_Medals.headshotKillType);
+	return it != killTypes.end() ? it->second : 0;
+}
+
+int CWarbondManager::OnMatchResult(IUser* user, int gameMode, int kills, int headshots, bool won, bool topPlayer)
+{
+	int killMedals = kills / m_Medals.killsPerMedal;
+	if (m_Medals.maxKillMedals > 0)
+		killMedals = min(killMedals, m_Medals.maxKillMedals);
+	int full = m_Medals.perMatch + (won ? m_Medals.perWin : 0) + killMedals;
+	int medals = PenalizedMedals(user, full);
+
+	if (m_Medals.logKills)
+		Logger().Info("WarbondManager: user %d match result: mode %d, kills %d, headshots %d, won %d, first %d -> %d medals (%d match + %d win + %d kills%s)\n",
+			user->GetID(), gameMode, kills, headshots, won, topPlayer, medals, m_Medals.perMatch, won ? m_Medals.perWin : 0, killMedals,
+			medals < full ? va(", sv_cheats: -%d%% of %d", m_Medals.cheatPenalty, full) : "");
+
+	AdvanceOrders(user, gameMode, { { "Matches", 1 }, { "Wins", won ? 1 : 0 }, { "Kills", kills }, { "BestKills", kills },
+		{ "TopPlayer", topPlayer ? 1 : 0 }, { "Headshots", headshots } });
+	g_BingoManager.OnMatchResult(user, kills, won);
+	g_ZSRiftManager.OnMatchResult(user, kills, won);
+	return medals;
+}
+
+int CWarbondManager::CompletedPasses(IUser* user)
+{
+	set<int> owned = OwnedItems(user);
+	vector<WarbondUnlock_s> unlocks;
+	g_UserDatabase.GetWarbondUnlocks(user->GetID(), unlocks);
+	set<pair<int, int>> unlocked;
+	for (auto& u : unlocks)
+		unlocked.insert({ u.warbondID, u.itemID });
+	int completed = 0;
+	for (auto& wb : m_Warbonds)
+	{
+		bool any = false, all = true;
+		for (auto& page : wb.pages)
+			for (auto& item : page.items)
+			{
+				if (item.repeatable)
+					continue;
+				any = true;
+				if (!owned.count(item.itemID) && !unlocked.count({ wb.id, item.itemID }))
+					all = false;
+			}
+		completed += any && all;
+	}
+	return completed;
+}
+
+void CWarbondManager::SetCheatPenalty(IUser* user, bool on)
+{
+	if (on)
+		m_CheatUsers.insert(user->GetID());
+	else
+		m_CheatUsers.erase(user->GetID());
+}
+
+// what is left of medals earned in a match played with sv_cheats on (rounded)
+int CWarbondManager::PenalizedMedals(IUser* user, int medals) const
+{
+	if (medals <= 0 || !m_CheatUsers.count(user->GetID()))
+		return medals;
+	return (medals * (100 - m_Medals.cheatPenalty) + 50) / 100;
+}
+
+void CWarbondManager::OnLevelUp(IUser* user, int oldLevel, int newLevel)
+{
+	int medals = 0;
+	for (int level = oldLevel + 1; level <= newLevel; level++)
+		medals += level * m_Medals.levelUpPerLevel;
+	int full = medals;
+	medals = PenalizedMedals(user, medals);
+	if (medals > 0)
+	{
+		user->UpdatePoints(medals);
+		g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), va("Level %d reached! +%d medals%s", newLevel, medals,
+			medals < full ? " (sv_cheats)" : ""));
+	}
+	AdvanceOrders(user, -1, { { "LevelUps", newLevel - oldLevel }, { "Level", newLevel } });
+	g_BingoManager.OnLevelUp(user, oldLevel, newLevel);
+	g_MedalManager.CheckMedals(user);
+}
+
+vector<pair<int, int>> CWarbondManager::PassItems() const
+{
+	vector<pair<int, int>> items;
+	set<int> seen;
+	for (auto& w : m_Warbonds)
+		for (auto& p : w.pages)
+			for (auto& i : p.items)
+				if (i.itemID && !i.repeatable && seen.insert(i.itemID).second)
+					items.push_back({ i.itemID, i.cost });
+	return items;
+}
