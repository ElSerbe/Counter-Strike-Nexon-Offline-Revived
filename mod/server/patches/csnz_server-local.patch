+static const int FirstSunday = 3; // the day number (CMissionManager::Today) of 1970-01-04, a Sunday
+
+static LoginReward ReadReward(const json& j)
+{
+	LoginReward r;
+	r.itemID = j.value("Item", 0);
+	r.count = max(1, j.value("Count", 1));
+	r.days = max(0, j.value("Days", 0));
+	r.name = j.value("Name", "");
+	r.medals = max(0, j.value("Medals", 0));
+	r.badges = max(0, j.value("BlackBadges", 0));
+	r.riftTickets = max(0, j.value("RiftTickets", 0));
+	r.bingoTickets = max(0, j.value("BingoTickets", 0));
+	r.after = j.value("After", 0);
+	r.bit = j.value("Bit", 0);
+	return r;
+}
+
+static json LoadJson(const char* path)
+{
+	ifstream f(path);
+	json cfg = json::parse(f, nullptr, false, true);
+	return cfg.is_discarded() || !cfg.is_object() ? json() : cfg;
+}
+
+void CMissionManager::LoadLoginSupplies()
+{
+	m_LoginDays.clear();
+	m_LoginBonuses.clear();
+	m_TutorialRewards.clear();
+	m_LoginEnabled = false;
+
+	json cfg = LoadJson("Data/DailyLogin.json");
+	if (cfg.is_null())
+		Logger().Warn("MissionManager: couldn't load Data/DailyLogin.json, no Login Supplies\n");
+	else
+	{
+		try
+		{
+			m_LoginEnabled = cfg.value("Enabled", true);
+			for (auto& d : cfg.value("Days", json::array()))
+				m_LoginDays.push_back(ReadReward(d));
+			for (auto& b : cfg.value("Bonuses", json::array()))
+			{
+				LoginReward r = ReadReward(b);
+				if (r.after > 0)
+					m_LoginBonuses.push_back(r);
+			}
+		}
+		catch (exception& e)
+		{
+			Logger().Error("MissionManager: Data/DailyLogin.json: %s\n", e.what());
+		}
+	}
+	// the window shows 10 weeks at most and keeps the days in a 64-bit mask; 5 bonus boxes
+	if (m_LoginDays.size() > 63)
+		m_LoginDays.resize(63);
+	sort(m_LoginBonuses.begin(), m_LoginBonuses.end(), [](const LoginReward& a, const LoginReward& b) { return a.after < b.after; });
+	if (m_LoginBonuses.size() > 5)
+		m_LoginBonuses.resize(5);
+	m_PeriodDays = (int)m_LoginDays.size();
+	if (m_LoginDays.empty())
+		m_LoginEnabled = false;
+	Logger().Info("MissionManager: Login Supplies of %d days, %d bonuses%s\n", m_PeriodDays, (int)m_LoginBonuses.size(), m_LoginEnabled ? "" : " (off)");
+
+	cfg = LoadJson("Data/Tutorial.json");
+	try
+	{
+		for (auto& r : cfg.is_null() ? json::array() : cfg.value("Rewards", json::array()))
+			m_TutorialRewards.push_back(ReadReward(r));
+	}
+	catch (exception& e)
+	{
+		Logger().Error("MissionManager: Data/Tutorial.json: %s\n", e.what());
+	}
+
+	m_GameTexts = LoadJson("Data/GameTexts.json");
+	if (m_GameTexts.is_null())
+		m_GameTexts = json::object();
+	m_GameTexts.erase("//");
+}
