+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "interface/izsriftmanager.h"
+#include "manager.h"
+#include "nlohmann/json.hpp"
+
+// Data/ZSRift.json
+struct ZSRiftRules
+{
+	int dailyExpMax = 1500;
+	int maxLevel = 20;
+	// cost of a trait's next level, as the client computes it: round(costBase * (costRate / 1000) ^ level / 10) * 10
+	// with level the one bought (1 for the first): 952 / 1050 make the first one 1000, then about 5% more each
+	int costBase = 952, costRate = 1050;
+	int matchExp = 100, killExp = 10, winExp = 100; // per finished match, before the daily maximum
+	int maxDifficulty = 20; // highest rift level (room difficulty list 1..this)
+	bool unlockByClearing = true; // level 1 open, the next one opens when the highest unlocked one is cleared
+	// Rift Tickets for clearing the rift (every round, boss included): clearTickets, plus ticketsPerLevel for every
+	// levelsPerTicket levels above 1 (3, 3, 4, 4, ... 12 at level 20)
+	int clearTickets = 3, ticketsPerLevel = 1, levelsPerTicket = 2;
+	// the Rift Exchange: exchangeStock cosmetics a day for each player; holding one keeps it for one more day for
+	// holdCostPercent of its price (at least holdMinCost), up to maxHoldDays after the first hold, maxHolds at once
+	int exchangeStock = 9, holdCostPercent = 0, holdMinCost = 2, maxHoldDays = 7, maxHolds = 3;
+};
+
+// Data/ZSRift.json "ScenarioTickets": Rift Tickets for finishing a match of another mode (Zombie Scenario, Human
+// Scenario, Zombie Files): `clear` when the match is won (the scenario cleared), `play` when it isn't
+struct ScenarioTicketRule
+{
+	int mode;
+	std::string name;
+	int clear, play;
+};
+
+// Data/RiftExchange.json (tools/gen_rift_exchange.py): the cosmetics the Rift Exchange sells
+struct RiftExchangeItem
+{
+	int itemID;
+	std::string name, kind;
+	int price;
+};
+
+class CZSRiftManager : public CBaseManager<IZSRiftManager>
+{
+public:
+	// offline build: one player's state, carried with their profile to another PC's server and back (guestprofile.cpp)
+	nlohmann::json ExportUser(int userID) { auto it = m_State.find(std::to_string(userID)); return it == m_State.end() ? nlohmann::json() : *it; }
+	void ImportUser(int userID, const nlohmann::json& state) { if (state.is_object()) m_State[std::to_string(userID)] = state; else m_State.erase(std::to_string(userID)); Save(); }
+	CZSRiftManager();
+
+	virtual bool Init();
+
+	virtual void OnPacket(CReceivePacket* msg, IExtendedSocket* socket);
+	virtual void OnUserLogin(IUser* user);
+	virtual void OnMatchResult(IUser* user, int gameMode, int kills, bool won);
+	virtual std::vector<int> Levels(IUser* user);
+	virtual int MaxDifficulty();
+	virtual int UnlockedDifficulty(IUser* user);
+
+	// web API (CWarbondManager routes it): POST /api/zsrift/clear from botassist.asi when the last round is cleared;
+	// GET / POST /api/riftexchange {action: buy|hold (itemID)}
+	nlohmann::json OnRiftClear(IUser* user, const std::string& body, int& status);
+	nlohmann::json ExchangeApi(IUser* user, const std::string& method, const std::string& body, int& status);
+
+private:
+	bool LoadConfig();
+	nlohmann::json& State(IUser* user); // the player's traits (created on first use, today's EXP reset each day)
+	void Save();
+	int Today();
+	int Cost(int level); // EXP for the level after `level`
+
+	void SendRules(IUser* user);
+	void SendTraits(IUser* user);
+	void OnUpgrade(IUser* user, int stat);
+	void OnReset(IUser* user);
+
+	static int DayNumber(); // days since 1970 of the local date (the stock changes at midnight)
+	long long Tickets(IUser* user);
+	int HoldCost(const RiftExchangeItem& item);
+	const RiftExchangeItem* FindItem(int itemID);
+	nlohmann::json& Exchange(IUser* user); // the player's stock of the day and holds (made at the first look each day)
+	nlohmann::json BuildExchange(IUser* user);
+	int ClearTickets(int level); // Rift Tickets for clearing the rift at that level (before the sv_cheats cut)
+	void PayScenarioTickets(IUser* user, int gameMode, bool won);
+
+	ZSRiftRules m_Rules;
+	std::vector<ScenarioTicketRule> m_Scenarios;
+	std::vector<RiftExchangeItem> m_Exchange;
+	nlohmann::json m_State;
+};
+
+extern CZSRiftManager g_ZSRiftManager;
