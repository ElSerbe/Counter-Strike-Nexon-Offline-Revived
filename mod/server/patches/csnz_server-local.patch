+/**
+ * Lists every account with its character (offline build: in-game "Elige personaje" survey)
+ * @param accounts Output, ordered by userID so survey answer IDs stay stable between ask and answer
+ * @return 1 on success, 0 on database error
+ */
+int CUserDatabaseSQLite::GetLocalAccounts(vector<LocalAccount_s>& accounts)
+{
+	try
+	{
+		SQLite::Statement query(m_Database, "SELECT User.userName, User.password, IFNULL(UserCharacter.gameName, ''), IFNULL(UserCharacter.level, 0) "
+			"FROM User LEFT JOIN UserCharacter ON UserCharacter.userID = User.userID ORDER BY User.userID");
+		while (query.executeStep())
+		{
+			LocalAccount_s account;
+			account.userName = query.getColumn(0).getString();
+			account.password = query.getColumn(1).getString();
+			account.gameName = query.getColumn(2).getString();
+			account.level = query.getColumn(3);
+			accounts.push_back(account);
+		}
+	}
+	catch (exception& e)
+	{
+		Logger().Error(OBFUSCATE("CUserDatabaseSQLite::GetLocalAccounts: database internal error: %s, %d\n"), e.what(), m_Database.getErrorCode());
+		return 0;
+	}
+
+	return 1;
+}
