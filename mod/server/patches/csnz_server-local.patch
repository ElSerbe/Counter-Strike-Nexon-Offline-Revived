+
+struct WarbondItem
+{
+	int itemID;
+	int cost;
+	std::string name; // optional display name (Item.csv only has internal names)
+	bool repeatable;  // supplies: bought any number of times, never "owned"
+	int days;         // supplies with a duration: days per unit bought (0: the item itself, one per unit)
+};
+
+struct WarbondPage
+{
+	int unlockSpent; // medals that must have been spent in this warbond before the page opens
+	std::string title; // optional, shown instead of "Page N"
+	std::vector<WarbondItem> items;
+};
+
+struct Warbond
+{
+	int id;
+	std::string name;
+	std::string type; // "Season", "Event", ...
+	std::string description;
+	std::string image;
+	int cost; // medals to unlock the pass itself (0 = free)
+	std::vector<std::string> theme; // optional [dark, light] colours of the pass page
+	std::vector<WarbondPage> pages;
+};
+
+struct WarbondOrder
+{
+	int id;
+	std::string period; // "Daily", "Weekly" or "Challenge" (permanent, completed once)
+	std::string group;  // challenge book section
+	std::string text;
+	std::string type;   // see CWarbondManager::AdvanceOrders
+	std::vector<int> gameModes; // empty: any mode
+	int target;
+	int reward;
+	int tickets; // Bingo Tickets given on completion (besides the medals)
+};
+
+struct MedalRules
+{
+	int perMatch = 2;
+	int perWin = 2;
+	int killsPerMedal = 6;
+	int maxKillMedals = 0; // 0: no limit
+	int levelUpPerLevel = 3; // medals for reaching level N: N x this
+	int headshotKillType = -1; // victimKillType value meaning a headshot (-1: unknown yet, see the telemetry log)
+	bool logKills = true; // telemetry: log every kill event and each player's match summary
+	int cheatPenalty = 60; // % of a match's medals (match, orders, level-ups) lost when sv_cheats was on in it
+};
+
+class CWarbondManager : public CBaseManager<IWarbondManager>
+{
+public:
+	CWarbondManager();
+
+	virtual bool Init();
+	virtual void Shutdown();
+
+	virtual int OnMatchResult(IUser* user, int gameMode, int kills, int headshots, bool won, bool topPlayer);
+	virtual int CountHeadshots(const std::map<int, int>& killTypes);
+	bool LogKills() const { return m_Medals.logKills; }
+	virtual void OnLevelUp(IUser* user, int oldLevel, int newLevel);
+	// sv_cheats was on in the match whose result is being applied to this player: its medals are cut
+	void SetCheatPenalty(IUser* user, bool on);
+	int CheatPenalty() const { return m_Medals.cheatPenalty; }
+	// non-repeatable items of the battle passes with their medal cost (bingo prizes)
+	std::vector<std::pair<int, int>> PassItems() const;
+	std::set<int> OwnedItems(IUser* user);
+	// battle passes whose every item (supplies aside) the player owns or has unlocked
+	int CompletedPasses(IUser* user);
+
+private:
+	bool LoadConfig();
+	WebResponse OnApiRequest(const WebRequest& req);
+	WebResponse HandleApiRequest(const WebRequest& req);
+	IUser* FindWebUser(const std::string& ip);
+	static int RebuyCost(int cost);
+	nlohmann::json BuildState(IUser* user);
+	nlohmann::json Unlock(IUser* user, int warbondID, int itemID, int quantity, int& status);
+	nlohmann::json UnlockPass(IUser* user, int warbondID, int& status);
+	nlohmann::json RoomBotsApi(IUser* user, const WebRequest& req, int& status);
+	nlohmann::json BotPresetsApi(IUser* user, const WebRequest& req, int& status);
+	nlohmann::json& BotPresets(int userID);
+	void SaveBotPresets();
+	nlohmann::json m_BotPresets;      // userID -> [{id, name, primary: [...], secondary: [...], melee: [...]}]
+	bool m_BotPresetsLoaded = false;
+	int CurrentPeriodStart(const std::string& period);
+	void AdvanceOrders(IUser* user, int gameMode, const std::map<std::string, int>& events);
+	int CountItemUnlocks(IUser* user);
+	int PenalizedMedals(IUser* user, int medals) const;
+	std::set<int> m_CheatUsers; // users whose match result is applied with the cheat penalty
+
+	std::vector<Warbond> m_Warbonds;
+	std::vector<WarbondOrder> m_Orders;
+	std::map<int, std::string> m_ItemNames; // official English names exported from the game files (Data/ItemNames.json)
+	std::map<int, std::string> m_OpenView;  // page the game's browser window shows next ("bots": the room's AI players)
+	MedalRules m_Medals;
+	std::string m_WebIP;
+	int m_WebPort;
+	std::string m_WebRoot;
+	CWebServer m_WebServer;
+};
