+#pragma once
+
+// offline build: online play through Steam (the Steam bridge, mod/tools/steambridge).
+// - Each server publishes its rooms (GET /api/rooms: their room list entries) and the bridge puts them in a Steam lobby.
+// - The bridge lists the other players' lobbies and writes Data/RemoteRooms.json: their rooms, each with a virtual room
+//   id (40000+) and the local port of the bridge's tunnel to that player's server. They're added to the room list.
+// - Entering one sends the client a Packet_Transfer to that port; on the other server, TransferLogin with an "r1" ticket
+//   logs the player in with an account of its own ("steam_<SteamID>") and puts them in the room.
+// - Data/SteamIdentity.json (written by the bridge): this PC's Steam ID and name. Without the bridge, nothing changes.
+
+#include <string>
+#include <vector>
+
+class IRoom;
+class IUser;
+class CSendPacket;
+struct UserNetworkConfig_s;
+
+struct RemoteRoom_s
+{
+	int vid;                          // the room id in this server's list (40000-65000)
+	int rid;                          // the room id on its own server
+	int port;                         // 127.0.0.1:port = the bridge's tunnel to that server
+	std::string host;                 // the host's Steam name
+	std::string hostID;               // the host's Steam ID (bridges from 1.1.8 on)
+	std::vector<unsigned char> entry; // the room list entry, as that server writes it
+};
+
+namespace ServerTransfer
+{
+	const int REMOTE_ROOM_FIRST_ID = 40000;
+
+	std::vector<RemoteRoom_s> LoadRemoteRooms();
+	bool FindRemoteRoom(int vid, RemoteRoom_s& room);
+	// writes the first count remote rooms' entries, with their ids replaced by the virtual ones
+	void WriteRemoteRooms(CSendPacket* msg, const std::vector<RemoteRoom_s>& rooms, int count);
+	// the local rooms for the bridge: [{ "id", "entry" (hex), "players", "max", "status" }]
+	std::string LocalRoomsJson(const std::vector<IRoom*>& rooms);
+	bool LoadSteamIdentity(std::string& steamID, std::string& name);
+
+	// players from other PCs on this server: their Steam ID, a slot (their match ports on this PC's bridge:
+	// 127.0.0.1:33000+slot*2+portID) and the bridge port they came through on their PC (30003+k: this PC's
+	// player is at 127.0.0.1:31000+k*2+portID over there). portID 0 = the game's server port, 1 = its client port.
+	void RegisterRemote(int userID, const std::string& steamID, int tunnelPort);
+	void UnregisterRemote(int userID);
+	// the match addresses of subject as viewer's game must use them
+	UserNetworkConfig_s NetworkFor(IUser* subject, IUser* viewer);
+	// UDP holepunch from this PC's game (any account): its two ports, for the bridge
+	void SetLocalGamePort(int portID, int port);
+	// for the bridge: { "myPorts": [server, client], "remotes": [{ "steamID", "slot" }] }
+	std::string UdpJson();
+
+	// a one-use ticket for a TransferLogin to this server
+	std::string IssueTicket(const std::string& userName, int seconds = 120);
+	bool TakeTicket(const std::string& ticket, std::string& userName);
+}
