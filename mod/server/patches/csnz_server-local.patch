+// GET: the presets; POST {action: save, preset: {id?, name, primary, secondary, melee}} | {action: delete, id}
+json CWarbondManager::BotPresetsApi(IUser* user, const WebRequest& req, int& status)
+{
+	json& presets = BotPresets(user->GetID());
+	if (req.method == "POST")
+	{
+		json body = json::parse(req.body, nullptr, false);
+		if (body.is_discarded())
+		{
+			status = 400;
+			return { { "error", "Invalid request." } };
+		}
+		string action = body.value("action", "");
+		if (action == "save")
+		{
+			json in = body.value("preset", json::object());
+			auto ids = [&](const char* key) {
+				json out = json::array();
+				for (auto& v : in.value(key, json::array()))
+					if (v.is_number_integer() && out.size() < 2000)
+						out.push_back(v.get<int>());
+				return out;
+			};
+			string name = in.value("name", "Preset");
+			if (name.size() > 40)
+				name.resize(40);
+			int id = in.value("id", 0);
+			int maxID = 0;
+			for (auto& p : presets)
+				maxID = max(maxID, p.value("id", 0));
+			json* target = NULL;
+			for (auto& p : presets)
+				if (id && p.value("id", 0) == id)
+					target = &p;
+			if (!target)
+			{
+				presets.push_back({ { "id", maxID + 1 } });
+				target = &presets.back();
+			}
+			(*target)["name"] = name;
+			(*target)["primary"] = ids("primary");
+			(*target)["secondary"] = ids("secondary");
+			(*target)["melee"] = ids("melee");
+			(*target)["character"] = ids("character");
+			SaveBotPresets();
+			json out = { { "presets", presets }, { "saved", (*target)["id"] } };
+			return out;
+		}
+		else if (action == "delete")
+		{
+			int id = body.value("id", 0);
+			for (size_t i = 0; i < presets.size(); i++)
+				if (presets[i].value("id", 0) == id)
+				{
+					presets.erase(presets.begin() + i);
+					break;
+				}
+			SaveBotPresets();
+		}
+		else
+		{
+			status = 400;
+			return { { "error", "Unknown action." } };
+		}
+	}
+	return { { "presets", presets } };
+}
