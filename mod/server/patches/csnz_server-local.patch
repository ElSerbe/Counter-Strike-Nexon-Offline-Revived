+string ServerTransfer::LocalRoomsJson(const vector<IRoom*>& rooms)
+{
+	json list = json::array();
+	for (auto room : rooms)
+	{
+		if (!room || !room->GetHostUser())
+			continue;
+		CSendPacket entry(0, 0);
+		BuildRoomInfo(&entry, room, RLFLAG_ALL, RLHFLAG_ALL);
+		list.push_back({ { "id", room->GetID() }, { "entry", ToHex(entry.m_OutStream.getBuffer()) },
+			{ "players", (int)room->GetUsers().size() }, { "status", (int)room->GetStatus() } });
+	}
+	return json({ { "rooms", list } }).dump();
+}
