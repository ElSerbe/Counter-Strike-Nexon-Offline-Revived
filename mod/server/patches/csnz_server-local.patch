+/**
+ * Data/Warbonds.json: web server settings, medal rules, orders and the battle passes with their pages.
+ */
+bool CWarbondManager::LoadConfig()
+{
+	ifstream f("Data/Warbonds.json");
+	json cfg = json::parse(f, nullptr, false, true);
+	if (cfg.is_discarded())
+	{
+		Logger().Error("CWarbondManager::LoadConfig: couldn't load Data/Warbonds.json\n");
+		return false;
+	}
+
+	try
+	{
+		json web = cfg.value("Web", json::object());
+		m_WebIP = web.value("IP", "127.0.0.1");
+		m_WebPort = web.value("Port", 30080);
+		m_WebRoot = web.value("Root", "../../../web");
+
+		json medals = cfg.value("Medals", json::object());
+		m_Medals.perMatch = medals.value("PerMatch", 2);
+		m_Medals.perWin = medals.value("PerWin", 2);
+		m_Medals.killsPerMedal = max(1, medals.value("KillsPerMedal", 6));
+		m_Medals.maxKillMedals = medals.value("MaxKillMedals", 0);
+		m_Medals.levelUpPerLevel = medals.value("LevelUpPerLevel", 3);
+		m_Medals.cheatPenalty = min(100, max(0, medals.value("CheatPenalty", 60)));
+		json telemetry = cfg.value("Telemetry", json::object());
+		m_Medals.headshotKillType = telemetry.value("HeadshotKillType", -1);
+		m_Medals.logKills = telemetry.value("LogKills", true);
+
+		m_Orders.clear();
+		for (auto& o : cfg.value("Orders", json::array()))
+		{
+			WarbondOrder order;
+			order.id = o.value("ID", 0);
+			order.period = o.value("Period", "Daily");
+			order.group = o.value("Group", "");
+			order.text = o.value("Text", "");
+			order.type = o.value("Type", "Matches");
+			order.gameModes = o.value("GameModes", vector<int>());
+			order.target = max(1, o.value("Target", 1));
+			order.reward = o.value("Reward", 0);
+			order.tickets = o.value("Tickets", 0);
+			m_Orders.push_back(order);
+		}
+
+		m_Warbonds.clear();
+		for (auto& w : cfg.value("Warbonds", json::array()))
+		{
+			Warbond warbond;
+			warbond.id = w.value("ID", 0);
+			warbond.name = w.value("Name", "");
+			warbond.type = w.value("Type", "");
+			warbond.description = w.value("Description", "");
+			warbond.image = w.value("Image", "");
+			warbond.cost = w.value("Cost", 0);
+			if (w.contains("Theme") && w["Theme"].is_array())
+				for (auto& colour : w["Theme"])
+					if (colour.is_string())
+						warbond.theme.push_back(colour.get<std::string>());
+			for (auto& p : w.value("Pages", json::array()))
+			{
+				WarbondPage page;
+				page.unlockSpent = p.value("Unlock", 0);
+				page.title = p.value("Title", "");
+				for (auto& i : p.value("Items", json::array()))
+					page.items.push_back({ i.value("ItemID", 0), i.value("Cost", 0), i.value("Name", ""),
+						i.value("Repeatable", false), i.value("Days", 0) });
+				warbond.pages.push_back(page);
+			}
+			m_Warbonds.push_back(warbond);
+		}
+	}
+	catch (exception& e)
+	{
+		Logger().Error("CWarbondManager::LoadConfig: Data/Warbonds.json: %s\n", e.what());
+		return false;
+	}
+
+	// optional: written by mod/tools/export_shop_assets.py
+	m_ItemNames.clear();
+	ifstream namesFile("Data/ItemNames.json");
+	json names = json::parse(namesFile, nullptr, false);
+	if (!names.is_discarded())
+		for (auto& entry : names.items())
+			if (entry.value().is_string())
+				m_ItemNames[atoi(entry.key().c_str())] = entry.value().get<string>();
+
+	Logger().Info("WarbondManager: %d battle passes, %d orders, %d item names\n", (int)m_Warbonds.size(), (int)m_Orders.size(), (int)m_ItemNames.size());
+	return true;
+}
