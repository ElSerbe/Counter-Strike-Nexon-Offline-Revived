+void CMedalManager::AddCounter(IUser* user, const char* name, long long value)
+{
+	if (user && value)
+		g_UserDatabase.AddCounters(user->GetID(), { { -1, name, value } }, false);
+}
+
+// battle pass statistics, from the unlocks (not counted as they happen)
+void CMedalManager::AddPassStats(IUser* user, vector<UserCounter_s>& counters)
+{
+	vector<WarbondUnlock_s> unlocks;
+	g_UserDatabase.GetWarbondUnlocks(user->GetID(), unlocks);
+	set<int> passes;
+	long long items = 0;
+	for (auto& u : unlocks)
+	{
+		passes.insert(u.warbondID);
+		items += u.itemID != 0;
+	}
+	counters.push_back({ -1, "Unlocks", items });
+	counters.push_back({ -1, "PassesUnlocked", (long long)passes.size() });
+	counters.push_back({ -1, "PassesCompleted", g_WarbondManager.CompletedPasses(user) });
+}
+
+// a statistic over some modes (all of them: mode -1); the best of one match is the best of those modes
+map<string, long long> CMedalManager::Totals(const vector<UserCounter_s>& counters, const vector<int>& modes) const
+{
+	map<string, long long> totals;
+	for (auto& c : counters)
+	{
+		if (modes.empty() ? c.mode != -1 : find(modes.begin(), modes.end(), c.mode) == modes.end())
+			continue;
+		long long& v = totals[c.name];
+		v = c.name == "BestKills" ? max(v, c.value) : v + c.value;
+	}
+	return totals;
+}
+
+long long CMedalManager::Progress(const MedalCondition& cond, const map<string, long long>& counters, IUser* user,
+	int level, long long points, int earned, const vector<int>& owned) const
+{
+	if (!cond.counter.empty())
+	{
+		auto it = counters.find(cond.counter);
+		return it == counters.end() ? 0 : it->second;
+	}
+	if (cond.level)
+		return level;
+	if (cond.points)
+		return points;
+	if (cond.medals)
+		return earned;
+	if (cond.ownAny)
+		return owned.size();
+	long long n = 0;
+	for (int id : cond.own)
+		n += binary_search(owned.begin(), owned.end(), id);
+	return n;
+}
+
+static long long Target(const MedalCondition& cond)
+{
+	return !cond.counter.empty() ? cond.target : cond.level ? cond.level : cond.points ? cond.points : cond.medals ? cond.medals : cond.count;
+}
+
+MedalContext CMedalManager::Context(IUser* user)
+{
+	MedalContext ctx;
+	CUserCharacter ch = user->GetCharacter(UFLAG_LOW_LEVEL | UFLAG_LOW_POINTS | UFLAG_LOW_ACHIEVEMENTLIST);
+	g_UserDatabase.GetCounters(user->GetID(), ctx.counters);
+	AddPassStats(user, ctx.counters);
+	set<int> ownedSet = g_WarbondManager.OwnedItems(user);
+	ctx.owned.assign(ownedSet.begin(), ownedSet.end());
+	ctx.earned.insert(ch.achievementList.begin(), ch.achievementList.end());
+	ctx.level = ch.level;
+	ctx.points = ch.points;
+	return ctx;
+}
+
+long long CMedalManager::Have(MedalContext& ctx, const MedalCondition& cond, IUser* user)
+{
+	auto it = ctx.totals.find(cond.modes);
+	if (it == ctx.totals.end())
+		it = ctx.totals.emplace(cond.modes, Totals(ctx.counters, cond.modes)).first;
+	return Progress(cond, it->second, user, ctx.level, ctx.points, (int)ctx.earned.size(), ctx.owned);
+}
+
+double CMedalManager::Fraction(MedalContext& ctx, const vector<MedalCondition>& conditions, IUser* user)
+{
+	double least = 1.0;
+	for (auto& cond : conditions)
+	{
+		long long need = Target(cond);
+		if (need > 0)
+			least = min(least, (double)min(Have(ctx, cond, user), need) / need);
+	}
+	return conditions.empty() ? 0.0 : least;
+}
+
+void CMedalManager::CheckMedals(IUser* user)
+{
+	if (!user || m_Medals.empty())
+		return;
+	MedalContext ctx = Context(user);
+
+	// a medal can complete another ("earn N medals"): until nothing changes
+	for (bool changed = true; changed;)
+	{
+		changed = false;
+		for (auto& m : m_Medals)
+		{
+			if (ctx.earned.count(m.id))
+				continue;
+			bool done = true;
+			for (auto& cond : m.conditions)
+				if (Have(ctx, cond, user) < Target(cond))
+				{
+					done = false;
+					break;
+				}
+			if (!done)
+				continue;
+			ctx.earned.insert(m.id);
+			changed = true;
+			user->UpdateAchievementList(m.id);
+			g_PacketManager.SendTitle(user->GetExtendedSocket(), m.id);
+			g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), va("Medal earned: %s", m.name.c_str()));
+			Logger().Info("MedalManager: user %d earned medal %d (%s)\n", user->GetID(), m.id, m.resource.c_str());
+		}
+	}
+
+	SendHonorQuests(user, ctx);
+	SendSteam(user, ctx);
+}
+
+// ---------------------------------------------------------------- the game's Medals tab and Steam
+
+// medal group (Data/Medals.json) -> tab of My Info's Medals tab (1 Scenario, 2 Fun, 3 Zombie, 4 Killer, 5 Family,
+// 6 Worker, 7 Writer); every medal is also in "View All"
+static int HonorCategory(const string& group)
+{
+	static const map<string, int> tabs = { { "Scenario", 1 }, { "Soccer", 2 }, { "Prop Hunt", 2 }, { "Zombie", 3 },
+		{ "Zombie Z", 3 }, { "Zombie Evolution", 3 }, { "Ranking", 4 }, { "Combat", 4 }, { "Original", 4 },
+		{ "Team Deathmatch", 4 }, { "Account", 6 }, { "Missions", 6 }, { "Collection", 6 }, { "Seasons", 6 },
+		{ "Studio", 7 } };
+	auto it = tabs.find(group);
+	return it == tabs.end() ? 0 : it->second;
+}
+
+void CMedalManager::SendHonorQuests(IUser* user, MedalContext& ctx)
+{
+	vector<HonorQuest_s> quests;
+	for (auto& m : m_Medals)
+	{
+		HonorQuest_s q;
+		q.titleID = m.id;
+		q.category = HonorCategory(m.group);
+		q.done = ctx.earned.count(m.id) > 0;
+		for (auto& cond : m.conditions)
+		{
+			long long need = max(1LL, Target(cond));
+			q.tasks.push_back({ need, q.done ? need : min(Have(ctx, cond, user), need) });
+		}
+		quests.push_back(q);
+	}
+	g_PacketManager.SendHonorQuests(user->GetExtendedSocket(), quests, (int)ctx.points);
+}
+
+bool CMedalManager::SetSteamClient(IExtendedSocket* socket, bool steam)
+{
+	if (!socket)
+		return false;
+	return steam ? m_SteamSockets.insert(socket->GetID()).second : m_SteamSockets.erase(socket->GetID()) > 0;
+}
+
+void CMedalManager::SendSteam(IUser* user, MedalContext& ctx)
+{
+	IExtendedSocket* socket = user->GetExtendedSocket();
+	if (!m_bSteamEnabled || m_Steam.empty() || !socket || !m_SteamSockets.count(socket->GetID()))
+		return;
+
+	bool first = m_SteamSent.find(user->GetID()) == m_SteamSent.end();
+	map<string, int>& last = m_SteamSent[user->GetID()];
+
+	vector<SteamStat_s> stats;
+	vector<string> unlocked;
+	double bestStep = 0;
+	int indicate = -1;
+	for (auto& a : m_Steam)
+	{
+		double fraction;
+		bool done;
+		if (a.medal)
+		{
+			done = ctx.earned.count(a.medal) > 0;
+			const Medal* medal = NULL;
+			for (auto& m : m_Medals)
+				if (m.id == a.medal)
+					medal = &m;
+			fraction = done ? 1.0 : medal ? Fraction(ctx, medal->conditions, user) : 0.0;
+		}
+		else
+		{
+			fraction = Fraction(ctx, a.conditions, user);
+			done = fraction >= 1.0;
+		}
+		if (done)
+			unlocked.push_back(a.name);
+		if (a.stat.empty() || a.max <= 0)
+			continue;
+
+		// the bar shows the real count when the goal is one counter up to the achievement's own max, else the share
+		// of the medal's goal (another counter or number than Steam's text)
+		int value;
+		if (done)
+			value = a.max;
+		else if (a.conditions.size() == 1 && Target(a.conditions[0]) == a.max)
+			value = (int)min<long long>(a.max - 1, Have(ctx, a.conditions[0], user));
+		else
+			value = min(a.max - 1, (int)(fraction * a.max + 1e-9));
+		auto prev = last.find(a.stat);
+		if (prev != last.end() && prev->second >= value)
+			continue; // Steam stats only go up
+		// the Steam overlay shows the progress of one achievement per update: the furthest one that passed a quarter
+		int before = prev == last.end() ? 0 : prev->second;
+		if (!first && !done && value * 4 / a.max > before * 4 / a.max && fraction > bestStep)
+		{
+			bestStep = fraction;
+			indicate = (int)stats.size();
+		}
+		stats.push_back({ a.stat, value, a.name, a.max, false });
+		last[a.stat] = value;
+	}
+	if (indicate >= 0)
+		stats[indicate].indicate = true;
+
+	g_PacketManager.SendSteamStats(socket, stats, unlocked);
+	if (first)
+		Logger().Info("MedalManager: Steam for user %d: %d stats, %d achievements unlocked\n", user->GetID(),
+			(int)stats.size(), (int)unlocked.size());
+}
+
+json CMedalManager::QuestTexts() const
+{
+	json texts = json::object();
+	for (auto& m : m_Medals)
+	{
+		string key = "CSO_Quest" + to_string(2000 + m.id);
+		texts[key + "_Desc1"] = m.text;
+		// one text per requirement (the game's "Cond" lines), from the medal's text "a; b; c"
+		vector<string> parts;
+		size_t start = 0;
+		for (;;)
+		{
+			size_t end = m.text.find("; ", start);
+			parts.push_back(m.text.substr(start, end == string::npos ? string::npos : end - start));
+			if (end == string::npos)
+				break;
+			start = end + 2;
+		}
+		if (parts.size() != m.conditions.size())
+			parts.assign(m.conditions.size(), m.text);
+		for (size_t i = 0; i < parts.size(); i++)
+			texts[key + "_Cond" + to_string(i + 1)] = parts[i];
+	}
+	return texts;
+}
+
+// ---------------------------------------------------------------- profile page
+
+json CMedalManager::BuildProfile(IUser* user)
+{
+	CUserCharacter ch = user->GetCharacter(UFLAG_LOW_ALL);
+	MedalContext ctx = Context(user);
+
+	json total = json::object();
+	json modes = json::object();
+	for (auto& c : ctx.counters)
+	{
+		if (c.name == "LastPlayDay")
+			continue;
+		if (c.mode == -1)
+			total[c.name] = c.value;
+		else
+			modes[to_string(c.mode)][c.name] = c.value;
+	}
+
+	json medals = json::array();
+	for (auto& m : m_Medals)
+	{
+		json progress = json::array();
+		for (auto& cond : m.conditions)
+			progress.push_back({ { "have", min(Have(ctx, cond, user), Target(cond)) }, { "need", Target(cond) } });
+		medals.push_back({ { "id", m.id }, { "name", m.name }, { "group", m.group }, { "text", m.text }, { "lore", m.lore },
+			{ "earned", ctx.earned.count(m.id) > 0 }, { "progress", progress } });
+	}
+
+	return { { "name", ch.gameName }, { "level", ch.level }, { "exp", ch.exp }, { "medals", ch.points },
+		{ "titles", ch.titles }, { "total", total }, { "modes", modes }, { "groups", m_Groups }, { "medalList", medals } };
+}
diff --git a/src/manager/medalmanager.h b/src/manager/medalmanager.h
new file mode 100644
index 0000000..1a0e4c5
--- /dev/null
+++ b/src/manager/medalmanager.h
@@ -0,0 +1,107 @@
+#pragma once
+
+#include <string>
+#include <vector>
+#include <map>
+#include <set>
+
+#include "interface/imedalmanager.h"
+#include "manager.h"
+#include "nlohmann/json.hpp"
+#include "definitions.h"
+
+class CGameMatch;
+class IExtendedSocket;
+class CGameMatchUserStat;
+struct GameMatch_KillEvent;
+
+// one requirement of a medal (Data/Medals.json "Conditions"): all of them must hold
+struct MedalCondition
+{
+	std::string counter;     // a statistic (see CMedalManager::OnKill / OnMatchEnd), with target and modes
+	long long target = 0;
+	std::vector<int> modes;  // empty: all modes
+	int level = 0;           // or the character's level
+	int points = 0;          // or medals (the shop currency) held
+	int medals = 0;          // or other medals earned
+	std::vector<int> own;    // or owning `count` of these items (empty list: any items)
+	int count = 0;
+	bool ownAny = false;
+};
+
+struct Medal
+{
+	int id;
+	std::string resource, name, group, lore, text;
+	std::vector<MedalCondition> conditions;
+};
+
+// a Steam achievement of the game (Data/SteamAchievements.json, tools/gen_steam_achievements.py): unlocked with a
+// medal, or by its own conditions; `stat` (if any) is its progress bar in Steam, 0..max
+struct SteamAchievement
+{
+	std::string name, stat, text;
+	int max = 0;
+	int medal = 0;
+	std::vector<MedalCondition> conditions;
+};
+
+// what a player has towards the medals: statistics (summed per mode list, cached), level, medals held and earned,
+// items owned
+struct MedalContext
+{
+	std::vector<UserCounter_s> counters;
+	std::map<std::vector<int>, std::map<std::string, long long>> totals;
+	int level = 0;
+	long long points = 0;
+	std::set<int> earned;
+	std::vector<int> owned;
+};
+
+class CMedalManager : public CBaseManager<IMedalManager>
+{
+public:
+	CMedalManager();
+
+	virtual bool Init();
+	virtual void CheckMedals(IUser* user);
+	virtual void AddCounter(IUser* user, const char* name, long long value);
+
+	// match events (CGameMatch): statistics of the match, saved when it ends (or when the player leaves)
+	void OnKill(CGameMatchUserStat* stat, CGameMatch* match, const GameMatch_KillEvent& killEvent);
+	void OnMatchEnd(CGameMatch* match);
+	void OnMatchLeave(CGameMatchUserStat* stat, CGameMatch* match);
+
+	// GET /api/profile
+	nlohmann::json BuildProfile(IUser* user);
+	// GET /api/questtexts (botassist): the medals' texts in the game's Medals tab, CSO_Quest<2000+id>_Desc1 / _Cond<n>
+	nlohmann::json QuestTexts() const;
+
+	// the client's Steam API is up (botassist: POST /api/steam; or a login packet with a Steam ticket): only then the
+	// Steam packet may be sent (the game has no ISteamUserStats otherwise and would crash on it). True if it changed.
+	bool SetSteamClient(IExtendedSocket* socket, bool steam);
+
+private:
+	bool LoadConfig();
+	void SaveMatchStats(CGameMatchUserStat* stat, CGameMatch* match, bool finished);
+	long long Progress(const MedalCondition& cond, const std::map<std::string, long long>& counters, IUser* user,
+		int level, long long points, int earned, const std::vector<int>& owned) const;
+	std::map<std::string, long long> Totals(const std::vector<UserCounter_s>& counters, const std::vector<int>& modes) const;
+	void AddPassStats(IUser* user, std::vector<UserCounter_s>& counters);
+	MedalContext Context(IUser* user);
+	long long Have(MedalContext& ctx, const MedalCondition& cond, IUser* user);
+	// 0..1: the least complete requirement of a list
+	double Fraction(MedalContext& ctx, const std::vector<MedalCondition>& conditions, IUser* user);
+	void SendHonorQuests(IUser* user, MedalContext& ctx);
+	void SendSteam(IUser* user, MedalContext& ctx);
+
+	std::vector<Medal> m_Medals;
+	std::vector<std::string> m_Groups;
+	std::vector<SteamAchievement> m_Steam;
+	bool m_bSteamEnabled = true;
+	std::set<unsigned int> m_SteamSockets;
+	std::map<int, std::map<std::string, int>> m_SteamSent; // user -> stat -> value last sent
+};
+
+extern CMedalManager g_MedalManager;
+bool IsZombieModeOffline(int mode);
diff --git a/src/manager/missionmanager.cpp b/src/manager/missionmanager.cpp
new file mode 100644
index 0000000..331bcd2
--- /dev/null
+++ b/src/manager/missionmanager.cpp
@@ -0,0 +1,459 @@
+#include "missionmanager.h"
+#include "medalmanager.h"
+#include "warbondmanager.h"
+#include "userdatabase.h"
+#include "itemmanager.h"
+#include "packetmanager.h"
+#include "serverinstance.h"
+#include "main.h"
+#include "common/utils.h"
+
+#include <fstream>
+#include <random>
+#include <set>
+#include <ctime>
+#include <algorithm>
+
+using namespace std;
+using json = nlohmann::json;
+
+CMissionManager g_MissionManager;
+
+CMissionManager::CMissionManager() : CBaseManager("MissionManager")
+{
+}
+
+bool CMissionManager::Init()
+{
+	return LoadConfig();
+}
+
+static vector<MissionRequirement> ReadConditions(const json& list)
+{
+	vector<MissionRequirement> reqs;
+	for (auto& c : list)
+	{
+		MissionRequirement r;
+		r.counter = c.value("Counter", "");
+		r.target = c.value("Target", 0LL);
+		r.modes = c.value("Modes", vector<int>());
+		if (!r.counter.empty() && r.target > 0)
+			reqs.push_back(r);
+	}
+	return reqs;
+}
+
+bool CMissionManager::LoadConfig()
+{
+	ifstream f("Data/Missions.json");
+	json cfg = json::parse(f, nullptr, false, true);
+	if (cfg.is_discarded() || !cfg.is_object())
+	{
+		Logger().Error("MissionManager: couldn't load Data/Missions.json, no missions\n");
+		return true;
+	}
+	try
+	{
+		m_RequestOffers = cfg.value("RequestOffers", 4);
+		m_RequestSlots = cfg.value("RequestSlots", 3);
+		for (auto& r : cfg.value("Requests", json::array()))
+		{
+			MissionRequest req;
+			req.id = r.value("ID", 0);
+			req.title = r.value("Title", "");
+			req.npc = r.value("Npc", "");
+			req.portrait = r.value("Portrait", "");
+			req.story = r.value("Story", "");
+			req.text = r.value("Text", "");
+			req.conditions = ReadConditions(r.value("Conditions", json::array()));
+			req.badges = r.value("Badges", 0);
+			req.medals = r.value("Medals", 0);
+			if (req.id && !req.conditions.empty())
+				m_Requests.push_back(req);
+		}
+		for (auto& e : cfg.value("Events", json::array()))
+		{
+			MissionEvent ev;
+			ev.id = e.value("ID", 0);
+			ev.name = e.value("Name", "");
+			ev.description = e.value("Description", "");
+			ev.bonusBadges = e.value("BonusBadges", 0);
+			ev.bonusMedals = e.value("BonusMedals", 0);
+			for (auto& m : e.value("Missions", json::array()))
+			{
+				EventMission mission;
+				mission.text = m.value("Text", "");
+				mission.conditions = ReadConditions(m.value("Conditions", json::array()));
+				mission.badges = m.value("Badges", 0);
+				mission.medals = m.value("Medals", 0);
+				if (!mission.conditions.empty())
+					ev.missions.push_back(mission);
+			}
+			if (ev.id && !ev.missions.empty())
+				m_Events.push_back(ev);
+		}
+		json market = cfg.value("BlackMarket", json::object());
+		m_MarketWeapons = market.value("Weapons", 6);
+		m_MarketCostumes = market.value("Costumes", 2);
+		for (auto& i : market.value("Items", json::array()))
+			m_Market.push_back({ i.value("ItemID", 0), i.value("Name", ""), i.value("Kind", "Weapon"), i.value("Price", 30) });
+	}
+	catch (exception& e)
+	{
+		Logger().Error("MissionManager: Data/Missions.json: %s\n", e.what());
+	}
+	Logger().Info("MissionManager: %d mission requests, %d events, %d Black Market items\n", (int)m_Requests.size(),
+		(int)m_Events.size(), (int)m_Market.size());
+	return true;
+}
+
+// local calendar day (requests and the Black Market change at midnight) and week (events change on Monday)
+int CMissionManager::Today()
+{
+	time_t now = time(NULL);
+	tm local = *localtime(&now);
+	tm midnight = local;
+	midnight.tm_hour = midnight.tm_min = midnight.tm_sec = 0;
+	return (int)((mktime(&midnight) + 43200) / 86400); // noon of that day: safe against DST
+}
+
+int CMissionManager::ThisWeek()
+{
+	return (Today() + 3) / 7; // 1970-01-01 was a Thursday: weeks start on Monday
+}
+
+static int SecondsToMidnight()
+{
+	time_t now = time(NULL);
+	tm local = *localtime(&now);
+	return 86400 - (local.tm_hour * 3600 + local.tm_min * 60 + local.tm_sec);
+}
+
+long long CMissionManager::Total(const vector<UserCounter_s>& counters, const MissionRequirement& req)
+{
+	long long total = 0;
+	for (auto& c : counters)
+		if (c.name == req.counter && (req.modes.empty() ? c.mode == -1 : find(req.modes.begin(), req.modes.end(), c.mode) != req.modes.end()))
+			total += c.value;
+	return total;
+}
+
+// the requests offered today (the same all day): a shuffle of the ones not taken and not done today
+vector<int> CMissionManager::Offers(int userID, int day, const map<string, UserMission_s>& missions)
+{
+	vector<int> ids;
+	for (auto& r : m_Requests)
+		ids.push_back(r.id);
+	mt19937 rng((unsigned)(day * 7919 + userID * 104729));
+	shuffle(ids.begin(), ids.end(), rng);
+	vector<int> offers;
+	for (int id : ids)
+	{
+		auto it = missions.find("R" + to_string(id));
+		if (it != missions.end() && (it->second.state == 1 || it->second.period == day))
+			continue; // active, or done today
+		offers.push_back(id);
+		if ((int)offers.size() >= m_RequestOffers)
+			break;
+	}
+	return offers;
+}
+
+vector<const MarketItem*> CMissionManager::Stock(int day)
+{
+	vector<const MarketItem*> weapons, costumes;
+	for (auto& m : m_Market)
+		(m.kind == "Costume" ? costumes : weapons).push_back(&m);
+	mt19937 rng((unsigned)(day * 2654435761u));
+	shuffle(weapons.begin(), weapons.end(), rng);
+	shuffle(costumes.begin(), costumes.end(), rng);
+	weapons.resize(min((int)weapons.size(), m_MarketWeapons));
+	costumes.resize(min((int)costumes.size(), m_MarketCostumes));
+	weapons.insert(weapons.end(), costumes.begin(), costumes.end());
+	return weapons;
+}
+
+const MissionEvent* CMissionManager::CurrentEvent()
+{
+	return m_Events.empty() ? NULL : &m_Events[ThisWeek() % m_Events.size()];
+}
+
+// rows "<prefix>.<i>" keep each requirement's starting value
+json CMissionManager::Progress(const vector<MissionRequirement>& reqs, const string& prefix, const vector<UserCounter_s>& counters,
+	const map<string, UserMission_s>& missions, bool& done)
+{
+	json progress = json::array();
+	done = true;
+	for (size_t i = 0; i < reqs.size(); i++)
+	{
+		auto it = missions.find(prefix + "." + to_string(i));
+		long long start = it != missions.end() ? it->second.value : Total(counters, reqs[i]);
+		long long have = max(0LL, Total(counters, reqs[i]) - start);
+		if (have < reqs[i].target)
+			done = false;
+		progress.push_back({ { "have", min(have, reqs[i].target) }, { "need", reqs[i].target } });
+	}
+	return progress;
+}
+
+vector<UserMission_s> CMissionManager::Start(const vector<MissionRequirement>& reqs, const string& prefix,
+	const vector<UserCounter_s>& counters, int period)
+{
+	vector<UserMission_s> rows = { { prefix, 0, 1, period } };
+	for (size_t i = 0; i < reqs.size(); i++)
+		rows.push_back({ prefix + "." + to_string(i), Total(counters, reqs[i]), 1, period });
+	return rows;
+}
+
+void CMissionManager::Reward(IUser* user, int badges, int medals, const char* what)
+{
+	if (badges)
+		g_MedalManager.AddCounter(user, "BlackBadges", badges);
+	if (medals)
+		user->UpdatePoints(medals);
+	string text = string(what) + " complete:";
+	if (badges)
+		text += va(" +%d Black Badges", badges);
+	if (medals)
+		text += va("%s +%d medals", badges ? "," : "", medals);
+	g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), text);
+}
+
+json CMissionManager::Build(IUser* user)
+{
+	int userID = user->GetID(), day = Today(), week = ThisWeek();
+	vector<UserCounter_s> counters;
+	g_UserDatabase.GetCounters(userID, counters);
+	vector<UserMission_s> rows;
+	g_UserDatabase.GetMissions(userID, rows);
+	map<string, UserMission_s> missions;
+	for (auto& r : rows)
+		missions[r.key] = r;
+
+	long long badges = 0;
+	for (auto& c : counters)
+		if (c.mode == -1 && c.name == "BlackBadges")
+			badges = c.value;
+	CUserCharacter ch = user->GetCharacter(UFLAG_LOW_POINTS);
+
+	// requests
+	json active = json::array(), offers = json::array();
+	auto requestJson = [&](const MissionRequest& r) {
+		return json{ { "id", r.id }, { "title", r.title }, { "npc", r.npc }, { "portrait", r.portrait }, { "story", r.story },
+			{ "text", r.text }, { "badges", r.badges }, { "medals", r.medals } };
+	};
+	for (auto& r : m_Requests)
+	{
+		auto it = missions.find("R" + to_string(r.id));
+		if (it == missions.end() || it->second.state != 1)
+			continue;
+		bool done;
+		json j = requestJson(r);
+		j["progress"] = Progress(r.conditions, "R" + to_string(r.id), counters, missions, done);
+		j["done"] = done;
+		active.push_back(j);
+	}
+	for (int id : Offers(userID, day, missions))
+		for (auto& r : m_Requests)
+			if (r.id == id)
+				offers.push_back(requestJson(r));
+
+	// the event of the week: its missions start counting the first time the page is opened this week
+	json event = nullptr;
+	if (const MissionEvent* ev = CurrentEvent())
+	{
+		vector<UserMission_s> fresh;
+		string base = "E" + to_string(ev->id) + "." + to_string(week);
+		for (size_t m = 0; m < ev->missions.size(); m++)
+		{
+			string prefix = base + "." + to_string(m);
+			if (!missions.count(prefix))
+			{
+				auto started = Start(ev->missions[m].conditions, prefix, counters, week);
+				for (auto& s : started)
+					missions[s.key] = s;
+				fresh.insert(fresh.end(), started.begin(), started.end());
+			}
+		}
+		if (!fresh.empty())
+		{
+			g_UserDatabase.DeleteMissions(userID, "E"); // older weeks
+			for (auto& s : missions)
+				if (s.first.compare(0, base.size(), base) == 0)
+					fresh.push_back(s.second);
+			g_UserDatabase.SetMissions(userID, fresh);
+		}
+		json list = json::array();
+		bool allClaimed = true;
+		for (size_t m = 0; m < ev->missions.size(); m++)
+		{
+			string prefix = base + "." + to_string(m);
+			bool done;
+			json progress = Progress(ev->missions[m].conditions, prefix, counters, missions, done);
+			bool claimed = missions[prefix].state == 2;
+			allClaimed &= claimed;
+			list.push_back({ { "text", ev->missions[m].text }, { "badges", ev->missions[m].badges }, { "medals", ev->missions[m].medals },
+				{ "progress", progress }, { "done", done || claimed }, { "claimed", claimed } });
+		}
+		int weekday = (Today() + 3) % 7; // 0 Monday .. 6 Sunday
+		int secondsLeft = SecondsToMidnight() + (6 - weekday) * 86400;
+		event = { { "id", ev->id }, { "name", ev->name }, { "description", ev->description }, { "missions", list },
+			{ "bonusBadges", ev->bonusBadges }, { "bonusMedals", ev->bonusMedals }, { "allClaimed", allClaimed },
+			{ "bonusClaimed", missions.count(base + ".B") > 0 }, { "endsIn", secondsLeft } };
+	}
+
+	// the Black Market of the day
+	set<int> owned = g_WarbondManager.OwnedItems(user);
+	json stock = json::array();
+	for (auto* item : Stock(day))
+		stock.push_back({ { "itemID", item->itemID }, { "name", item->name }, { "kind", item->kind }, { "price", item->price },
+			{ "owned", owned.count(item->itemID) > 0 } });
+
+	return { { "badges", badges }, { "medals", ch.points }, { "refreshIn", SecondsToMidnight() },
+		{ "requests", { { "slots", m_RequestSlots }, { "active", active }, { "offers", offers } } },
+		{ "event", event }, { "market", stock } };
+}
+
+json CMissionManager::Api(IUser* user, const string& method, const string& body, int& status)
+{
+	if (method != "POST")
+		return Build(user);
+	json in = json::parse(body, nullptr, false);
+	if (in.is_discarded())
+	{
+		status = 400;
+		return { { "error", "Invalid request." } };
+	}
+	auto fail = [&](int code, const char* message) {
+		status = code;
+		return json{ { "error", message } };
+	};
+	int userID = user->GetID(), day = Today(), week = ThisWeek();
+	vector<UserCounter_s> counters;
+	g_UserDatabase.GetCounters(userID, counters);
+	vector<UserMission_s> rows;
+	g_UserDatabase.GetMissions(userID, rows);
+	map<string, UserMission_s> missions;
+	for (auto& r : rows)
+		missions[r.key] = r;
+	string action = in.value("action", "");
+
+	if (action == "accept" || action == "abandon" || action == "claim")
+	{
+		int id = in.value("id", 0);
+		const MissionRequest* req = NULL;
+		for (auto& r : m_Requests)
+			if (r.id == id)
+				req = &r;
+		if (!req)
+			return fail(404, "No such mission request.");
+		string key = "R" + to_string(id);
+		auto it = missions.find(key);
+		bool isActive = it != missions.end() && it->second.state == 1;
+		if (action == "accept")
+		{
+			if (isActive)
+				return fail(409, "You already took this request.");
+			vector<int> offers = Offers(userID, day, missions);
+			if (find(offers.begin(), offers.end(), id) == offers.end())
+				return fail(409, "This request isn't offered today.");
+			int count = 0;
+			for (auto& m : missions)
+				count += m.first[0] == 'R' && m.first.find('.') == string::npos && m.second.state == 1;
+			if (count >= m_RequestSlots)
+				return fail(409, "Finish or drop a request first: all your request slots are taken.");
+			g_UserDatabase.DeleteMissions(userID, key + ".");
+			g_UserDatabase.SetMissions(userID, Start(req->conditions, key, counters, day));
+		}
+		else if (action == "abandon")
+		{
+			if (!isActive)
+				return fail(409, "You don't have this request.");
+			g_UserDatabase.DeleteMissions(userID, key);
+		}
+		else
+		{
+			if (!isActive)
+				return fail(409, "You don't have this request.");
+			bool done;
+			Progress(req->conditions, key, counters, missions, done);
+			if (!done)
+				return fail(409, "This request isn't done yet.");
+			g_UserDatabase.DeleteMissions(userID, key + ".");
+			g_UserDatabase.SetMissions(userID, { { key, 0, 2, day } });
+			Reward(user, req->badges, req->medals, ("Request \"" + req->title + "\"").c_str());
+			g_MedalManager.AddCounter(user, "RequestsDone", 1);
+			g_MedalManager.CheckMedals(user);
+		}
+	}
+	else if (action == "claimEvent" || action == "claimBonus")
+	{
+		const MissionEvent* ev = CurrentEvent();
+		if (!ev)
+			return fail(404, "There's no event this week.");
+		string base = "E" + to_string(ev->id) + "." + to_string(week);
+		if (action == "claimEvent")
+		{
+			int index = in.value("index", -1);
+			if (index < 0 || index >= (int)ev->missions.size())
+				return fail(404, "No such event mission.");
+			string prefix = base + "." + to_string(index);
+			auto it = missions.find(prefix);
+			if (it == missions.end())
+				return fail(409, "Open the event first.");
+			if (it->second.state == 2)
+				return fail(409, "Already claimed.");
+			bool done;
+			Progress(ev->missions[index].conditions, prefix, counters, missions, done);
+			if (!done)
+				return fail(409, "This event mission isn't done yet.");
+			g_UserDatabase.SetMissions(userID, { { prefix, 0, 2, week } });
+			Reward(user, ev->missions[index].badges, ev->missions[index].medals, ("Event mission of " + ev->name).c_str());
+			g_MedalManager.AddCounter(user, "EventsDone", 1);
+			g_MedalManager.CheckMedals(user);
+		}
+		else
+		{
+			if (missions.count(base + ".B"))
+				return fail(409, "Already claimed.");
+			for (size_t m = 0; m < ev->missions.size(); m++)
+			{
+				auto it = missions.find(base + "." + to_string(m));
+				if (it == missions.end() || it->second.state != 2)
+					return fail(409, "Claim every mission of the event first.");
+			}
+			g_UserDatabase.SetMissions(userID, { { base + ".B", 0, 2, week } });
+			Reward(user, ev->bonusBadges, ev->bonusMedals, ev->name.c_str());
+		}
+	}
+	else if (action == "buy")
+	{
+		int itemID = in.value("itemID", 0);
+		const MarketItem* item = NULL;
+		for (auto* m : Stock(day))
+			if (m->itemID == itemID)
+				item = m;
+		if (!item)
+			return fail(404, "That item isn't on sale today.");
+		if (g_WarbondManager.OwnedItems(user).count(itemID))
+			return fail(409, "You already own this item.");
+		long long badges = 0;
+		for (auto& c : counters)
+			if (c.mode == -1 && c.name == "BlackBadges")
+				badges = c.value;
+		if (badges < item->price)
+			return fail(409, "Not enough Black Badges.");
+		int added = g_ItemManager.AddItem(userID, user, itemID, 1, 0);
+		if (added == ITEM_ADD_INVENTORY_FULL)
+			return fail(409, "Your inventory is full.");
+		if (added != ITEM_ADD_SUCCESS)
+			return fail(500, "Couldn't add the item.");
+		g_MedalManager.AddCounter(user, "BlackBadges", -item->price);
+		g_MedalManager.AddCounter(user, "BlackMarketBuys", 1);
+		g_MedalManager.CheckMedals(user);
+		Logger().Info("MissionManager: user %d bought item %d at the Black Market for %d badges\n", userID, itemID, item->price);
+	}
+	else
+		return fail(400, "Unknown action.");
+	return Build(user);
+}
