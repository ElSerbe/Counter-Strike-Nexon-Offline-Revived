+
+// a prize of the board (a line or the grand prize). Medals have no item: they show as IconItemID with the amount
+// as count and are added to the player's medals instead.
+struct BingoPrize
+{
+	int itemID = 0;
+	int count = 1;
+	int days = 0; // 0: permanent
+	int medals = 0;
+	bool opened = false;
+};
+
+// Data/Bingo.json "LinePrizes" / "GrandPrizes" entries
+struct BingoPrizeRule
+{
+	std::string type; // "PassItem" (weapon/character of a medal pass the player doesn't own), "Item", "Medals"
+	int weight = 1;
+	std::vector<std::string> kinds; // PassItem: "weapon", "character"
+	double minCostShare = 0, maxCostShare = 1; // PassItem: slice of the pass items sorted by medal cost (0 cheapest)
+	std::vector<int> itemIDs;       // Item: one of these
+	int count = 1, days = 0;
+	int minMedals = 0, maxMedals = 0; // Medals
+	int iconItemID = 0;
+};
+
+struct BingoRules
+{
+	int ticketItemID = 2179;
+	int shuffleItemID = 996;
+	int costRandom = 1, costEvenOdd = 2, costSpecialBase = 3, costSpecialPerLine = 1;
+	int costChangeGrandPrize = 1, costReset = 1;
+	bool grandPrizeOncePerDay = true;
+	int shuffleMaxOpened = 10;     // shuffle only with at most this many numbers opened...
+	bool shuffleBeforeFirstLine = true; // ...and no line completed
+	int levelEvery = 5, levelTickets = 1;   // a ticket every N levels
+	double dropChance = 0.08, dropPerKill = 0.004, dropPerWin = 0.04, dropMaxChance = 0.3; // per finished match
+	int dropMinKills = 0;
+	std::vector<BingoPrizeRule> linePrizes, grandPrizes;
+};
+
+class CBingoManager : public CBaseManager<IBingoManager>
+{
+public:
+	// offline build: one player's state, carried with their profile to another PC's server and back (guestprofile.cpp)
+	nlohmann::json ExportUser(int userID) { auto it = m_State.find(std::to_string(userID)); return it == m_State.end() ? nlohmann::json() : *it; }
+	void ImportUser(int userID, const nlohmann::json& state) { if (state.is_object()) m_State[std::to_string(userID)] = state; else m_State.erase(std::to_string(userID)); Save(); }
+	CBingoManager();
+
+	virtual bool Init();
+
+	virtual void OnPacket(CReceivePacket* msg, IExtendedSocket* socket);
+	virtual void OnLevelUp(IUser* user, int oldLevel, int newLevel);
+	virtual void OnMatchResult(IUser* user, int kills, bool won);
+	virtual void GiveTickets(IUser* user, int count, const char* reason);
+	virtual bool UseShuffleItem(IUser* user, CUserInventoryItem& item);
+
+private:
+	bool LoadConfig();
+	nlohmann::json& State(IUser* user); // the player's board (created on first use)
+	void Save();
+	void NewBoard(IUser* user, nlohmann::json& st, bool newGrandPrize);
+	bool PickPrize(IUser* user, const std::vector<BingoPrizeRule>& rules, const std::vector<int>& exclude, BingoPrize& out);
+	int Tickets(IUser* user);
+	bool SpendTickets(IUser* user, int count);
+	int CompletedLines(const nlohmann::json& st);
+	int SpecialCost(const nlohmann::json& st);
+	bool BoardComplete(const nlohmann::json& st);
+	void GivePrize(IUser* user, const BingoPrize& prize, std::vector<BingoPrize>& given);
+	void NoticePrizes(IUser* user, const std::vector<BingoPrize>& given, const char* title, const char* text);
+	int Today();
+
+	void OnOpenNumber(IUser* user, int mode);
+	void OnResetBoard(IUser* user);
+	void OnChangeGrandPrize(IUser* user);
+	void OnCollectGrandPrize(IUser* user);
+
+	void SendState(IUser* user);
+	void SendDrawnNumber(IUser* user, int number);
+	void SendTickets(IUser* user);
+	void SendHistory(IUser* user);
+	void SendError(IUser* user, int code);
+
+	BingoRules m_Rules;
+	nlohmann::json m_State; // userID -> board, Data/BingoState.json
+};
+
+extern CBingoManager g_BingoManager;
