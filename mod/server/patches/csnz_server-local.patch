+// ---------------------------------------------------------------------------------------------------------------
+// /studio/net/...: the Steam bridge (this PC only: the web server listens on 127.0.0.1)
+WebResponse CVoxelManager::OnNetHttp(const WebRequest& req)
+{
+	WebResponse resp;
+	json result;
+	const string& p = req.path;
+	if (p == "/studio/net/catalog")
+	{
+		// this PC's published maps, for its lobby, and the codes of the maps it fetched (it can pass them on)
+		lock_guard<recursive_mutex> lock(m_StudioMutex);
+		ordered_json maps = ordered_json::array(), have = ordered_json::array();
+		vector<const ordered_json*> mine;
+		for (auto& s : m_Studio["slots"])
+		{
+			if (s.value("deleted", false) || s.value("resource_id", "").empty())
+				continue;
+			if (s.value("remote", false))
+			{
+				if (have.size() < 300)
+					have.push_back(ShareCode(s.value("id", "")));
+			}
+			else if (s.value("owner", 0) > 0 && s.value("published", false))
+				mine.push_back(&s);
+		}
+		sort(mine.begin(), mine.end(), [](const ordered_json* a, const ordered_json* b) {
+			return a->value("updated", 0LL) > b->value("updated", 0LL);
+		});
+		for (auto* s : mine)
+			if ((int)maps.size() < MAX_PUBLISHED)
+				maps.push_back(MapEntry(*s, true));
+		ordered_json c;
+		c["maps"] = maps;
+		c["have"] = have;
+		resp.body = c.dump(-1, ' ', false, json::error_handler_t::replace);
+		return resp;
+	}
+	else if (p == "/studio/net/outbox")
+	{
+		// requests for the bridge to send; the ones nobody answered in time have failed
+		lock_guard<mutex> lock(g_NetMutex);
+		time_t now = time(NULL);
+		result["requests"] = json::array();
+		bool changed = false;
+		for (auto& r : g_NetRequests)
+		{
+			if ((r.second.status == "waiting" || r.second.status == "sent") && now - r.second.created > REQUEST_SECONDS)
+			{
+				r.second.status = "failed";
+				r.second.error = "No player online has this map.";
+				r.second.changed = now;
+				changed = true;
+			}
+			else if (r.second.status == "waiting")
+			{
+				result["requests"].push_back({ { "id", r.first }, { "key", r.second.key } });
+				r.second.status = "sent";
+				r.second.changed = now;
+			}
+		}
+		if (changed)
+			g_NetCv.notify_all();
+	}
+	else if (p == "/studio/net/result" && req.method == "POST")
+	{
+		json body = json::parse(req.body, nullptr, false);
+		if (body.is_discarded())
+		{
+			resp.status = 400;
+			resp.body = "{}";
+			return resp;
+		}
+		int id = body.value("id", 0);
+		bool ok = body.value("ok", false);
+		string error = body.value("error", ""), from = body.value("from", ""), slotId;
+		if (ok)
+		{
+			string vxl;
+			ordered_json slot = body.contains("slot") && body["slot"].is_object() ? ordered_json::parse(body["slot"].dump()) : ordered_json::object();
+			ok = Base64Decode(body.value("vxl", ""), vxl) && ImportMap(slot, vxl, from, error);
+			slotId = slot.value("id", "");
+			if (!ok && error.empty())
+				error = "the map arrived damaged";
+		}
+		{
+			lock_guard<mutex> lock(g_NetMutex);
+			auto it = g_NetRequests.find(id);
+			if (it != g_NetRequests.end())
+			{
+				it->second.status = ok ? "done" : "failed";
+				it->second.error = ok ? "" : (error.empty() ? "No player online has this map." : error);
+				it->second.slotId = slotId;
+				it->second.from = from;
+				it->second.changed = time(NULL);
+			}
+			g_NetCv.notify_all();
+		}
+		if (!ok)
+			Logger().Info("Studio: request %d failed: %s\n", id, error.c_str());
+		result = { { "ok", ok } };
+	}
+	else if (p == "/studio/net/export")
+	{
+		// another PC asks for a map: by its share code, slot id or resource id
+		string key = QueryValue(req.query, "key");
+		lock_guard<recursive_mutex> lock(m_StudioMutex);
+		ordered_json* s = FindSlotByKey(key);
+		string vxl = s ? ReadFile(string(STUDIO_DIR) + "/resources/" + s->value("resource_id", "") + ".vxl") : "";
+		if (!s || vxl.empty() || s->value("id", "").rfind("tmpl_", 0) == 0)
+			result = { { "ok", false }, { "error", "not on this PC" } };
+		else
+		{
+			ordered_json slot = MapEntry(*s, false);
+			slot["description"] = s->value("description", "");
+			ordered_json out;
+			out["ok"] = true;
+			out["slot"] = slot;
+			out["vxl"] = Base64Encode(vxl);
+			Logger().Info("Studio: sending map %s '%s' (%d bytes) to another player's PC\n", slot["id"].get<string>().c_str(),
+				slot["title"].get<string>().c_str(), (int)vxl.size());
+			resp.body = out.dump(-1, ' ', false, json::error_handler_t::replace);
+			return resp;
+		}
+	}
+	else
+	{
+		resp.status = 404;
+		result = { { "error", "unknown" } };
+	}
+	resp.body = result.dump(-1, ' ', false, json::error_handler_t::replace);
+	return resp;
+}
