+CMedalManager::CMedalManager() : CBaseManager("MedalManager")
+{
+}
+
+bool CMedalManager::Init()
+{
+	return LoadConfig();
+}
+
+static MedalCondition ParseCondition(const json& c)
+{
+	MedalCondition cond;
+	cond.counter = c.value("Counter", "");
+	cond.target = c.value("Target", 0LL);
+	cond.modes = c.value("Modes", vector<int>());
+	cond.level = c.value("Level", 0);
+	cond.points = c.value("Points", 0);
+	cond.medals = c.value("Medals", 0);
+	if (c.contains("Own"))
+	{
+		cond.own = c.value("Own", vector<int>());
+		cond.count = c.value("Count", 1);
+		cond.ownAny = cond.own.empty();
+	}
+	return cond;
+}
+
+bool CMedalManager::LoadConfig()
+{
+	ifstream f("Data/Medals.json");
+	json cfg = json::parse(f, nullptr, false, true);
+	if (cfg.is_discarded() || !cfg.is_object())
+	{
+		Logger().Error("MedalManager: couldn't load Data/Medals.json, no medals\n");
+		return true;
+	}
+	try
+	{
+		m_Groups = cfg.value("Groups", vector<string>());
+		m_Medals.clear();
+		for (auto& m : cfg.value("Medals", json::array()))
+		{
+			Medal medal;
+			medal.id = m.value("ID", 0);
+			medal.resource = m.value("Resource", "");
+			medal.name = m.value("Name", medal.resource);
+			medal.group = m.value("Group", "");
+			medal.lore = m.value("Lore", "");
+			medal.text = m.value("Text", "");
+			for (auto& c : m.value("Conditions", json::array()))
+				medal.conditions.push_back(ParseCondition(c));
+			if (medal.id > 0 && medal.id < 1024 && !medal.conditions.empty())
+				m_Medals.push_back(medal);
+		}
+	}
+	catch (exception& e)
+	{
+		Logger().Error("MedalManager: Data/Medals.json: %s\n", e.what());
+	}
+
+	ifstream sf("Data/SteamAchievements.json");
+	json steam = json::parse(sf, nullptr, false, true);
+	m_Steam.clear();
+	if (steam.is_object())
+	{
+		try
+		{
+			m_bSteamEnabled = steam.value("Enabled", true);
+			for (auto& a : steam.value("Achievements", json::array()))
+			{
+				SteamAchievement ach;
+				ach.name = a.value("Name", "");
+				ach.stat = a.value("Stat", "");
+				ach.text = a.value("Text", "");
+				ach.max = a.value("Max", 0);
+				ach.medal = a.value("Medal", 0);
+				for (auto& c : a.value("Conditions", json::array()))
+					ach.conditions.push_back(ParseCondition(c));
+				if (!ach.name.empty() && (ach.medal || !ach.conditions.empty()))
+					m_Steam.push_back(ach);
+			}
+		}
+		catch (exception& e)
+		{
+			Logger().Error("MedalManager: Data/SteamAchievements.json: %s\n", e.what());
+		}
+	}
+	Logger().Info("MedalManager: %d medals, %d Steam achievements%s\n", (int)m_Medals.size(), (int)m_Steam.size(),
+		m_bSteamEnabled ? "" : " (disabled)");
+	return true;
+}
