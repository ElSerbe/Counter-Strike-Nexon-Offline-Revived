+/**
+ * Offline build: tables for battle pass (warbond) unlocks and daily/weekly order progress.
+ * Both have a userID column, so DeleteLocalAccount cleans them too.
+ */
+bool CUserDatabaseSQLite::CreateWarbondTables()
+{
+	try
+	{
+		m_Database.exec(OBFUSCATE("CREATE TABLE IF NOT EXISTS UserWarbondUnlock (userID INT NOT NULL, warbondID INT NOT NULL, itemID INT NOT NULL, cost INT NOT NULL, time INT NOT NULL, PRIMARY KEY (userID, warbondID, itemID))"));
+		m_Database.exec(OBFUSCATE("CREATE TABLE IF NOT EXISTS UserOrderProgress (userID INT NOT NULL, orderID INT NOT NULL, periodStart INT NOT NULL, progress INT NOT NULL, completed INT NOT NULL, PRIMARY KEY (userID, orderID))"));
+		m_Database.exec(OBFUSCATE("CREATE TABLE IF NOT EXISTS UserCounter (userID INT NOT NULL, mode INT NOT NULL, name TEXT NOT NULL, value INT NOT NULL, PRIMARY KEY (userID, mode, name))"));
+		m_Database.exec(OBFUSCATE("CREATE TABLE IF NOT EXISTS UserMission (userID INT NOT NULL, key TEXT NOT NULL, value INT NOT NULL, state INT NOT NULL, period INT NOT NULL, PRIMARY KEY (userID, key))"));
+	}
+	catch (exception& e)
+	{
+		Logger().Fatal(OBFUSCATE("CUserDatabaseSQLite::CreateWarbondTables: database internal error: %s, %d\n"), e.what(), m_Database.getErrorCode());
+		return false;
+	}
+
+	return true;
+}
