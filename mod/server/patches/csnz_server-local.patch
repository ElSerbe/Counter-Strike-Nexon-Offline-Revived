+// offline build: the first packet on a connection opened by the client's server transfer (Packet_Transfer). Its fields
+// (hw.dll 0x2672e60): the ticket from Packet_Transfer, HWID (16), PC cafe id, the Transfer's byte, local IPv4, session id.
+bool CUserManager::OnTransferLoginPacket(CReceivePacket* msg, IExtendedSocket* socket)
+{
+	LOG_PACKET;
+
+	const vector<unsigned char>& raw = msg->GetData().getBuffer();
+	string hex;
+	char h[4];
+	for (size_t i = (size_t)msg->GetData().getReadOffset(); i < raw.size() && hex.size() < 3 * 96; i++)
+	{
+		snprintf(h, sizeof(h), "%02x ", raw[i]);
+		hex += h;
+	}
+	Logger().Info("Client (%s) sent TransferLogin: %s\n", socket->GetIP().c_str(), hex.c_str());
+
+	string ticket = msg->ReadString();
+	vector<unsigned char> hwid = msg->ReadArray(16);
+	int pcBang = msg->ReadUInt32();
+	int transferByte = msg->ReadUInt8();
+	int ip = msg->ReadUInt32();
+	int sessionID = msg->ReadUInt32();
+	socket->SetHWID(hwid);
+	Logger().Info("TransferLogin: ticket '%s', pcBang %d, byte %d, ip 0x%08x, session %d\n", ticket.c_str(), pcBang, transferByte, ip, sessionID);
+
+	string userName, password, roomPassword, back, remoteSteamID;
+	int joinRoom = 0, tunnelPort = 0;
+	bool guestProfile = false;
+	if (ticket.rfind("r1|", 0) == 0)
+	{
+		// a guest's earlier connection must be gone before their profile is loaded (and it sends nothing home)
+		if (ticket.find('|', 3) != string::npos)
+		{
+			string steamUser = "steam_" + ticket.substr(3, ticket.find('|', 3) - 3);
+			if (IUser* old = GetUserById(GetUserIdByName(steamUser)))
+				if (old->GetExtendedSocket() != socket)
+				{
+					GuestProfiles::Forget(old->GetID());
+					IExtendedSocket* oldSocket = old->GetExtendedSocket();
+					RemoveUser(old);
+					g_pServerInstance->DisconnectClient(oldSocket);
+				}
+		}
+		// a player from another PC, through the Steam bridge
+		if (!PrepareRemotePlayer(socket, ticket, userName, password, joinRoom, roomPassword, back, remoteSteamID, tunnelPort, guestProfile))
+		{
+			g_pServerInstance->DisconnectClient(socket);
+			return true;
+		}
+	}
+	else
+	{
+		if (!ServerTransfer::TakeTicket(ticket, userName))
+		{
+			Logger().Info("TransferLogin: unknown or expired ticket, disconnecting\n");
+			g_pServerInstance->DisconnectClient(socket);
+			return true;
+		}
+
+		vector<LocalAccount_s> accounts;
+		g_UserDatabase.GetLocalAccounts(accounts);
+		auto account = find_if(accounts.begin(), accounts.end(), [&](const LocalAccount_s& a) { return a.userName == userName; });
+		if (account == accounts.end())
+		{
+			Logger().Info("TransferLogin: no local account '%s', disconnecting\n", userName.c_str());
+			g_pServerInstance->DisconnectClient(socket);
+			return true;
+		}
+		password = account->password;
+	}
+
+	// the old connection may still be open (the client closes it just before connecting again)
+	if (IUser* old = GetUserById(GetUserIdByName(userName)))
+		if (old->GetExtendedSocket() != socket)
+		{
+			Logger().Info("TransferLogin: closing '%s''s previous connection\n", userName.c_str());
+			IExtendedSocket* oldSocket = old->GetExtendedSocket();
+			RemoveUser(old);
+			g_pServerInstance->DisconnectClient(oldSocket);
+		}
+
+	m_bTransferLogin = true;
+	int result = LoginUser(socket, userName, password);
+	m_bTransferLogin = false;
+	Logger().Info("TransferLogin: '%s' %s (code %d)\n", userName.c_str(), result == LOGIN_OK ? "logged in" : "failed", result);
+	if (result != LOGIN_OK)
+	{
+		g_pServerInstance->DisconnectClient(socket);
+		return true;
+	}
+
+	IUser* user = GetUserBySocket(socket);
+	if (user && !back.empty())
+		m_ReturnTickets[user->GetID()] = back;
+	if (user && !remoteSteamID.empty())
+	{
+		ServerTransfer::RegisterRemote(user->GetID(), remoteSteamID, tunnelPort);
+		if (guestProfile)
+			GuestProfiles::OnGuestLogin(user->GetID(), remoteSteamID);
+	}
+	if (user && joinRoom)
+	{
+		Logger().Info("TransferLogin: '%s' enters room %d\n", userName.c_str(), joinRoom);
+		if (!g_ChannelManager.JoinRoom(user, joinRoom, roomPassword))
+			g_PacketManager.SendUMsgNoticeMessageInChat(socket, "That room isn't available anymore. Type /home to go back to your own server.");
+	}
+	return true;
+}
+
+// "r1|<Steam ID>|<character name>|<room id>|<room password>|<return ticket>" (CChannelManager::JoinRemoteRoom on the
+// player's own server): the player gets an account here of their own, steam_<Steam ID>, with their character's name
+bool CUserManager::PrepareRemotePlayer(IExtendedSocket* socket, const string& ticket, string& userName, string& password,
+	int& joinRoom, string& roomPassword, string& back, string& steamIDOut, int& tunnelPort, bool& guestProfile)
+{
+	vector<string> f;
+	size_t from = 0;
+	for (;;)
+	{
+		size_t bar = ticket.find('|', from);
+		f.push_back(ticket.substr(from, bar == string::npos ? string::npos : bar - from));
+		if (bar == string::npos)
+			break;
+		from = bar + 1;
+	}
+	if (f.size() < 6 || f[1].empty() || f[1].size() > 20 || f[1].find_first_not_of("0123456789") != string::npos)
+	{
+		Logger().Info("TransferLogin: bad remote ticket, disconnecting\n");
+		return false;
+	}
+	string steamID = f[1], gameName = f[2].substr(0, 16);
+	joinRoom = atoi(f[3].c_str());
+	roomPassword = f[4];
+	back = f[5];
+	tunnelPort = f.size() > 6 ? atoi(f[6].c_str()) : 30003;
+	steamIDOut = steamID;
+	userName = "steam_" + steamID;
+
+	vector<LocalAccount_s> accounts;
+	g_UserDatabase.GetLocalAccounts(accounts);
+	auto account = find_if(accounts.begin(), accounts.end(), [&](const LocalAccount_s& a) { return a.userName == userName; });
+	string existingName;
+	if (account == accounts.end())
+	{
+		static const char alphabet[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+		mt19937 rng(random_device{}());
+		uniform_int_distribution<int> any(0, sizeof(alphabet) - 2);
+		password = "p";
+		for (int i = 0; i < 15; i++)
+			password += alphabet[any(rng)];
+		// its own "IP": the per-IP registration limit would count every remote player as 127.0.0.1
+		if (g_UserDatabase.Register(userName, password, "steam-" + steamID) < 0)
+		{
+			Logger().Info("TransferLogin: couldn't create the account '%s'\n", userName.c_str());
+			return false;
+		}
+		Logger().Info("TransferLogin: new remote player '%s' (%s)\n", userName.c_str(), gameName.c_str());
+	}
+	else
+	{
+		password = account->password;
+		existingName = account->gameName;
+	}
+
+	// the profile their own server sent: they play here with their own character, inventory and progress
+	int accountID = g_UserDatabase.IsUserExists(userName, true);
+	guestProfile = accountID > 0 && GuestProfiles::LoadIncoming(steamID, accountID);
+	if (guestProfile)
+	{
+		CUserCharacter character = {};
+		character.lowFlag = UFLAG_LOW_GAMENAME;
+		g_UserDatabase.GetCharacter(accountID, character);
+		existingName = character.gameName;
+	}
+
+	if (existingName.empty())
+	{
+		UserBan ban = {};
+		int userID = g_UserDatabase.Login(userName, password, socket, ban, NULL);
+		if (userID <= 0)
+		{
+			Logger().Info("TransferLogin: '%s' can't log in (%d)\n", userName.c_str(), userID);
+			return false;
+		}
+		if (gameName.empty())
+			gameName = "Player";
+		bool made = false;
+		for (int i = 0; i < 20 && !made; i++)
+			made = g_UserDatabase.CreateCharacter(userID, i ? gameName.substr(0, 13) + "_" + to_string(i + 1) : gameName) == 1;
+		if (!made)
+		{
+			Logger().Info("TransferLogin: couldn't create a character for '%s'\n", userName.c_str());
+			return false;
+		}
+	}
+	return true;
+}
