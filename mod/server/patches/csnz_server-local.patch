+/**
+ * Runs on the web server thread: everything that touches users or the database is done under the server lock.
+ */
+WebResponse CWarbondManager::OnApiRequest(const WebRequest& req)
+{
+	// a bad request must never take the server down: errors become an error answer (and a log line)
+	g_ServerCriticalSection.Enter();
+	try
+	{
+		return HandleApiRequest(req);
+	}
+	catch (exception& e)
+	{
+		g_ServerCriticalSection.Leave();
+		Logger().Error("Web API %s %s failed: %s (body: %.300s)\n", req.method.c_str(), req.path.c_str(), e.what(), req.body.c_str());
+		WebResponse resp;
+		resp.status = 500;
+		resp.body = json({ { "error", string("The server couldn't do that: ") + e.what() } }).dump();
+		return resp;
+	}
+}
+
+// runs with g_ServerCriticalSection held; leaves it
+WebResponse CWarbondManager::HandleApiRequest(const WebRequest& req)
+{
+	WebResponse resp;
+	json result;
+
+	IUser* user = FindWebUser(req.clientIP);
+	if (req.method == "GET" && req.path == "/api/matchbots")
+	{
+		// for botassist.asi (runs in the game): the AI players of the last match a host started
+		json bots = json::array();
+		json& presets = BotPresets(g_LastMatchHostID);
+		for (auto& b : g_LastMatchBots)
+		{
+			json bot = { { "name", b.name }, { "team", b.team }, { "primary", b.primary }, { "secondary", b.secondary },
+				{ "melee", b.melee }, { "character", b.character }, { "skill", b.skill } };
+			for (auto& p : presets)
+				if (b.preset && p.value("id", 0) == b.preset)
+				{
+					bot["allowPrimary"] = p.value("primary", json::array());
+					bot["allowSecondary"] = p.value("secondary", json::array());
+					bot["allowMelee"] = p.value("melee", json::array());
+					bot["allowCharacter"] = p.value("character", json::array());
+				}
+			bots.push_back(bot);
+		}
+		result = { { "mode", g_LastMatchMode }, { "hostTeam", g_LastMatchHostTeam }, { "bots", bots } };
+	}
+	else if (req.method == "GET" && req.path == "/api/questtexts")
+	{
+		// for botassist.asi: the medals' offline conditions replace the game's texts in My Info's Medals tab
+		result = g_MedalManager.QuestTexts();
+	}
+	else if (!user)
+	{
+		resp.status = 403;
+		result = { { "error", "No logged in character for this computer." } };
+	}
+	else if (req.method == "POST" && req.path == "/api/cheats")
+	{
+		// botassist.asi: sv_cheats is on in the match this computer's player is playing; its medals will be cut
+		CRoom* room = static_cast<CRoom*>(user->GetCurrentRoom());
+		CGameMatch* match = room ? room->GetGameMatch() : NULL;
+		if (match && !match->m_bCheats)
+		{
+			match->m_bCheats = true;
+			Logger().Info("WarbondManager: sv_cheats is on in user %d's match (room %d): medals -%d%%\n", user->GetID(),
+				room->GetID(), m_Medals.cheatPenalty);
+			g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(),
+				va("sv_cheats is on: this match's medals will be cut by %d%%.", m_Medals.cheatPenalty));
+		}
+		result = { { "ok", true }, { "match", match != NULL }, { "penalty", m_Medals.cheatPenalty } };
+	}
+	else if (req.method == "POST" && req.path == "/api/steam")
+	{
+		// botassist.asi: the game's Steam API is up on this computer, the Steam achievements can be sent
+		if (g_MedalManager.SetSteamClient(user->GetExtendedSocket(), true))
+		{
+			Logger().Info("MedalManager: user %d plays through Steam, sending the Steam achievements\n", user->GetID());
+			g_MedalManager.CheckMedals(user);
+		}
+		result = { { "ok", true } };
+	}
+	else if (req.path == "/api/missions")
+	{
+		result = g_MissionManager.Api(user, req.method, req.body, resp.status);
+	}
+	else if (req.method == "GET" && req.path == "/api/profile")
+	{
+		result = g_MedalManager.BuildProfile(user);
+	}
+	else if (req.method == "POST" && req.path == "/api/openview")
+	{
+		// botassist.asi: the room's "AI settings" button opens the game's browser window on the AI player editor
+		json body = json::parse(req.body, nullptr, false);
+		m_OpenView[user->GetID()] = body.is_discarded() ? "" : body.value("view", "");
+		result = { { "ok", true } };
+	}
+	else if (req.path == "/api/botpresets")
+	{
+		result = BotPresetsApi(user, req, resp.status);
+	}
+	else if (req.path == "/api/roombots")
+	{
+		result = RoomBotsApi(user, req, resp.status);
+	}
+	else if (req.method == "GET" && req.path == "/api/state")
+	{
+		result = BuildState(user);
+	}
+	else if (req.method == "POST" && req.path == "/api/unlock")
+	{
+		json body = json::parse(req.body, nullptr, false);
+		if (body.is_discarded())
+		{
+			resp.status = 400;
+			result = { { "error", "Invalid request." } };
+		}
+		else
+		{
+			result = Unlock(user, body.value("warbond", 0), body.value("item", 0), body.value("quantity", 1), resp.status);
+		}
+	}
+	else if (req.method == "POST" && req.path == "/api/unlockpass")
+	{
+		json body = json::parse(req.body, nullptr, false);
+		if (body.is_discarded())
+		{
+			resp.status = 400;
+			result = { { "error", "Invalid request." } };
+		}
+		else
+		{
+			result = UnlockPass(user, body.value("warbond", 0), resp.status);
+		}
+	}
+	else
+	{
+		resp.status = 404;
+		result = { { "error", "Unknown API call." } };
+	}
+	g_ServerCriticalSection.Leave();
+
+	resp.body = result.dump(-1, ' ', false, json::error_handler_t::replace);
+	return resp;
+}
+
+// offline build: the room's AI players. GET: the list; POST {action: add|remove|update|move, ...}
+json CWarbondManager::RoomBotsApi(IUser* user, const WebRequest& req, int& status)
+{
+	CRoom* room = static_cast<CRoom*>(user->GetCurrentRoom());
+	if (!room)
+	{
+		status = 409;
+		return { { "error", "You are not in a room." } };
+	}
+	bool host = room->GetHostUser() == user;
+	if (req.method == "POST")
+	{
+		json body = json::parse(req.body, nullptr, false);
+		if (body.is_discarded())
+		{
+			status = 400;
+			return { { "error", "Invalid request." } };
+		}
+		if (!host)
+		{
+			status = 403;
+			return { { "error", "Only the room's host can change the AI players." } };
+		}
+		if (room->GetStatus() != RoomStatus::STATUS_WAITING)
+		{
+			status = 409;
+			return { { "error", "The match already started." } };
+		}
+		string action = body.value("action", "");
+		auto read = [&](RoomBot& b) {
+			b.name = body.value("name", b.name);
+			b.level = body.value("level", b.level);
+			b.team = body.value("team", b.team);
+			b.primary = body.value("primary", b.primary);
+			b.secondary = body.value("secondary", b.secondary);
+			b.melee = body.value("melee", b.melee);
+			b.character = body.value("character", b.character);
+			b.skill = body.value("skill", b.skill);
+			b.preset = body.value("preset", b.preset);
+		};
+		if (action == "add" || action == "fill")
+		{
+			// add one or more (count), or as many as the room has free slots (fill)
+			int count = action == "fill" ? 64 : body.value("count", 1);
+			if (count < 1)
+				count = 1;
+			int added = 0;
+			for (int i = 0; i < count; i++)
+			{
+				RoomBot b;
+				b.team = 0;
+				read(b);
+				if (!room->AddBot(b))
+					break;
+				added++;
+			}
+			if (!added)
+			{
+				status = 409;
+				return { { "error", "The room is full." } };
+			}
+		}
+		else if (action == "remove")
+			room->RemoveBot(body.value("id", 0));
+		else if (action == "update")
+		{
+			RoomBot* cur = room->FindBot(body.value("id", 0));
+			if (!cur)
+			{
+				status = 404;
+				return { { "error", "No such AI player." } };
+			}
+			RoomBot b = *cur;
+			read(b);
+			room->UpdateBot(b);
+		}
+		else if (action == "move")
+			room->MoveBot(body.value("id", 0), body.value("index", 0));
+		else
+		{
+			status = 400;
+			return { { "error", "Unknown action." } };
+		}
+	}
+	json bots = json::array();
+	for (auto& b : room->GetBots())
+		bots.push_back({ { "id", b.id }, { "name", b.name }, { "level", b.level }, { "team", b.team }, { "primary", b.primary },
+			{ "secondary", b.secondary }, { "melee", b.melee }, { "character", b.character }, { "skill", b.skill },
+			{ "preset", b.preset } });
+	return { { "host", host }, { "mode", room->GetSettings()->gameModeId }, { "maxPlayers", room->GetSettings()->maxPlayers },
+		{ "players", room->GetNumOfPlayers() }, { "bots", bots } };
+}
