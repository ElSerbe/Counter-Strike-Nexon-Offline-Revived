@@ -0,0 +1,419 @@
+// Offline build: Login Supplies (the lobby's Login Supplies button) and the tutorial's rewards, part of CMissionManager.
+//
+// Login Supplies is the game's roulette window (GameUI CRoulettePopupDlg): a calendar of dates with one item a day, a
+// button that collects today's ("Get Login Supplies", Item packet DailyRewards request 1; request 0 asks for the
+// calendar), and up to 5 bonuses for days collected. Data/DailyLogin.json: the calendar has as many days as "Days"
+// (28 by default) and starts on a Sunday, then starts again; a day not collected is lost.
+//
+// The tutorial window (Tutorial button) lists four rewards with the game's text CSO_ZUX_TUTODLG_QUEST_DESC and their
+// progress from a byte of the user info; the game sends RequestUpdateTutorial with that byte (Data/Tutorial.json).
+#include "missionmanager.h"
+#include "medalmanager.h"
+#include "warbondmanager.h"
