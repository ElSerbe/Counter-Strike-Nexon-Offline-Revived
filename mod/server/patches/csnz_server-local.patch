+// ---------------------------------------------------------------------------------------------------------------
+// /api/studio: the Studio maps page (web/maps). Runs under g_ServerCriticalSection: never waits for the bridge.
+json CVoxelManager::MapsApi(IUser* user, const string& method, const string& query, const string& body, int& status)
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	if (method == "GET")
+	{
+		json out;
+		out["steam"] = BridgeOnline();
+		out["max"] = STUDIO_MAX_SLOTS;
+		out["mine"] = json::array();
+		out["downloaded"] = json::array();
+		out["online"] = json::array();
+		for (auto& s : m_Studio["slots"])
+		{
+			if (s.value("deleted", false))
+				continue;
+			if (s.value("owner", 0) == user->GetID())
+			{
+				json m = Plain(MapEntry(s, true));
+				m["published"] = s.value("published", false);
+				m["created"] = s.value("created", 0LL);
+				m["empty"] = s.value("resource_id", "").empty();
+				out["mine"].push_back(m);
+			}
+			else if (s.value("remote", false) && !s.value("resource_id", "").empty())
+			{
+				json m = Plain(MapEntry(s, true));
+				m["fetched"] = s.value("fetched", 0LL);
+				out["downloaded"].push_back(m);
+			}
+		}
+		for (auto& m : CatalogMaps())
+		{
+			json e = Plain(m);
+			ordered_json* local = FindSlot(m.value("id", ""));
+			e["have"] = local != NULL && !local->value("deleted", false);
+			e["outdated"] = e["have"].get<bool>() && local->value("resource_id", "") != m.value("resource_id", "");
+			out["online"].push_back(e);
+		}
+		out["requests"] = json::array();
+		{
+			lock_guard<mutex> nl(g_NetMutex);
+			for (auto& r : g_NetRequests)
+				out["requests"].push_back({ { "id", r.first }, { "key", r.second.key }, { "status", r.second.status },
+					{ "error", r.second.error }, { "slotId", r.second.slotId } });
+		}
+		return out;
+	}
+
+	json b = json::parse(body, nullptr, false);
+	if (b.is_discarded() || !b.is_object())
+	{
+		status = 400;
+		return { { "error", "Invalid request." } };
+	}
+	string action = b.value("action", ""), id = b.value("id", "");
+	ordered_json* s = id.empty() ? NULL : FindSlot(id);
+	bool mine = s && s->value("owner", 0) == user->GetID() && !s->value("deleted", false);
+
+	if (action == "get")
+	{
+		string text = b.value("code", "");
+		string key = NormalizeCode(text);
+		if (key.empty())
+		{
+			key = text;
+			if (!SafeId(key))
+			{
+				status = 400;
+				return { { "error", "That isn't a share code: it has 8 letters and digits, like ABCD-1234." } };
+			}
+		}
+		ordered_json* local = FindSlotByKey(key);
+		const ordered_json* online = CatalogFind(key);
+		if (local && (!online || online->value("resource_id", "") == local->value("resource_id", "")))
+			return { { "ok", true }, { "have", true }, { "id", local->value("id", "") }, { "title", local->value("title", "") } };
+		int request = NetRequest(online ? online->value("id", key) : key);
+		if (!request)
+		{
+			status = 409;
+			return { { "error", "Online play is off: maps come from other players through Steam. Turn on Online play in the launcher." } };
+		}
+		return { { "ok", true }, { "request", request } };
+	}
+	if (action == "publish" || action == "rename" || action == "copy" || action == "delete")
+	{
+		if (!s || s->value("deleted", false) || (!mine && !(action == "delete" && s->value("remote", false)) && action != "copy"))
+		{
+			status = 404;
+			return { { "error", "That map isn't yours." } };
+		}
+	}
+	if (action == "publish")
+	{
+		if (s->value("resource_id", "").empty())
+		{
+			status = 409;
+			return { { "error", "Save the map in the editor first (ESC > Save)." } };
+		}
+		bool on = b.value("on", true);
+		(*s)["published"] = on;
+		if (on && !s->contains("updated"))
+			(*s)["updated"] = (long long)time(NULL);
+		SaveStudio();
+		Logger().Info("Studio: %s %s map %s '%s'\n", user->GetUsername().c_str(), on ? "published" : "unpublished",
+			id.c_str(), s->value("title", "").c_str());
+		return { { "ok", true } };
+	}
+	if (action == "rename")
+	{
+		string title = b.value("title", s->value("title", "")), desc = b.value("description", s->value("description", ""));
+		if (title.find_first_not_of(' ') == string::npos)
+		{
+			status = 400;
+			return { { "error", "The map needs a name." } };
+		}
+		(*s)["title"] = title.substr(0, 60);
+		(*s)["description"] = desc.substr(0, 300);
+		(*s)["updated"] = (long long)time(NULL);
+		SaveStudio();
+		return { { "ok", true } };
+	}
+	if (action == "delete")
+	{
+		string rid = s->value("resource_id", "");
+		for (size_t i = 0; i < m_Studio["slots"].size(); i++)
+		{
+			if (&m_Studio["slots"][i] == s)
+			{
+				m_Studio["slots"].erase(i);
+				break;
+			}
+		}
+		if (SafeId(rid) && rid.rfind("tmpl_", 0) != 0)
+			remove((string(STUDIO_DIR) + "/resources/" + rid + ".vxl").c_str());
+		SaveStudio();
+		Logger().Info("Studio: %s deleted map %s\n", user->GetUsername().c_str(), id.c_str());
+		return { { "ok", true } };
+	}
+	if (action == "copy")
+	{
+		// an editable copy in the player's own studio (a fetched map, or one of theirs)
+		int count = 0;
+		for (auto& x : m_Studio["slots"])
+			if (x.value("owner", 0) == user->GetID() && !x.value("deleted", false))
+				count++;
+		if (count >= STUDIO_MAX_SLOTS)
+		{
+			status = 409;
+			return { { "error", "Your studio is full (" + to_string(STUDIO_MAX_SLOTS) + " maps): delete one first." } };
+		}
+		string data = ReadFile(string(STUDIO_DIR) + "/resources/" + s->value("resource_id", "") + ".vxl");
+		if (data.empty())
+		{
+			status = 409;
+			return { { "error", "The map file is missing." } };
+		}
+		ordered_json slot;
+		slot["id"] = NewId();
+		slot["owner"] = user->GetID();
+		slot["title"] = (s->value("title", "Map") + "_Copy").substr(0, 60);
+		slot["description"] = s->value("description", "");
+		slot["parent_id"] = s->value("id", "");
+		slot["creator_nickname"] = user->GetCharacter(UFLAG_LOW_GAMENAME).gameName;
+		slot["creator_username"] = user->GetUsername();
+		slot["resource_max_player"] = s->value("resource_max_player", 16);
+		slot["resource_mode"] = s->value("resource_mode", 39);
+		slot["permission"] = 0;
+		slot["created"] = slot["updated"] = (long long)time(NULL);
+		slot["published"] = false;
+		string rid = NewId();
+		if (!WriteFile(string(STUDIO_DIR) + "/resources/" + rid + ".vxl", data))
+		{
+			status = 500;
+			return { { "error", "Couldn't write the map file." } };
+		}
+		slot["resource_id"] = rid;
+		m_Studio["slots"].push_back(slot);
+		SaveStudio();
+		Logger().Info("Studio: %s copied map %s into their studio as %s\n", user->GetUsername().c_str(), id.c_str(),
+			slot["id"].get<string>().c_str());
+		return { { "ok", true }, { "id", slot["id"] } };
+	}
+	status = 400;
+	return { { "error", "Unknown action." } };
+}
+
+// Console: studiofetch <share code | slot id | resource id>. Asks the other PCs for a map even when this PC has it (with
+// the Steam bridge's --loopback this PC answers itself: the whole trip over Steam, on one PC).
+static void StudioFetch(CCommand*, const vector<string>& args)
+{
+	if (args.size() < 2)
+	{
+		Logger().Info("studiofetch <share code | slot id | resource id>\n");
+		return;
+	}
+	string key = CVoxelManager::NormalizeCode(args[1]);
+	if (key.empty())
+		key = args[1];
+	thread([key]() {
+		int id = g_VoxelManager.NetRequestPublic(key);
+		if (!id)
+		{
+			Logger().Info("studiofetch: the Steam bridge isn't running\n");
+			return;
+		}
+		time_t start = time(NULL);
+		bool got = g_VoxelManager.NetWaitPublic(id, 70000);
+		Logger().Info("studiofetch: %s %s after %d s\n", key.c_str(), got ? "arrived" : "didn't arrive", (int)(time(NULL) - start));
+	}).detach();
+}
+static CCommand studiofetch("studiofetch", "Fetch a Studio map from the other PCs (Steam bridge)", "studiofetch <code>", StudioFetch);
