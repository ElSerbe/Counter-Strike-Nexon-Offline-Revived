+ * "Create new character" and "Delete a character" (consecutive answer IDs, the client hides others). Cancel quits the game
+ * (GameUI patch); if the window is closed some other way it is shown again (see OnSecondTick) or
+ * with the /character chat command.
+ * @return false if the survey couldn't be sent (caller falls back to the /login chat messages)
+ */
+bool CUserManager::SendCharacterSelect(IExtendedSocket* socket)
+{
+	if (socket->GetIP() != "127.0.0.1")
+		return false;
+
+	vector<LocalAccount_s> accounts;
+	if (!GetOwnAccounts(accounts))
+		return false;
+
+	socket->GetGuestData().characterSelectSentAt = time(NULL);
+	socket->GetGuestData().characterDeleteOpen = false;
+
+	Survey survey;
+	survey.id = CHARACTER_SELECT_SURVEY_ID;
+	survey.title = "Choose your character";
+
+	SurveyQuestion pick = {};
+	pick.id = CHARACTER_SELECT_QUESTION_PICK;
+	pick.question = "Which character do you want to play? (Cancel closes the game)";
+	pick.answerType = 0; // checkboxes
+	pick.answerCheckBoxType = 1; // single choice
+	size_t shown = min(accounts.size(), (size_t)CHARACTER_SELECT_MAX_ACCOUNTS);
+	for (size_t i = 0; i < shown; i++)
+	{
+		const LocalAccount_s& account = accounts[i];
+		string label = account.gameName.empty()
+			? "New character (no name yet)"
+			: account.gameName + "  -  Lv. " + to_string(account.level);
+		pick.answersCheckBox.push_back({ (int)i + 1, label });
+	}
+	pick.answersCheckBox.push_back({ (int)shown + 1, "Create new character" });
+	if (shown)
+		pick.answersCheckBox.push_back({ (int)shown + 2, "Delete a character" });
+	survey.questions.push_back(pick);
+
+	g_PacketManager.SendUserSurvey(socket, survey);
+	return true;
+}
+
+/**
+ * Shows the "Delete a character" survey: pick the character and type its name (or DELETE for a character
+ * that has no name yet) to confirm. "Go back" returns to "Choose your character".
+ */
+bool CUserManager::SendCharacterDelete(IExtendedSocket* socket)
+{
+	vector<LocalAccount_s> accounts;
+	if (!GetOwnAccounts(accounts))
+		return false;
+
+	socket->GetGuestData().characterSelectSentAt = time(NULL);
+	socket->GetGuestData().characterDeleteOpen = true;
+
+	Survey survey;
+	survey.id = CHARACTER_DELETE_SURVEY_ID;
+	survey.title = "Delete a character";
+
+	SurveyQuestion pick = {};
+	pick.id = CHARACTER_DELETE_QUESTION_PICK;
+	pick.question = "Which character do you want to delete? This can't be undone. (Cancel closes the game)";
+	pick.answerType = 0; // checkboxes
+	pick.answerCheckBoxType = 1; // single choice
+	size_t shown = min(accounts.size(), (size_t)CHARACTER_SELECT_MAX_ACCOUNTS);
+	for (size_t i = 0; i < shown; i++)
+	{
+		const LocalAccount_s& account = accounts[i];
+		string label = account.gameName.empty()
+			? "New character (no name yet)"
+			: account.gameName + "  -  Lv. " + to_string(account.level);
+		pick.answersCheckBox.push_back({ (int)i + 1, label });
+	}
+	pick.answersCheckBox.push_back({ (int)shown + 1, "Go back" });
+	survey.questions.push_back(pick);
+
+	SurveyQuestion confirm = {};
+	confirm.id = CHARACTER_DELETE_QUESTION_CONFIRM;
+	confirm.question = "To delete it permanently, type the character's name exactly (type DELETE for a character with no name yet):";
+	confirm.answerType = 1; // text entry
+	confirm.answerTextEntry.unk = 32;
+	survey.questions.push_back(confirm);
+
+	g_PacketManager.SendUserSurvey(socket, survey);
+	return true;
+}
+
+/**
+ * Handles the "Delete a character" answer: deletes the account only if the typed text matches the
+ * character name exactly, then shows "Choose your character" again.
+ */
+bool CUserManager::OnCharacterDeleteAnswer(IExtendedSocket* socket, int choice, string confirmation)
+{
+	auto back = [&](const char* text)
+	{
+		if (text)
+			g_PacketManager.SendUMsgNoticeMsgBoxToUuid(socket, text);
+		SendCharacterSelect(socket);
+		return true;
+	};
+
+	vector<LocalAccount_s> accounts;
+	if (!GetOwnAccounts(accounts))
+		return back("Could not read the character list.");
+	int shown = (int)min(accounts.size(), (size_t)CHARACTER_SELECT_MAX_ACCOUNTS);
+
+	if (choice == shown + 1) // "Go back"
+		return back(NULL);
+	if (choice < 1 || choice > shown)
+		return back("No character was selected, nothing was deleted.");
+
+	const LocalAccount_s& account = accounts[choice - 1];
+
+	size_t first = confirmation.find_first_not_of(" \t\r\n");
+	size_t last = confirmation.find_last_not_of(" \t\r\n");
+	confirmation = first == string::npos ? "" : confirmation.substr(first, last - first + 1);
+
+	const string& expected = account.gameName.empty() ? string("DELETE") : account.gameName;
+	if (confirmation != expected)
+		return back("The name doesn't match, nothing was deleted.");
+
+	if (GetUserByUsername(account.userName))
+		return back("That character is in use right now, nothing was deleted.");
+
+	if (!g_UserDatabase.DeleteLocalAccount(account.userName))
+		return back("Could not delete the character.");
+
+	Logger().Info("CharacterSelect: deleted account '%s' (character '%s')\n", account.userName.c_str(), account.gameName.c_str());
+	string text = account.gameName.empty()
+		? "The character was deleted permanently."
+		: "\"" + account.gameName + "\" was deleted permanently.";
+	return back(text.c_str());
+}
+
+/**
+ * Handles a guest's answer to the "Choose your character" survey: logs in the chosen account, or registers
+ * a new internal account (random name and password) and logs it in, so the game asks for the
+ * character name with its own dialog. On any problem the guest gets a message box and the survey again.
+ */
+bool CUserManager::OnCharacterSelectAnswer(CReceivePacket* msg, IExtendedSocket* socket)
+{
+	if (socket->GetIP() != "127.0.0.1" || !socket->GetGuestData().isGuest)
+		return false;
+
+	if (msg->ReadUInt8() != 11)
+		return false;
+	int surveyID = (int)msg->ReadUInt32();
+	if (surveyID != CHARACTER_SELECT_SURVEY_ID && surveyID != CHARACTER_DELETE_SURVEY_ID)
+		return false;
+
+	int choice = 0;
+	string text;
+	int questionsCount = msg->ReadUInt8();
+	for (int i = 0; i < questionsCount; i++)
+	{
+		int questionID = msg->ReadUInt8();
+		int answerType = msg->ReadUInt8();
+		if (answerType == 1 || answerType == 2)
+		{
+			string answer = msg->ReadString();
+			if (questionID == CHARACTER_DELETE_QUESTION_CONFIRM)
+				text = answer;
+		}
+		else
+		{
+			int count = msg->ReadUInt8();
+			for (int k = 0; k < count; k++)
+			{
+				int answerID = msg->ReadUInt8();
+				if (questionID == CHARACTER_SELECT_QUESTION_PICK) // same ID in both surveys
+					choice = answerID;
+			}
+		}
+	}
+
+	g_PacketManager.SendUserSurveyReply(socket, ANSWER_OK);
+
+	if (surveyID == CHARACTER_DELETE_SURVEY_ID)
+		return OnCharacterDeleteAnswer(socket, choice, text);
+
+	auto retry = [&](const char* text)
+	{
+		g_PacketManager.SendUMsgNoticeMsgBoxToUuid(socket, text);
+		SendCharacterSelect(socket);
+		return true;
+	};
+
+	vector<LocalAccount_s> accounts;
+	if (!GetOwnAccounts(accounts))
+		return retry("Could not read the character list.");
+	int shown = (int)min(accounts.size(), (size_t)CHARACTER_SELECT_MAX_ACCOUNTS);
+
+	string userName, password;
+	if (choice == shown + 1) // "Create new character"
+	{
+		// The account name is internal (the list shows the character name), so generate it:
+		// "Player" + 6 letters fits the server's 5-15 English letters rule.
+		static const char alphabet[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+		mt19937 rng(random_device{}());
+		uniform_int_distribution<int> lower(0, 25), letter(0, 51), any(0, sizeof(alphabet) - 2);
+
+		password = alphabet[letter(rng)]; // starts with a letter: never "only numbers"
+		for (int i = 0; i < 11; i++)
+			password += alphabet[any(rng)];
+
+		int regResult = REGISTER_USERNAME_EXIST;
+		for (int attempt = 0; attempt < 10 && regResult == REGISTER_USERNAME_EXIST; attempt++)
+		{
+			userName = "Player";
+			for (int i = 0; i < 6; i++)
+				userName += alphabet[lower(rng)];
+			regResult = RegisterUser(socket, userName, password);
+		}
+		if (regResult != REGISTER_OK)
+			return retry("Could not create the new character.");
+
+		Logger().Info("CharacterSelect: created account '%s'\n", userName.c_str());
+	}
+	else if (choice == shown + 2 && shown) // "Delete a character"
+	{
+		if (!SendCharacterDelete(socket))
+			return retry("Could not read the character list.");
+		return true;
+	}
+	else if (choice >= 1 && choice <= shown)
+	{
+		userName = accounts[choice - 1].userName;
+		password = accounts[choice - 1].password;
+	}
+	else
+	{
+		return retry("Choose a character from the list or \"Create new character\".");
+	}
+
+	if (LoginUser(socket, userName, password) != LOGIN_OK)
+		return retry("Could not log in with that character.");
+
+	socket->GetGuestData().characterSelectSentAt = 0;
+	Logger().Info("CharacterSelect: '%s' logged in\n", userName.c_str());
+	return true;
 }
 
