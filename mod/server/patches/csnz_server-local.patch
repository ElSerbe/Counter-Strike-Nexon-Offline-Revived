+// offline build: the server list with other people's servers after this one's (Data/RemoteServers.json). Their ids
+// follow the local ones; choosing one of their channels sends the client a Packet_Transfer (CChannelManager::OnRoomListPacket).
+void CPacketManager::SendServerListWithRemotes(IExtendedSocket* socket)
+{
+	vector<RemoteServer_s> remotes = ServerTransfer::LoadRemoteServers();
+	int localCount = (int)g_ChannelManager.channelServers.size();
+
+	CSendPacket* msg = CreatePacket(socket, PacketId::ServerList);
+	msg->BuildHeader();
+	msg->WriteUInt8((unsigned int)(localCount + remotes.size()));
+	for (auto server : g_ChannelManager.channelServers)
+	{
+		msg->WriteUInt8(server->GetID());
+		msg->WriteUInt8(1);
+		msg->WriteUInt8(0);
+		msg->WriteString(server->GetName());
+		msg->WriteUInt8((unsigned int)server->GetChannels().size());
+		for (auto chn : server->GetChannels())
+		{
+			msg->WriteUInt8(chn->GetID());
+			msg->WriteString(chn->GetName());
+			msg->WriteUInt16(0);
+		}
+	}
+	for (size_t i = 0; i < remotes.size(); i++)
+	{
+		msg->WriteUInt8(localCount + 1 + (int)i);
+		msg->WriteUInt8(1);
+		msg->WriteUInt8(0);
+		msg->WriteString(remotes[i].name);
+		msg->WriteUInt8(1);
+		msg->WriteUInt8(1);
+		msg->WriteString(remotes[i].name);
+		msg->WriteUInt16(0);
+	}
+	socket->Send(msg);
+}
+
+// the client reconnects to ip:port (hw.dll forces 127.0.0.1 and lets only ports 30002-30199 through) and sends
+// TransferLogin with the ticket. Read by Packet_Transfer::Decode (hw.dll 0x2672d20): host name, IPv4, port, a byte
+// the client sends back, ticket.
+void CPacketManager::SendTransfer(IExtendedSocket* socket, const string& ip, int port, const string& ticket)
+{
+	CSendPacket* msg = CreatePacket(socket, PacketId::Transfer);
+	msg->BuildHeader();
+	msg->WriteString(ip);
+	msg->WriteUInt32(ip_string_to_int(ip), false);
+	msg->WriteUInt16(port);
+	msg->WriteUInt8(0);
+	msg->WriteString(ticket);
+	socket->Send(msg);
+}
