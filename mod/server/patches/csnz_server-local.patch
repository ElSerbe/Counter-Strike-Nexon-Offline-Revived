diff --git a/src/net/webserver.cpp b/src/net/webserver.cpp
new file mode 100644
index 0000000..da50cfa
--- /dev/null
+++ b/src/net/webserver.cpp
@@ -0,0 +1,276 @@
+#include "webserver.h"
+
+#include <winsock2.h>
+#include <ws2tcpip.h>
+
+#include <fstream>
+#include <sstream>
+#include <algorithm>
+#include <thread>
+#include <atomic>
+
+#include "common/logger.h"
+
+using namespace std;
+
+CWebServer::CWebServer() : m_Thread(ListenThread, this)
+{
+	m_ListenSocket = INVALID_SOCKET;
+	m_bRunning = false;
+}
+
+CWebServer::~CWebServer()
+{
+	Stop();
+}
+
+bool CWebServer::Start(const string& bindIP, int port, const string& root, const ApiHandler& apiHandler)
+{
+	m_Root = root;
+	m_ApiHandler = apiHandler;
+
+	SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+	if (s == INVALID_SOCKET)
+		return false;
+
+	sockaddr_in addr = {};
+	addr.sin_family = AF_INET;
+	addr.sin_port = htons((u_short)port);
+	inet_pton(AF_INET, bindIP.c_str(), &addr.sin_addr);
+
+	if (::bind(s, (sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR || listen(s, SOMAXCONN) == SOCKET_ERROR)
+	{
+		Logger().Error("CWebServer::Start: can't listen on %s:%d (%d)\n", bindIP.c_str(), port, WSAGetLastError());
+		closesocket(s);
+		return false;
+	}
+
+	m_ListenSocket = s;
+	m_bRunning = true;
+	m_Thread.Start();
+
+	Logger().Info("Web shop listening on http://%s:%d/ (files: %s)\n", bindIP.c_str(), port, root.c_str());
+	return true;
+}
+
+void CWebServer::Stop()
+{
+	if (!m_bRunning)
+		return;
+
+	m_bRunning = false;
+	closesocket((SOCKET)m_ListenSocket); // unblocks accept()
+	m_ListenSocket = INVALID_SOCKET;
+	m_Thread.Join();
+}
+
+void* CWebServer::ListenThread(void* data)
+{
+	((CWebServer*)data)->Listen();
+	return NULL;
+}
+
+void CWebServer::Listen()
+{
+	while (m_bRunning)
+	{
+		sockaddr_in from = {};
+		int fromLen = sizeof(from);
+		SOCKET client = accept((SOCKET)m_ListenSocket, (sockaddr*)&from, &fromLen);
+		if (client == INVALID_SOCKET)
+			continue;
+
+		char ip[INET_ADDRSTRLEN] = {};
+		inet_ntop(AF_INET, &from.sin_addr, ip, sizeof(ip));
+
+		DWORD timeout = 5000;
+		setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, (const char*)&timeout, sizeof(timeout));
+
+		// each connection on its own thread: a Studio map another PC is sending over Steam keeps the game's request
+		// waiting (studionet.cpp) while the Steam bridge talks to this same server. The handlers lock what they share.
+		static atomic<int> busy(0);
+		if (busy >= 48)
+		{
+			HandleClient(client, ip);
+			closesocket(client);
+			continue;
+		}
+		busy++;
+		string clientIP = ip;
+		try
+		{
+			thread([this, client, clientIP]() {
+				HandleClient(client, clientIP);
+				closesocket(client);
+				busy--;
+			}).detach();
+		}
+		catch (...)
+		{
+			busy--;
+			HandleClient(client, ip);
+			closesocket(client);
+		}
+	}
+}
+
+static const char* StatusText(int status)
+{
+	switch (status)
+	{
+	case 200: return "OK";
+	case 301: return "Moved Permanently";
+	case 400: return "Bad Request";
+	case 403: return "Forbidden";
+	case 404: return "Not Found";
+	case 409: return "Conflict";
+	default: return "Internal Server Error";
+	}
+}
+
+void CWebServer::HandleClient(unsigned long long clientSocket, const string& clientIP)
+{
+	SOCKET client = (SOCKET)clientSocket;
+
+	// read the headers, then the body announced by Content-Length
+	string data;
+	char buf[8192];
+	size_t headerEnd = string::npos;
+	while ((headerEnd = data.find("\r\n\r\n")) == string::npos)
+	{
+		int n = recv(client, buf, sizeof(buf), 0);
+		if (n <= 0 || data.size() > 65536)
+			return;
+		data.append(buf, n);
+	}
+
+	WebRequest req;
+	req.clientIP = clientIP;
+	istringstream head(data.substr(0, headerEnd));
+	string requestLine;
+	getline(head, requestLine);
+	istringstream rl(requestLine);
+	string target;
+	rl >> req.method >> target;
+	size_t q = target.find('?');
+	req.path = target.substr(0, q);
+	if (q != string::npos)
+		req.query = target.substr(q + 1);
+	// the game's Studio client (cpprestsdk) asks for "/v6/..." and "v6/..." alike
+	if (!req.path.empty() && req.path[0] != '/')
+		req.path = "/" + req.path;
+
+	size_t contentLength = 0;
+	string line;
+	while (getline(head, line))
+	{
+		if (!line.empty() && line.back() == '\r')
+			line.pop_back();
+		req.headers += line + "\n";
+		string lower = line;
+		transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+		if (lower.rfind("content-length:", 0) == 0)
+			contentLength = strtoul(line.c_str() + 15, NULL, 10);
+		else if (lower.rfind("content-type:", 0) == 0)
+			req.contentType = line.substr(line.find_first_not_of(' ', 13));
+	}
+
+	// Studio maps are uploaded whole (up to 64 MB); everything else stays small
+	// ... and so do the profiles the Steam bridge brings (/api/guest/, guestprofile.h)
+	size_t maxBody = IsStudioPath(req.path) || req.path.rfind("/api/guest/", 0) == 0 ? 64 * 1024 * 1024 : 1024 * 1024;
+	req.body = data.substr(headerEnd + 4);
+	while (req.body.size() < contentLength && contentLength <= maxBody)
+	{
+		int n = recv(client, buf, sizeof(buf), 0);
+		if (n <= 0)
+			return;
+		req.body.append(buf, n);
+	}
+
+	WebResponse resp;
+	string extraHeaders;
+	if (m_StudioHandler && IsStudioPath(req.path))
+	{
+		resp = m_StudioHandler(req);
+	}
+	else if (req.path.rfind("/api/", 0) == 0)
+	{
+		resp = m_ApiHandler(req);
+	}
+	else if (req.method != "GET")
+	{
+		resp.status = 400;
+		resp.body = "{}";
+	}
+	else if (req.path == "/" || req.path == "/shop")
+	{
+		resp.status = 301;
+		resp.contentType = "text/plain";
+		extraHeaders = "Location: /shop/\r\n";
+	}
+	else
+	{
+		resp = ServeFile(req.path);
+	}
+
+	ostringstream out;
+	out << "HTTP/1.1 " << resp.status << " " << StatusText(resp.status) << "\r\n"
+		<< "Content-Type: " << resp.contentType << "\r\n"
+		<< "Content-Length: " << resp.body.size() << "\r\n"
+		<< "Cache-Control: no-store\r\n"
+		<< extraHeaders
+		<< "Connection: close\r\n\r\n";
+	string headers = out.str();
+	send(client, headers.data(), (int)headers.size(), 0);
+	if (!resp.body.empty())
+		send(client, resp.body.data(), (int)resp.body.size(), 0);
+}
+
+bool CWebServer::IsStudioPath(const string& path)
+{
+	for (const char* prefix : { "/v4/", "/v5/", "/v6/", "/resources_prod/", "/images_prod/", "/studio/" })
+	{
+		if (path.rfind(prefix, 0) == 0)
+			return true;
+	}
+	return false;
+}
+
+WebResponse CWebServer::ServeFile(const string& urlPath)
+{
+	WebResponse resp;
+	string path = urlPath;
+	if (path.find("..") != string::npos || path.find('\\') != string::npos || path.find(':') != string::npos)
+	{
+		resp.status = 403;
+		resp.contentType = "text/plain";
+		return resp;
+	}
+	if (path.back() == '/')
+		path += "index.html";
+
+	ifstream f(m_Root + path, ios::binary);
+	if (!f)
+	{
+		resp.status = 404;
+		resp.contentType = "text/plain";
+		resp.body = "Not found";
+		return resp;
+	}
+	resp.body.assign(istreambuf_iterator<char>(f), istreambuf_iterator<char>());
+
+	string ext = path.substr(path.find_last_of('.') + 1);
+	transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+	if (ext == "html") resp.contentType = "text/html; charset=utf-8";
+	else if (ext == "css") resp.contentType = "text/css; charset=utf-8";
+	else if (ext == "js") resp.contentType = "application/javascript; charset=utf-8";
+	else if (ext == "json") resp.contentType = "application/json; charset=utf-8";
+	else if (ext == "png") resp.contentType = "image/png";
+	else if (ext == "jpg" || ext == "jpeg") resp.contentType = "image/jpeg";
+	else if (ext == "svg") resp.contentType = "image/svg+xml";
+	else if (ext == "webp") resp.contentType = "image/webp";
+	else if (ext == "woff2") resp.contentType = "font/woff2";
+	else if (ext == "wav") resp.contentType = "audio/wav";
+	else resp.contentType = "application/octet-stream";
+	return resp;
+}
