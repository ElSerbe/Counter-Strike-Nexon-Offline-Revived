diff --git a/src/manager/transfer.cpp b/src/manager/transfer.cpp
new file mode 100644
index 0000000..bd73e15
--- /dev/null
+++ b/src/manager/transfer.cpp
@@ -0,0 +1,77 @@
+#include "transfer.h"
+#include "main.h"
+
+#include "nlohmann/json.hpp"
+
+#include <ctime>
+#include <fstream>
+#include <map>
+#include <random>
+
+using namespace std;
+using json = nlohmann::json;
+
+namespace
+{
+	struct Ticket_s
+	{
+		string userName;
+		time_t issued;
+	};
+	map<string, Ticket_s> g_Tickets;
+}
+
+vector<RemoteServer_s> ServerTransfer::LoadRemoteServers()
+{
+	vector<RemoteServer_s> list;
+	ifstream f("Data/RemoteServers.json");
+	if (!f.is_open())
+		return list;
+	try
+	{
+		json j = json::parse(f, nullptr, true, true);
+		for (auto& s : j.value("servers", json::array()))
+		{
+			RemoteServer_s r;
+			r.name = s.value("name", string("Remote server"));
+			r.port = s.value("port", 0);
+			if (r.port < 30002 || r.port > 30199) // the client's patch only lets these ports through
+				continue;
+			list.push_back(r);
+			if (list.size() >= 32)
+				break;
+		}
+	}
+	catch (exception& e)
+	{
+		Logger().Warn("Data/RemoteServers.json: %s\n", e.what());
+	}
+	return list;
+}
+
+string ServerTransfer::IssueTicket(const string& userName)
+{
+	static const char alphabet[] = "abcdefghijklmnopqrstuvwxyz0123456789";
+	static mt19937 rng(random_device{}());
+	uniform_int_distribution<int> any(0, sizeof(alphabet) - 2);
+
+	time_t now = time(NULL);
+	for (auto it = g_Tickets.begin(); it != g_Tickets.end();)
+		it = now - it->second.issued > 120 ? g_Tickets.erase(it) : next(it);
+
+	string ticket;
+	for (int i = 0; i < 24; i++)
+		ticket += alphabet[any(rng)];
+	g_Tickets[ticket] = { userName, now };
+	return ticket;
+}
+
+bool ServerTransfer::TakeTicket(const string& ticket, string& userName)
+{
+	auto it = g_Tickets.find(ticket);
+	if (it == g_Tickets.end() || time(NULL) - it->second.issued > 120)
+		return false;
+	userName = it->second.userName;
+	g_Tickets.erase(it);
+	return true;
+}
