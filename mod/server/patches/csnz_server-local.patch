+/**
+ * Permanently deletes an account and everything stored for it (offline build: "Delete a character").
+ * Every table with a userID column is cleaned, so nothing is left behind even for tables added later.
+ * @return 1 if the account existed and was deleted, 0 otherwise
+ */
+int CUserDatabaseSQLite::DeleteLocalAccount(const string& userName)
+{
+	try
+	{
+		SQLite::Statement find(m_Database, "SELECT userID FROM User WHERE userName = ?");
+		find.bind(1, userName);
+		if (!find.executeStep())
+			return 0;
+		int userID = find.getColumn(0);
+
+		// clans led by this user would be left without a master, so they go too
+		vector<int> clanIDs;
+		SQLite::Statement clans(m_Database, "SELECT clanID FROM Clan WHERE masterUserID = ?");
+		clans.bind(1, userID);
+		while (clans.executeStep())
+			clanIDs.push_back(clans.getColumn(0));
+
+		vector<string> userTables, clanTables;
+		SQLite::Statement list(m_Database, "SELECT name FROM sqlite_master WHERE type = 'table'");
+		while (list.executeStep())
+		{
+			string table = list.getColumn(0).getString();
+			SQLite::Statement columns(m_Database, "SELECT name FROM pragma_table_info(?) WHERE name IN ('userID', 'clanID')");
+			columns.bind(1, table);
+			while (columns.executeStep())
+				(columns.getColumn(0).getString() == "userID" ? userTables : clanTables).push_back(table);
+		}
+
+		SQLite::Transaction transaction(m_Database);
+		for (auto& table : userTables)
+		{
+			SQLite::Statement del(m_Database, "DELETE FROM \"" + table + "\" WHERE userID = ?");
+			del.bind(1, userID);
+			del.exec();
+		}
+		for (int clanID : clanIDs)
+		{
+			for (auto& table : clanTables)
+			{
+				SQLite::Statement del(m_Database, "DELETE FROM \"" + table + "\" WHERE clanID = ?");
+				del.bind(1, clanID);
+				del.exec();
+			}
+		}
+		transaction.commit();
+	}
+	catch (exception& e)
+	{
+		Logger().Error(OBFUSCATE("CUserDatabaseSQLite::DeleteLocalAccount: database internal error: %s, %d\n"), e.what(), m_Database.getErrorCode());
+		return 0;
+	}
+
+	return 1;
+}
+
+// Offline build: the tables that make up a player's profile (every table with a userID column but the login, session,
+// ban and clan ones). Used to carry a profile to another PC's server and back (guestprofile.cpp).
+static bool ProfileTable(const string& table)
+{
+	static const char* skip[] = { "User", "UserSession", "UserSessionHistory", "UserBan", "UserBanList", "UserRestore", "UserSurveyAnswer" };
+	for (auto s : skip)
+		if (table == s)
+			return false;
+	return table.rfind("Clan", 0) != 0;
+}
+
+static vector<string> ProfileTables(SQLite::Database& db)
+{
+	vector<string> tables;
+	SQLite::Statement list(db, "SELECT name FROM sqlite_master WHERE type = 'table'");
+	while (list.executeStep())
+	{
+		string table = list.getColumn(0).getString();
+		if (!ProfileTable(table))
+			continue;
+		SQLite::Statement columns(db, "SELECT 1 FROM pragma_table_info(?) WHERE name = 'userID'");
+		columns.bind(1, table);
+		if (columns.executeStep())
+			tables.push_back(table);
+	}
+	return tables;
+}
+
+/**
+ * Offline build: every profile row of an account as JSON text:
+ * {"tables": {"<table>": {"columns": [...], "rows": [[...], ...]}}}; blobs are {"hex": "..."}.
+ * @return 1 on success
+ */
+int CUserDatabaseSQLite::ExportUserData(int userID, string& out)
+{
+	try
+	{
+		nlohmann::json tables = nlohmann::json::object();
+		for (auto& table : ProfileTables(m_Database))
+		{
+			SQLite::Statement query(m_Database, "SELECT * FROM \"" + table + "\" WHERE userID = ?");
+			query.bind(1, userID);
+			nlohmann::json columns = nlohmann::json::array(), rows = nlohmann::json::array();
+			for (int c = 0; c < query.getColumnCount(); c++)
+				columns.push_back(query.getColumnName(c));
+			while (query.executeStep())
+			{
+				nlohmann::json row = nlohmann::json::array();
+				for (int c = 0; c < query.getColumnCount(); c++)
+				{
+					SQLite::Column col = query.getColumn(c);
+					if (col.isInteger())
+						row.push_back(col.getInt64());
+					else if (col.isFloat())
+						row.push_back(col.getDouble());
+					else if (col.isText())
+						row.push_back(col.getString());
+					else if (col.isBlob())
+					{
+						static const char digits[] = "0123456789abcdef";
+						const unsigned char* b = (const unsigned char*)col.getBlob();
+						string hex;
+						for (int i = 0; i < col.getBytes(); i++)
+						{
+							hex += digits[b[i] >> 4];
+							hex += digits[b[i] & 15];
+						}
+						row.push_back({ { "hex", hex } });
+					}
+					else
+						row.push_back(nullptr);
+				}
+				rows.push_back(row);
+			}
+			tables[table] = { { "columns", columns }, { "rows", rows } };
+		}
+		out = nlohmann::json({ { "tables", tables } }).dump();
+	}
+	catch (exception& e)
+	{
+		Logger().Error("CUserDatabaseSQLite::ExportUserData: database internal error: %s, %d\n", e.what(), m_Database.getErrorCode());
+		return 0;
+	}
+	return 1;
+}
+
+/**
+ * Offline build: replaces an account's profile rows with ExportUserData's JSON (from this or another PC). Columns this
+ * database doesn't have are left out, missing ones get their defaults. clearMissing: tables the JSON doesn't have are
+ * emptied for the account too (otherwise kept). keepGameName: the character keeps the name it has here.
+ * @return 1 on success (nothing is changed on failure)
+ */
+int CUserDatabaseSQLite::ImportUserData(int userID, const string& data, bool clearMissing, bool keepGameName)
+{
+	try
+	{
+		nlohmann::json j = nlohmann::json::parse(data);
+		const nlohmann::json& tables = j.at("tables");
+
+		string gameName;
+		if (keepGameName)
+		{
+			SQLite::Statement name(m_Database, "SELECT gameName FROM UserCharacter WHERE userID = ?");
+			name.bind(1, userID);
+			if (name.executeStep())
+				gameName = name.getColumn(0).getString();
+		}
+
+		SQLite::Transaction transaction(m_Database);
+		for (auto& table : ProfileTables(m_Database))
+		{
+			auto t = tables.find(table);
+			if (t == tables.end() && !clearMissing)
+				continue;
+			SQLite::Statement del(m_Database, "DELETE FROM \"" + table + "\" WHERE userID = ?");
+			del.bind(1, userID);
+			del.exec();
+			if (t == tables.end())
+				continue;
+
+			// the columns both sides have
+			set<string> here;
+			SQLite::Statement info(m_Database, "SELECT name FROM pragma_table_info(?)");
+			info.bind(1, table);
+			while (info.executeStep())
+				here.insert(info.getColumn(0).getString());
+			const nlohmann::json& columns = t->at("columns");
+			vector<int> use;
+			string names, marks;
+			for (int c = 0; c < (int)columns.size(); c++)
+			{
+				string name = columns[c].get<string>();
+				if (!here.count(name) || name.find('"') != string::npos)
+					continue;
+				use.push_back(c);
+				names += (names.empty() ? "\"" : ", \"") + name + "\"";
+				marks += marks.empty() ? "?" : ", ?";
+			}
+			if (use.empty())
+				continue;
+			for (auto& row : t->at("rows"))
+			{
+				SQLite::Statement ins(m_Database, "INSERT OR REPLACE INTO \"" + table + "\" (" + names + ") VALUES (" + marks + ")");
+				for (int k = 0; k < (int)use.size(); k++)
+				{
+					const nlohmann::json& v = row.at(use[k]);
+					if (columns[use[k]].get<string>() == "userID")
+						ins.bind(k + 1, userID);
+					else if (v.is_null())
+						ins.bind(k + 1);
+					else if (v.is_number_integer())
+						ins.bind(k + 1, (long long)v.get<int64_t>());
+					else if (v.is_number())
+						ins.bind(k + 1, v.get<double>());
+					else if (v.is_string())
+						ins.bind(k + 1, v.get<string>());
+					else if (v.is_object() && v.contains("hex"))
+					{
+						string hex = v["hex"].get<string>();
+						vector<unsigned char> blob;
+						for (size_t i = 0; i + 1 < hex.size(); i += 2)
+							blob.push_back((unsigned char)stoi(hex.substr(i, 2), nullptr, 16));
+						ins.bind(k + 1, blob.data(), (int)blob.size());
+					}
+					else
+						ins.bind(k + 1);
+				}
+				ins.exec();
+			}
+		}
+		if (keepGameName && !gameName.empty())
+		{
+			SQLite::Statement name(m_Database, "UPDATE UserCharacter SET gameName = ? WHERE userID = ?");
+			name.bind(1, gameName);
+			name.bind(2, userID);
+			name.exec();
+		}
+		transaction.commit();
+	}
+	catch (exception& e)
+	{
+		Logger().Error("CUserDatabaseSQLite::ImportUserData: %s, %d\n", e.what(), m_Database.getErrorCode());
+		return 0;
+	}
+	return 1;
+}
+
+/**
+ * Offline build: tables for battle pass (warbond) unlocks and daily/weekly order progress.
+ * Both have a userID column, so DeleteLocalAccount cleans them too.
+ */
+bool CUserDatabaseSQLite::CreateWarbondTables()
+{
+	try
+	{
+		m_Database.exec(OBFUSCATE("CREATE TABLE IF NOT EXISTS UserWarbondUnlock (userID INT NOT NULL, warbondID INT NOT NULL, itemID INT NOT NULL, cost INT NOT NULL, time INT NOT NULL, PRIMARY KEY (userID, warbondID, itemID))"));
+		m_Database.exec(OBFUSCATE("CREATE TABLE IF NOT EXISTS UserOrderProgress (userID INT NOT NULL, orderID INT NOT NULL, periodStart INT NOT NULL, progress INT NOT NULL, completed INT NOT NULL, PRIMARY KEY (userID, orderID))"));
+		m_Database.exec(OBFUSCATE("CREATE TABLE IF NOT EXISTS UserCounter (userID INT NOT NULL, mode INT NOT NULL, name TEXT NOT NULL, value INT NOT NULL, PRIMARY KEY (userID, mode, name))"));
+		m_Database.exec(OBFUSCATE("CREATE TABLE IF NOT EXISTS UserMission (userID INT NOT NULL, key TEXT NOT NULL, value INT NOT NULL, state INT NOT NULL, period INT NOT NULL, PRIMARY KEY (userID, key))"));
+	}
+	catch (exception& e)
+	{
+		Logger().Fatal(OBFUSCATE("CUserDatabaseSQLite::CreateWarbondTables: database internal error: %s, %d\n"), e.what(), m_Database.getErrorCode());
+		return false;
+	}
+
+	return true;
+}
