+#pragma once
+
+#include <string>
+#include <vector>
+#include <map>
+
+#include "interface/imanager.h"
+#include "manager.h"
+#include "nlohmann/json.hpp"
+
+class IUser;
+struct UserCounter_s;
+struct UserMission_s;
+struct RewardItem;
+
+// a statistic (CMedalManager counter) that must grow by `target` after the mission is taken
+struct MissionRequirement
+{
+	std::string counter;
+	long long target = 0;
+	std::vector<int> modes; // empty: all modes
+};
+
+struct MissionRequest
+{
+	int id;
+	std::string title, npc, portrait, story, text;
+	std::vector<MissionRequirement> conditions;
+	int badges = 0, medals = 0;
+};
+
+struct EventMission
+{
+	std::string text;
+	std::vector<MissionRequirement> conditions;
+	int badges = 0, medals = 0;
+};
+
+struct MissionEvent
+{
+	int id;
+	std::string name, description;
+	std::vector<EventMission> missions;
+	int bonusBadges = 0, bonusMedals = 0;
+};
+
+struct MarketItem
+{
+	int itemID;
+	std::string name, kind; // "Weapon" or "Costume"
+	int price;
+};
+
+// a day of Login Supplies (Data/DailyLogin.json), a bonus for days collected, or a tutorial reward (Data/Tutorial.json):
+// the item the game's window shows, and currencies that come with it
+struct LoginReward
+{
+	int itemID = 0, count = 1, days = 0; // days 0: permanent
+	std::string name;                    // for the chat line and the Missions page (the item's name when empty)
+	int medals = 0, badges = 0, riftTickets = 0, bingoTickets = 0;
+	int after = 0;                       // a bonus: given when this many days of the period are collected
+	int bit = 0;                         // a tutorial reward: its bit of the tutorial byte
+};
+
+class IMissionManager : public IBaseManager
+{
+};
+
+/**
+ * Offline build: the Missions page (taskbar Missions button). Mission requests from the game's quest NPCs (a few
+ * offers a day, some taken at once), the event of the week, and the Black Market (the game's black badge shop, a
+ * new stock every day) paid with Black Badges, which only missions give. Data/Missions.json (tools/gen_missions.py).
+ * Daily and weekly orders and challenges stay in CWarbondManager; the page shows them too.
+ */
+class CMissionManager : public CBaseManager<IMissionManager>
+{
+public:
+	CMissionManager();
+
+	virtual bool Init();
+
+	// GET / POST /api/missions {action: accept|abandon|claim (id) | claimEvent (index) | claimBonus | buy (itemID)}
+	nlohmann::json Api(IUser* user, const std::string& method, const std::string& body, int& status);
+
+	// Login Supplies (the lobby's Login Supplies button, the game's roulette window, Item packet DailyRewards): a
+	// calendar of PeriodDays days starting on Sundays, one reward a day collected with the window's button (missed days
+	// are lost), and bonuses for days collected (Data/DailyLogin.json, loginsupplies.cpp)
+	void SendLoginSupplies(IUser* user);
+	void OnLoginSuppliesRequest(IUser* user, int request);
+	void OnLogin(IUser* user);
+	void OnMatchEnd(IUser* user); // a new day while the game is open: the window gets the new day
+
+	// the tutorial window (Tutorial button): the game sends RequestUpdateTutorial with its byte of tutorial bits (bit 0
+	// Zombie Experience, 1 Tutorial 1, 2 Tutorial 2, 3 Mission Chain); each new bit gives its reward (Data/Tutorial.json).
+	// The byte goes back to the game in the user info (UFLAG_LOW_UNK15, second byte).
+	int TutorialFlags(int userID);
+	void OnTutorialUpdate(IUser* user, int value);
+
+	// game texts botassist replaces (GET /api/questtexts, Data/GameTexts.json): the tutorial's reward list, the Point Coupon
+	nlohmann::json TextOverrides();
+
+private:
+	bool LoadConfig();
+	void LoadLoginSupplies();
+	nlohmann::json LoginJson(IUser* user);
+	nlohmann::json RewardJson(const LoginReward& r);
+	std::string RewardName(const LoginReward& r);
+	std::string Give(IUser* user, const LoginReward& r, std::vector<RewardItem>& shown);
+	int PeriodStart(int day);
+	struct LoginState { int period; long long collected; long long bonuses; };
+	LoginState GetLoginState(int userID);
+	nlohmann::json Build(IUser* user);
+	static int Today();
+	static int ThisWeek();
+	static long long Total(const std::vector<UserCounter_s>& counters, const MissionRequirement& req);
+	std::vector<int> Offers(int userID, int day, const std::map<std::string, UserMission_s>& missions);
+	std::vector<const MarketItem*> Stock(int day);
+	const MissionEvent* CurrentEvent();
+	nlohmann::json Progress(const std::vector<MissionRequirement>& reqs, const std::string& prefix,
+		const std::vector<UserCounter_s>& counters, const std::map<std::string, UserMission_s>& missions, bool& done);
+	std::vector<UserMission_s> Start(const std::vector<MissionRequirement>& reqs, const std::string& prefix,
+		const std::vector<UserCounter_s>& counters, int period);
+	void Reward(IUser* user, int badges, int medals, const char* what);
+
+	std::vector<MissionRequest> m_Requests;
+	std::vector<MissionEvent> m_Events;
+	std::vector<MarketItem> m_Market;
+	int m_RequestOffers = 4, m_RequestSlots = 3, m_MarketWeapons = 6, m_MarketCostumes = 2;
+	bool m_LoginEnabled = false;
+	int m_PeriodDays = 28;
+	std::vector<LoginReward> m_LoginDays, m_LoginBonuses, m_TutorialRewards;
+	nlohmann::json m_GameTexts;           // Data/GameTexts.json
+	std::map<int, int> m_LoginSentDay;    // the day each user's window was last sent
+	std::map<int, int> m_TutorialFlags; // cache: the user info is built often
+};
+
+extern CMissionManager g_MissionManager;
