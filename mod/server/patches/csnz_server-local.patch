+// The shop page is opened by the game's own browser, so the request comes from the player's computer.
+IUser* CWarbondManager::FindWebUser(const string& ip)
+{
+	for (auto user : g_UserManager.GetUsers())
+	{
+		if (user->GetExtendedSocket() && user->GetExtendedSocket()->GetIP() == ip)
+			return user;
+	}
+	return NULL;
+}
+
+static string ItemCell(int itemID, const char* column)
+{
+	string key = to_string(itemID);
+	if (g_pItemTable->GetRowIdx(key) < 0)
+		return "";
+	string value = g_pItemTable->GetCell<string>(column, key);
+	value.erase(value.find_last_not_of(" \t\r\n") + 1);
+	return value;
+}
+
+string CWarbondManager::ItemName(int itemID)
+{
+	auto it = m_ItemNames.find(itemID);
+	return it != m_ItemNames.end() ? it->second : ItemCell(itemID, "Name");
+}
+
+static string CategoryName(int itemID)
+{
+	if (ItemCell(itemID, "ClassName") == "Class")
+		return "Characters";
+
+	string category = ItemCell(itemID, "Category");
+	int c = category.empty() ? 0 : atoi(category.c_str());
+	switch (c)
+	{
+	case 1: return "Pistols";
+	case 2: return "Shotguns";
+	case 3: return "SMGs";
+	case 4: return "Rifles";
+	case 5: return "Machine guns";
+	case 6: return "Equipment";
+	case 7: return "Characters";
+	case 11: return "Melee";
+	case 12: return "Costumes";
+	default: return "Items";
+	}
+}
+
+// weapon stats as shown by the native shop (0-100 bars); empty for non-weapons
+static json WeaponStats(int itemID)
+{
+	if (ItemCell(itemID, "ClassName") != "Equipment")
+		return nullptr;
+	int category = atoi(ItemCell(itemID, "Category").c_str());
+	if (!(category >= 1 && category <= 5) && category != 11)
+		return nullptr;
+
+	auto num = [&](const char* column) { return atoi(ItemCell(itemID, column).c_str()); };
+	json stats = { { "damage", num("Damage") }, { "accuracy", num("HitRate") }, { "recoil", num("Reaction") },
+		{ "rate", num("FiringSpeed") }, { "weight", num("Weight") } };
+	if (!stats["damage"].get<int>() && !stats["accuracy"].get<int>() && !stats["recoil"].get<int>() && !stats["rate"].get<int>() && !stats["weight"].get<int>())
+		return nullptr; // melee weapons have no values in Item.csv
+	return stats;
+}
+
+// local midnight of today (Daily) or of this week's Monday (Weekly); challenges never reset (0)
+int CWarbondManager::CurrentPeriodStart(const string& period)
+{
+	if (period == "Challenge")
+		return 0;
+	time_t now = time(NULL);
+	tm local = *localtime(&now);
+	local.tm_hour = local.tm_min = local.tm_sec = 0;
+	if (period == "Weekly")
+		local.tm_mday -= (local.tm_wday + 6) % 7;
+	local.tm_isdst = -1;
+	return (int)mktime(&local);
+}
+
+// half price for buying back an item that was unlocked before, rounded up to a multiple of 5 like every price
+int CWarbondManager::RebuyCost(int cost)
+{
+	return ((cost + 1) / 2 + 4) / 5 * 5;
+}
+
+// item IDs in the user's inventory (slots of removed items have itemID 0, expired ones inUse 0)
+set<int> CWarbondManager::OwnedItems(IUser* user)
+{
+	vector<CUserInventoryItem> inventory;
+	g_UserDatabase.GetInventoryItems(user->GetID(), inventory);
+	set<int> owned;
+	for (auto& item : inventory)
+		if (item.m_nItemID && item.m_nInUse)
+			owned.insert(item.m_nItemID);
+	return owned;
+}
