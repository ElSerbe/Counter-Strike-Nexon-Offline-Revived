+	if (bot.name.empty())
+	{
+		// a random name no other bot of the room has
+		vector<string> free;
+		for (auto n : s_BotNames)
+		{
+			bool used = false;
+			for (auto& b : m_Bots)
+				used |= b.name == n;
+			if (!used)
+				free.push_back(n);
+		}
+		bot.name = free.empty() ? "Bot" + to_string(m_Bots.size() + 1) : free[rand() % free.size()];
+	}
+	if (bot.name.size() > 24)
+		bot.name.resize(24);
+	if (bot.level <= 0)
+		bot.level = 10 + rand() % 51;
+	if (bot.team != RoomTeamNum::Terrorist && bot.team != RoomTeamNum::CounterTerrorist)
+		bot.team = m_pHostUser ? GetUserTeam(m_pHostUser) : RoomTeamNum::CounterTerrorist;
+	if (bot.team != RoomTeamNum::Terrorist && bot.team != RoomTeamNum::CounterTerrorist)
+		bot.team = RoomTeamNum::CounterTerrorist;
+
+	m_Bots.push_back(bot);
+	for (auto u : m_Users)
+		SendBotTo(u, m_Bots.back(), m_pHostUser ? m_pHostUser : u);
+
+	Logger().Info("Room %d: AI player '%s' added (team %d)\n", m_nID, bot.name.c_str(), bot.team);
+	return &m_Bots.back();
+}
+
+bool CRoom::RemoveBot(int id)
+{
+	for (size_t i = 0; i < m_Bots.size(); i++)
+	{
+		if (m_Bots[i].id != id)
+			continue;
+		Logger().Info("Room %d: AI player '%s' removed\n", m_nID, m_Bots[i].name.c_str());
+		m_Bots.erase(m_Bots.begin() + i);
+		for (auto u : m_Users)
+			g_PacketManager.SendRoomPlayerLeave(u->GetExtendedSocket(), id);
+		return true;
+	}
+	return false;
+}
+
+bool CRoom::UpdateBot(const RoomBot& bot)
+{
+	RoomBot* cur = FindBot(bot.id);
+	if (!cur)
+		return false;
+	RoomBot was = *cur;
+	*cur = bot;
+	if (cur->name.empty())
+		cur->name = "Bot";
+	if (cur->name.size() > 24)
+		cur->name.resize(24);
+	if (cur->team != RoomTeamNum::Terrorist && cur->team != RoomTeamNum::CounterTerrorist)
+		cur->team = RoomTeamNum::CounterTerrorist;
+	// the player list shows name, team and level: send the bot again only when one of them changed. Every
+	// leave + join leaves the client's room player list in a worse state (after many of them, e.g. picking
+	// weapons and characters for each bot, its scoreboard crashed while loading the match)
+	if (was.name == cur->name && was.team == cur->team && was.level == cur->level)
+		return true;
+	for (auto u : m_Users)
+	{
+		g_PacketManager.SendRoomPlayerLeave(u->GetExtendedSocket(), cur->id);
+		SendBotTo(u, *cur, m_pHostUser ? m_pHostUser : u);
+	}
+	return true;
+}
+
+bool CRoom::MoveBot(int id, int newIndex)
+{
+	for (size_t i = 0; i < m_Bots.size(); i++)
+	{
+		if (m_Bots[i].id != id)
+			continue;
+		RoomBot bot = m_Bots[i];
+		m_Bots.erase(m_Bots.begin() + i);
+		if (newIndex < 0)
+			newIndex = 0;
+		if (newIndex > (int)m_Bots.size())
+			newIndex = (int)m_Bots.size();
+		m_Bots.insert(m_Bots.begin() + newIndex, bot);
+		// the list keeps the join order: send every bot again in the new order
+		for (auto u : m_Users)
+		{
+			for (auto& b : m_Bots)
+				g_PacketManager.SendRoomPlayerLeave(u->GetExtendedSocket(), b.id);
+			SendBots(u);
+		}
+		return true;
+	}
+	return false;
+}
+
+// the match starts: the game adds as many bots per team as the room has AI players
+void CRoom::ApplyBotsToSettings()
+{
+	int hostTeam = m_pHostUser ? GetUserTeam(m_pHostUser) : RoomTeamNum::CounterTerrorist;
+	if (hostTeam != RoomTeamNum::Terrorist && hostTeam != RoomTeamNum::CounterTerrorist)
+		hostTeam = RoomTeamNum::CounterTerrorist;
+	g_LastMatchBots = m_Bots;
+	g_LastMatchMode = m_pSettings->gameModeId;
+	g_LastMatchHostTeam = hostTeam;
+	g_LastMatchHostID = m_pHostUser ? m_pHostUser->GetID() : 0;
+	if (m_Bots.empty())
+		return;
+
+	int friendly = 0, enemy = 0;
+	for (auto& b : m_Bots)
+		(b.team == hostTeam ? friendly : enemy)++;
+	m_pSettings->lowMidFlag |= ROOM_LOWMID_BOT;
+	m_pSettings->friendlyBots = friendly;
+	m_pSettings->enemyBots = enemy;
+	m_pSettings->botAdd = 1;
+	m_pSettings->botBalance = 0; // only the room's AI players: no automatic filling / balancing
+	for (auto u : m_Users)
+	{
+		g_PacketManager.SendRoomUpdateSettings(u->GetExtendedSocket(), m_pSettings, 0, ROOM_LOWMID_BOT);
+		// the AI players leave the list while the match runs (the game's bots play them); back after it
+		for (auto& b : m_Bots)
+			g_PacketManager.SendRoomPlayerLeave(u->GetExtendedSocket(), b.id);
+	}
+	Logger().Info("Room %d: match with %d AI players (%d friendly, %d enemy)\n", m_nID, (int)m_Bots.size(), friendly, enemy);
+}
+
+// room chat, host only: /addbot [name] [t|ct], /removebot <name>|all, /bots
+bool CRoom::OnBotCommand(IUser* user, const string& message)
+{
+	if (user != m_pHostUser || message.empty() || message[0] != '/')
+		return false;
+
+	istringstream iss(message);
+	vector<string> args((istream_iterator<string>(iss)), istream_iterator<string>());
+	if (args.empty())
+		return false;
+
+	if (args[0] == "/addbot")
+	{
+		RoomBot bot;
+		for (size_t i = 1; i < args.size(); i++)
+		{
+			if (args[i] == "t" || args[i] == "T")
+				bot.team = RoomTeamNum::Terrorist;
+			else if (args[i] == "ct" || args[i] == "CT")
+				bot.team = RoomTeamNum::CounterTerrorist;
+			else
+				bot.name = args[i];
+		}
+		if (!(args.size() > 1 && (args.back() == "t" || args.back() == "T" || args.back() == "ct" || args.back() == "CT")))
+			bot.team = 0; // host's team
+		if (!AddBot(bot))
+			g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), "The room is full.");
+		return true;
+	}
+	if (args[0] == "/removebot")
+	{
+		if (args.size() < 2 || args[1] == "all")
+		{
+			while (!m_Bots.empty())
+				RemoveBot(m_Bots.back().id);
+			return true;
+		}
+		for (auto& b : m_Bots)
+			if (b.name == args[1])
+			{
+				RemoveBot(b.id);
+				return true;
+			}
+		g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), "No AI player with that name.");
+		return true;
+	}
+	if (args[0] == "/bots")
+	{
+		string list = "AI players:";
+		for (auto& b : m_Bots)
+			list += " " + b.name + (b.team == RoomTeamNum::Terrorist ? "(T)" : "(CT)");
+		g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), m_Bots.empty() ? "No AI players. /addbot [name] [t|ct]" : list);
+		return true;
+	}
+	return false;
 }
 
