+vector<RemoteRoom_s> ServerTransfer::LoadRemoteRooms()
+{
+	vector<RemoteRoom_s> list;
+	ifstream f("Data/RemoteRooms.json");
+	if (!f.is_open())
+		return list;
+	try
+	{
+		json j = json::parse(f, nullptr, true, true);
+		for (auto& r : j.value("rooms", json::array()))
+		{
+			RemoteRoom_s room;
+			room.vid = r.value("vid", 0);
+			room.rid = r.value("rid", 0);
+			room.port = r.value("port", 0);
+			room.host = r.value("host", string());
+		room.hostID = r.value("hostID", string());
+			room.entry = FromHex(r.value("entry", string()));
+			// the client's patch only lets ports 30002-30199 through; an entry starts with a byte and the u32 room id
+			if (room.vid < REMOTE_ROOM_FIRST_ID || room.vid > 65000 || room.port < 30003 || room.port > 30199 || room.entry.size() < 16)
+				continue;
+			list.push_back(room);
+		}
+	}
+	catch (exception& e)
+	{
+		Logger().Warn("Data/RemoteRooms.json: %s\n", e.what());
+	}
+	return list;
+}
+
+bool ServerTransfer::FindRemoteRoom(int vid, RemoteRoom_s& room)
+{
+	for (auto& r : LoadRemoteRooms())
+		if (r.vid == vid)
+		{
+			room = r;
+			return true;
+		}
+	return false;
+}
+
+void ServerTransfer::WriteRemoteRooms(CSendPacket* msg, const vector<RemoteRoom_s>& rooms, int count)
+{
+	for (int i = 0; i < count && i < (int)rooms.size(); i++)
+	{
+		vector<unsigned char> entry = rooms[i].entry;
+		entry[1] = rooms[i].vid & 0xff;
+		entry[2] = (rooms[i].vid >> 8) & 0xff;
+		entry[3] = 0;
+		entry[4] = 0;
+		msg->WriteArray(entry);
+	}
+}
