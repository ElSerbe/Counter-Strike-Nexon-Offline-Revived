+// offline build: weapon filters for the room's AI players, per account (Data/BotPresets.json)
+json& CWarbondManager::BotPresets(int userID)
+{
+	if (!m_BotPresetsLoaded)
+	{
+		m_BotPresetsLoaded = true;
+		ifstream f("Data/BotPresets.json");
+		m_BotPresets = json::parse(f, nullptr, false);
