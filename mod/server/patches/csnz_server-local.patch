diff --git a/src/manager/studio.cpp b/src/manager/studio.cpp
new file mode 100644
index 0000000..e5b85e1
--- /dev/null
+++ b/src/manager/studio.cpp
@@ -0,0 +1,833 @@
+// Offline Studio: the voxel REST API the game's client (hw.dll VoxelHTTP, cpprestsdk) used to reach on Nexon's
+// servers, now served by our own web server. Maps live in Data/Studio:
+//   slots.json            every slot (map) with its details
+//   resources/<id>.vxl    the map files the editor uploads (VxlURL .../resources_prod/%s.vxl)
+//   images/<id>.vmg       their preview images (VmgURL .../images_prod/%s.vmg)
+//   http.log              every request, for reverse engineering the parts still unknown
+// Answers are {"succeed": true, "result": ...}, the shape hw.dll's parsers check first.
+#include "voxelmanager.h"
+#include "packetmanager.h"
+#include "usermanager.h"
+#include "common/logger.h"
+#include "common/utils.h"
+
+#include <fstream>
+#include <sstream>
+#include <ctime>
+#include <random>
+#include <direct.h>
+#include <algorithm>
+
+using namespace std;
+using json = nlohmann::json;
+using ordered_json = nlohmann::ordered_json;
+
+static const char* STUDIO_DIR = "Data/Studio";
+
+static bool SafeId(const string& id)
+{
+	if (id.empty() || id.size() > 64)
+		return false;
+	for (char c : id)
+	{
+		if (!isalnum((unsigned char)c) && c != '_' && c != '-')
+			return false;
+	}
+	return true;
+}
+
+static string ReadFile(const string& path)
+{
+	ifstream f(path, ios::binary);
+	if (!f)
+		return "";
+	return string(istreambuf_iterator<char>(f), istreambuf_iterator<char>());
+}
+
+static bool WriteFile(const string& path, const string& data)
+{
+	ofstream f(path, ios::binary | ios::trunc);
+	if (!f)
+		return false;
+	f.write(data.data(), data.size());
+	return (bool)f;
+}
+
+static string UrlDecode(const string& s)
+{
+	string out;
+	for (size_t i = 0; i < s.size(); i++)
+	{
+		if (s[i] == '%' && i + 2 < s.size())
+		{
+			out += (char)strtol(s.substr(i + 1, 2).c_str(), NULL, 16);
+			i += 2;
+		}
+		else if (s[i] == '+')
+			out += ' ';
+		else
+			out += s[i];
+	}
+	return out;
+}
+
+static string QueryValue(const string& query, const string& key)
+{
+	istringstream ss(query);
+	string pair;
+	while (getline(ss, pair, '&'))
+	{
+		size_t eq = pair.find('=');
+		if (eq != string::npos && pair.substr(0, eq) == key)
+			return UrlDecode(pair.substr(eq + 1));
+	}
+	return "";
+}
+
+static WebResponse JsonAnswer(const ordered_json& result, bool succeed = true)
+{
+	WebResponse resp;
+	ordered_json j;
+	j["succeed"] = succeed;
+	j["result"] = result;
+	resp.body = j.dump();
+	return resp;
+}
+
+// the description the client sends back (a copy of a map) starts with the code DescriptionWithCode put there
+static string StripCode(const string& desc)
+{
+	if (desc.rfind("Share code: ", 0) != 0)
+		return desc;
+	size_t sep = desc.find("  -  ");
+	return sep == string::npos ? "" : desc.substr(sep + 5);
+}
+
+void CVoxelManager::LoadStudio()
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	_mkdir(STUDIO_DIR);
+	_mkdir((string(STUDIO_DIR) + "/resources").c_str());
+	_mkdir((string(STUDIO_DIR) + "/images").c_str());
+
+	m_Studio = ordered_json::parse(ReadFile(string(STUDIO_DIR) + "/slots.json"), nullptr, false, true);
+	if (m_Studio.is_discarded() || !m_Studio.is_object())
+		m_Studio = ordered_json::object();
+	if (!m_Studio.contains("slots") || !m_Studio["slots"].is_array())
+		m_Studio["slots"] = ordered_json::array();
+
+	Logger().Info("Studio: %d maps in %s\n", (int)m_Studio["slots"].size(), STUDIO_DIR);
+}
+
+void CVoxelManager::SaveStudio()
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	string path = string(STUDIO_DIR) + "/slots.json";
+	if (!WriteFile(path + ".tmp", m_Studio.dump(1, '\t')))
+	{
+		Logger().Error("Studio: can't write %s\n", path.c_str());
+		return;
+	}
+	remove(path.c_str());
+	rename((path + ".tmp").c_str(), path.c_str());
+}
+
+string CVoxelManager::NewId()
+{
+	// 24 hex digits like the ids Nexon's service gave out (time + random)
+	static mt19937_64 rng((unsigned long long)time(NULL) ^ (unsigned long long)clock() << 32);
+	char buf[32];
+	snprintf(buf, sizeof(buf), "%08x%016llx", (unsigned)time(NULL), (unsigned long long)rng());
+	return buf;
+}
+
+ordered_json* CVoxelManager::FindSlot(const string& id)
+{
+	for (auto& s : m_Studio["slots"])
+	{
+		if (s.value("id", "") == id)
+			return &s;
+	}
+	return NULL;
+}
+
+// The fields hw.dll reads (VoxelOutUIMapInfo / VoxelOutUIMapInfoDetail, all optional): strings title,
+// resource_id, description, image_id, creator_nickname, creator_id, savegroup_id; ints resource_mode,
+// resource_max_player, permission, like_count, play_count, bookmark_count, cube_count, slot_category,
+// notice_type, sandbox_script, is_event, is_removed; arrays history [{creator_nickname, created}] and tags.
+ordered_json CVoxelManager::SlotJson(const ordered_json& s, bool detail)
+{
+	ordered_json j;
+	j["id"] = s.value("id", "");
+	j["title"] = s.value("title", "");
+	j["resource_id"] = s.value("resource_id", "");
+	j["resource_mode"] = s.value("resource_mode", 0);
+	j["resource_max_player"] = s.value("resource_max_player", 16);
+	j["permission"] = s.value("permission", 0);
+	j["image_id"] = s.value("image_id", "");
+	j["creator_nickname"] = s.value("creator_nickname", "");
+	j["like_count"] = s.value("like_count", 0);
+	j["play_count"] = s.value("play_count", 0);
+	j["bookmark_count"] = s.value("bookmark_count", 0);
+	j["cube_count"] = s.value("cube_count", 0);
+	j["slot_category"] = s.value("slot_category", 0);
+	j["notice_type"] = s.value("notice_type", 0);
+	j["sandbox_script"] = s.value("sandbox_script", 0);
+	j["is_event"] = s.value("is_event", 0);
+	if (detail)
+	{
+		j["description"] = DescriptionWithCode(s);
+		j["creator_id"] = s.value("creator_username", "");
+		j["creator_username"] = s.value("creator_username", "");
+		j["savegroup_id"] = s.value("savegroup_id", "");
+		j["history"] = s.contains("history") ? s["history"] : ordered_json::array();
+		j["tags"] = s.contains("tags") ? s["tags"] : ordered_json::array();
+	}
+	else
+	{
+		j["is_removed"] = 0;
+		j["creator_message"] = s.value("creator_message", "");
+	}
+	return j;
+}
+
+// the Studio browser's lists: this PC's published maps, the maps fetched from other players, and (with Online play)
+// every map the other players publish (studionet.cpp), newest first
+ordered_json CVoxelManager::PublishedSlots()
+{
+	vector<const ordered_json*> maps;
+	for (auto& s : m_Studio["slots"])
+	{
+		if (!s.value("deleted", false) && !s.value("resource_id", "").empty() && (s.value("published", false) || s.value("remote", false)))
+			maps.push_back(&s);
+	}
+	vector<ordered_json> online = CatalogMaps();
+	for (auto& m : online)
+	{
+		if (!FindSlot(m.value("id", "")))
+			maps.push_back(&m);
+	}
+	stable_sort(maps.begin(), maps.end(), [](const ordered_json* a, const ordered_json* b) {
+		return a->value("updated", a->value("created", 0LL)) > b->value("updated", b->value("created", 0LL));
+	});
+	ordered_json list = ordered_json::array();
+	for (auto* s : maps)
+		list.push_back(SlotJson(*s, false));
+	return list;
+}
+
+// For CRoomSettings::ParseSlotDetails (room with a Studio map): same JSON as GET /v6/slots/detail/<id>
+string CVoxelManager::StudioDetailJson(const string& rawId)
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	// the room packet's voxel id comes with a 0x02 byte in front of it: keep the printable part
+	string slotId = rawId;
+	while (!slotId.empty() && (unsigned char)slotId[0] < 0x20)
+		slotId.erase(0, 1);
+	ordered_json* s = FindSlot(slotId);
+	if (s && s->value("deleted", false))
+		s = NULL;
+	if (!s)
+	{
+		// a map another player publishes: the room can be made now, the map file comes over Steam while the game loads
+		if (const ordered_json* online = CatalogFind(slotId))
+		{
+			NetRequest(online->value("id", slotId));
+			ordered_json j;
+			j["succeed"] = true;
+			j["result"] = SlotJson(*online, true);
+			return j.dump();
+		}
+		string hex;
+		char h[4];
+		for (unsigned char c : slotId)
+		{
+			snprintf(h, sizeof(h), "%02x", c);
+			hex += h;
+		}
+		Logger().Warn("Studio: room asked for unknown map '%s' (%d bytes: %s), %d maps known\n", slotId.c_str(),
+			(int)slotId.size(), hex.c_str(), (int)m_Studio["slots"].size());
+		return "";
+	}
+	ordered_json j;
+	j["succeed"] = true;
+	j["result"] = SlotJson(*s, true);
+	return j.dump();
+}
+
+void CVoxelManager::LogHttp(const WebRequest& req, const WebResponse& resp)
+{
+	Logger().Info("Studio HTTP %s %s%s%s -> %d (%d bytes in, %d out)\n", req.method.c_str(), req.path.c_str(),
+		req.query.empty() ? "" : "?", req.query.c_str(), resp.status, (int)req.body.size(), (int)resp.body.size());
+
+	ofstream f(string(STUDIO_DIR) + "/http.log", ios::app | ios::binary);
+	if (!f)
+		return;
+	time_t now = time(NULL);
+	char stamp[32];
+	strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S", localtime(&now));
+	f << "==== " << stamp << " " << req.method << " " << req.path << (req.query.empty() ? "" : "?") << req.query
+		<< " -> " << resp.status << "\n" << req.headers;
+	if (!req.body.empty())
+	{
+		// text bodies whole (up to 4 KB), binary ones as the first bytes in hex
+		string head = req.body.substr(0, 4096);
+		bool text = true;
+		for (unsigned char c : head)
+		{
+			if (c < 9 || (c > 13 && c < 32))
+			{
+				text = false;
+				break;
+			}
+		}
+		if (text)
+			f << "body: " << head << "\n";
+		else
+		{
+			f << "body (" << req.body.size() << " bytes, binary): ";
+			// multipart: print the part headers so the field names are visible
+			size_t pos = 0;
+			int parts = 0;
+			while ((pos = req.body.find("Content-Disposition", pos)) != string::npos && parts++ < 8)
+			{
+				size_t end = req.body.find("\r\n\r\n", pos);
+				f << "[" << req.body.substr(pos, min(end, pos + 300) - pos) << "] ";
+				pos = end == string::npos ? req.body.size() : end;
+			}
+			char hex[4];
+			for (size_t i = 0; i < min<size_t>(64, req.body.size()); i++)
+			{
+				snprintf(hex, sizeof(hex), "%02x", (unsigned char)req.body[i]);
+				f << hex;
+			}
+			f << "\n";
+		}
+	}
+	if (resp.contentType.find("json") != string::npos)
+		f << "answer: " << resp.body.substr(0, 2048) << "\n";
+}
+
+// POST /v4/upload/resources/... and /v4/upload/images/...: multipart (boundary "098765voxelboundary567890")
+// or a raw body. The file is kept under a new id, which the answer gives back.
+WebResponse CVoxelManager::StoreUpload(const WebRequest& req, bool image)
+{
+	string data = req.body;
+	size_t b = req.contentType.find("boundary=");
+	if (b != string::npos)
+	{
+		string boundary = "--" + req.contentType.substr(b + 9);
+		if (!boundary.empty() && boundary.back() == '"')
+			boundary.pop_back();
+		if (boundary.size() > 2 && boundary[2] == '"')
+			boundary.erase(2, 1);
+		// the part with a file name, else the first part
+		size_t part = req.body.find("filename=");
+		if (part == string::npos)
+			part = req.body.find(boundary);
+		size_t start = part == string::npos ? string::npos : req.body.find("\r\n\r\n", part);
+		if (start != string::npos)
+		{
+			start += 4;
+			size_t end = req.body.find("\r\n" + boundary, start);
+			data = req.body.substr(start, end == string::npos ? string::npos : end - start);
+		}
+	}
+
+	if (data.empty())
+	{
+		Logger().Warn("Studio: empty %s upload\n", image ? "image" : "map");
+		return JsonAnswer(nullptr, false);
+	}
+
+	// the editor uploads to the location 0x0c gave it (/v4/upload/resources/<location>); keep that name
+	string id = req.path.substr(req.path.find_last_of('/') + 1);
+	if (!SafeId(id) || id == "resources" || id == "images")
+		id = NewId();
+	string path = string(STUDIO_DIR) + (image ? "/images/" + id + ".vmg" : "/resources/" + id + ".vxl");
+	if (!WriteFile(path, data))
+	{
+		Logger().Error("Studio: can't write %s\n", path.c_str());
+		return JsonAnswer(nullptr, false);
+	}
+	Logger().Info("Studio: stored %s %s (%d bytes)\n", image ? "image" : "map", id.c_str(), (int)data.size());
+
+	ordered_json result;
+	result["id"] = id;
+	result[image ? "image_id" : "resource_id"] = id;
+	result["location"] = id;
+	result["size"] = (int)data.size();
+	return JsonAnswer(result);
+}
+
+WebResponse CVoxelManager::OnHttp(const WebRequest& req)
+{
+	// the Steam bridge's own calls (studionet.cpp)
+	if (req.path.rfind("/studio/net/", 0) == 0)
+		return OnNetHttp(req);
+
+	unique_lock<recursive_mutex> lock(m_StudioMutex);
+	WebResponse resp;
+	const string& p = req.path;
+
+	auto after = [&](const string& prefix) { return p.substr(prefix.size()); };
+
+	// Data/Studio/overrides.json {"<path>": <answer JSON>}: read on every request, so answers can be tried
+	// without restarting (reverse engineering aid; the file normally doesn't exist)
+	ordered_json overrides = ordered_json::parse(ReadFile(string(STUDIO_DIR) + "/overrides.json"), nullptr, false, true);
+	if (!overrides.is_discarded() && overrides.is_object() && overrides.contains(p))
+	{
+		resp.body = overrides[p].dump();
+		LogHttp(req, resp);
+		return resp;
+	}
+
+	if (p.rfind("/resources_prod/", 0) == 0 || p.rfind("/images_prod/", 0) == 0)
+	{
+		bool image = p.rfind("/images_prod/", 0) == 0;
+		string file = after(image ? "/images_prod/" : "/resources_prod/");
+		string id = file.substr(0, file.find('.'));
+		resp.contentType = "application/octet-stream";
+		if (SafeId(id))
+			resp.body = ReadFile(string(STUDIO_DIR) + (image ? "/images/" : "/resources/") + id + (image ? ".vmg" : ".vxl"));
+		// a map this PC doesn't have (a room on another player's server, a map from the online list): it comes from the
+		// PCs that have it, over Steam, while the game waits for this answer
+		if (resp.body.empty() && !image && SafeId(id) && id.rfind("tmpl_", 0) != 0)
+		{
+			int request = NetRequest(id);
+			if (request)
+			{
+				lock.unlock();
+				Logger().Info("Studio: the game wants map file %s, which isn't on this PC: fetching it\n", id.c_str());
+				bool got = NetWait(request, 25000);
+				lock.lock();
+				if (got)
+					resp.body = ReadFile(string(STUDIO_DIR) + "/resources/" + id + ".vxl");
+			}
+		}
+		// still missing: the game aborts on a 404, so it gets the flat sample map instead
+		if (resp.body.empty() && !image)
+		{
+			resp.body = ReadFile(string(STUDIO_DIR) + "/resources/tmpl_flat.vxl");
+			if (!resp.body.empty())
+				Logger().Warn("Studio: map %s isn't on this PC, sending the flat sample map instead\n", file.c_str());
+		}
+		if (resp.body.empty())
+		{
+			resp.status = 404;
+			Logger().Warn("Studio: %s %s not found\n", image ? "image" : "map", file.c_str());
+		}
+	}
+	else if (p.rfind("/v4/upload/resources", 0) == 0)
+	{
+		resp = StoreUpload(req, false);
+	}
+	else if (p.rfind("/v4/upload/images", 0) == 0)
+	{
+		resp = StoreUpload(req, true);
+	}
+	else if (p == "/v6/slots/list/all")
+	{
+		// home page of the Studio browser: every section must be there ("Key not found" otherwise)
+		ordered_json published = PublishedSlots();
+		ordered_json result;
+		for (const char* key : { "dev_team", "best_creator", "single_play", "published", "events", "promotion",
+			"soar_popular", "popular_rank", "liked", "notable" })
+		{
+			result[key] = ordered_json::array();
+		}
+		result["published"] = published;
+		result["popular_rank"] = published;
+		resp = JsonAnswer(result);
+	}
+	else if (p.rfind("/v6/slots/detail/", 0) == 0 || p.rfind("/v5/slots/newbie/", 0) == 0 ||
+		p.rfind("/v5/slots/lobby_menu_ex/", 0) == 0)
+	{
+		string id = p.substr(p.find_last_of('/') + 1);
+		ordered_json* s = FindSlot(id);
+		const ordered_json* online = s ? NULL : CatalogFind(id);
+		resp = s ? JsonAnswer(SlotJson(*s, true)) : online ? JsonAnswer(SlotJson(*online, true)) : JsonAnswer(nullptr, false);
+	}
+	else if (p == "/v5/slots/simple")
+	{
+		ordered_json list = ordered_json::array();
+		istringstream ids(QueryValue(req.query, "ids"));
+		string id;
+		while (getline(ids, id, ','))
+		{
+			if (ordered_json* s = FindSlot(id))
+				list.push_back(SlotJson(*s, false));
+			else if (const ordered_json* online = CatalogFind(id))
+				list.push_back(SlotJson(*online, false));
+		}
+		resp = JsonAnswer(list);
+	}
+	else if (p.rfind("/v5/slots/list/nick/", 0) == 0)
+	{
+		string nick = UrlDecode(after("/v5/slots/list/nick/"));
+		ordered_json list = ordered_json::array();
+		for (auto& s : PublishedSlots())
+		{
+			if (s.value("creator_nickname", "") == nick)
+				list.push_back(s);
+		}
+		resp = JsonAnswer(list);
+	}
+	else if (p == "/v6/slots/list/search")
+	{
+		// hw sends "q" (the search box) and "tag": a share code finds its map even when it isn't on any list (a map
+		// shared by code only: the other PCs are asked for it), else the text is looked for in titles and authors
+		string text = QueryValue(req.query, "q");
+		if (text.empty())
+			text = QueryValue(req.query, "keyword");
+		string code = NormalizeCode(text);
+		auto lower = [](string t) { transform(t.begin(), t.end(), t.begin(), ::tolower); return t; };
+		string needle = lower(text);
+		ordered_json list = ordered_json::array();
+		if (!code.empty())
+		{
+			ordered_json* s = FindSlotByKey(code);
+			const ordered_json* online = s ? NULL : CatalogFind(code);
+			if (!s && !online)
+			{
+				int request = NetRequest(code);
+				if (request)
+				{
+					lock.unlock();
+					bool got = NetWait(request, 12000);
+					lock.lock();
+					if (got)
+						s = FindSlotByKey(code);
+				}
+			}
+			if (s)
+				list.push_back(SlotJson(*s, false));
+			else if ((online = CatalogFind(code)) != NULL)
+				list.push_back(SlotJson(*online, false));
+		}
+		if (list.empty())
+		{
+			for (auto& s : PublishedSlots())
+			{
+				if (needle.empty() || lower(s.value("title", "")).find(needle) != string::npos ||
+					lower(s.value("creator_nickname", "")).find(needle) != string::npos || s.value("id", "") == text)
+					list.push_back(s);
+			}
+		}
+		resp = JsonAnswer(list);
+	}
+	else if (p == "/v5/slots/list/template")
+	{
+		// sample maps offered by "Create a new studio map": Data/Studio/templates.json {"templates":[slot...]}
+		ordered_json t = ordered_json::parse(ReadFile(string(STUDIO_DIR) + "/templates.json"), nullptr, false, true);
+		ordered_json list = ordered_json::array();
+		if (!t.is_discarded() && t.contains("templates"))
+		{
+			for (auto& s : t["templates"])
+				list.push_back(SlotJson(s, false));
+		}
+		resp = JsonAnswer(list);
+	}
+	else if (p.rfind("/v6/slots/list/", 0) == 0 || p.rfind("/v5/slots/list/", 0) == 0)
+	{
+		resp = JsonAnswer(PublishedSlots());
+	}
+	else if (p == "/v6/slots/notification/count")
+	{
+		resp = JsonAnswer(0);
+	}
+	else
+	{
+		// unknown yet: a success with an empty list keeps the client going; http.log shows what it wanted
+		resp = JsonAnswer(ordered_json::array());
+	}
+
+	LogHttp(req, resp);
+	return resp;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// TCP (packet 103, hw Packet_VoxelOutUI parser 0x211c340). Slot info = u32 flags + the fields below in bit order
+// (hw reader 0x211eb60; strings are NUL-terminated). Bits 0x400 and 0x4000 are never sent by us.
+enum SlotFieldKind { SF_STR, SF_U8, SF_U32 };
+struct SlotField { unsigned bit; const char* key; SlotFieldKind kind; };
+static const SlotField SLOT_FIELDS[] = {
+	{ 0x1, "id", SF_STR }, { 0x2, "resource_id", SF_STR }, { 0x4, "resource_max_player", SF_U8 },
+	{ 0x8, "title", SF_STR }, { 0x10, "resource_mode", SF_U8 }, { 0x20, "permission", SF_U8 },
+	{ 0x40, "description", SF_STR }, { 0x80, "parent_id", SF_STR }, { 0x100, "image_id", SF_STR },
+	{ 0x200, "creator_nickname", SF_STR }, { 0x400, "creator_username", SF_STR }, { 0x800, "like_count", SF_U32 },
+	{ 0x1000, "play_count", SF_U32 }, { 0x2000, "bookmark_count", SF_U32 }, { 0x4000, "", SF_U32 },
+	{ 0x8000, "cube_count", SF_U32 }, { 0x10000, "unk17", SF_U32 }, { 0x20000, "unk18", SF_U32 },
+	{ 0x80000, "slot_category", SF_U8 }, { 0x200000, "sandbox_script", SF_U8 }, { 0x400000, "savegroup_id", SF_STR },
+	{ 0x800000, "unk22", SF_U8 }, { 0x1000000, "unk23", SF_U8 }, { 0x2000000, "server_id", SF_U8 },
+};
+
+ordered_json CVoxelManager::ReadSlotInfo(CReceivePacket* msg)
+{
+	ordered_json slot = ordered_json::object();
+	unsigned flags = msg->ReadUInt32();
+	slot["_flags"] = flags;
+	for (const SlotField& f : SLOT_FIELDS)
+	{
+		if (!(flags & f.bit))
+			continue;
+		if (f.bit == 0x4000)
+		{
+			// list of (u32, string): read and dropped
+			unsigned n = msg->ReadUInt32();
+			for (unsigned i = 0; i < n && i < 1000; i++)
+			{
+				msg->ReadUInt32();
+				msg->ReadString();
+			}
+			continue;
+		}
+		if (f.kind == SF_STR)
+			slot[f.key] = msg->ReadString();
+		else if (f.kind == SF_U8)
+			slot[f.key] = msg->ReadUInt8();
+		else
+			slot[f.key] = msg->ReadUInt32();
+	}
+	return slot;
+}
+
+void CVoxelManager::WriteSlotInfo(CSendPacket* msg, const ordered_json& slot)
+{
+	unsigned flags = 0;
+	for (const SlotField& f : SLOT_FIELDS)
+	{
+		if (f.bit != 0x4000 && slot.contains(f.key))
+			flags |= f.bit;
+	}
+	msg->WriteUInt32(flags);
+	for (const SlotField& f : SLOT_FIELDS)
+	{
+		if (!(flags & f.bit))
+			continue;
+		const ordered_json& v = slot[f.key];
+		if (f.kind == SF_STR)
+			msg->WriteString(v.is_string() ? v.get<string>() : "");
+		else if (f.kind == SF_U8)
+			msg->WriteUInt8(v.is_number() ? v.get<int>() : 0);
+		else
+			msg->WriteUInt32(v.is_number() ? v.get<unsigned>() : 0);
+	}
+}
+
+// the fields a slot always carries towards the client
+static ordered_json ClientSlot(const ordered_json& s)
+{
+	ordered_json c;
+	c["id"] = s.value("id", "");
+	c["resource_id"] = s.value("resource_id", "");
+	c["resource_max_player"] = s.value("resource_max_player", 16);
+	c["title"] = s.value("title", "");
+	c["resource_mode"] = s.value("resource_mode", 0);
+	c["permission"] = s.value("permission", 0);
+	c["description"] = CVoxelManager::DescriptionWithCode(s);
+	if (!s.value("parent_id", "").empty())
+		c["parent_id"] = s.value("parent_id", "");
+	c["image_id"] = s.value("image_id", "");
+	c["creator_nickname"] = s.value("creator_nickname", "");
+	// hw keeps it at slot +0xc8; GameUI shows the map's buttons only when it equals the local login name
+	c["creator_username"] = s.value("creator_username", "");
+	c["like_count"] = s.value("like_count", 0);
+	c["play_count"] = s.value("play_count", 0);
+	c["bookmark_count"] = s.value("bookmark_count", 0);
+	c["cube_count"] = s.value("cube_count", 0);
+	c["slot_category"] = s.value("slot_category", 0);
+	c["sandbox_script"] = s.value("sandbox_script", 0);
+	c["server_id"] = 0;
+	return c;
+}
+
+void CVoxelManager::SendSlotList(IExtendedSocket* socket, int userID)
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	vector<const ordered_json*> mine;
+	for (auto& s : m_Studio["slots"])
+	{
+		if (s.value("owner", 0) == userID && !s.value("deleted", false))
+			mine.push_back(&s);
+	}
+
+	// type 9: u8 total, u8 in this packet, slots (hw collects packets until it has "total")
+	CSendPacket* msg = g_PacketManager.CreatePacket(socket, PacketId::Voxel);
+	msg->BuildHeader();
+	msg->WriteUInt8(9);
+	msg->WriteUInt8((unsigned char)mine.size());
+	msg->WriteUInt8((unsigned char)mine.size());
+	for (auto* s : mine)
+		WriteSlotInfo(msg, ClientSlot(*s));
+	socket->Send(msg);
+}
+
+bool CVoxelManager::OnStudioPacket(int type, CReceivePacket* msg, IExtendedSocket* socket)
+{
+	IUser* user = g_UserManager.GetUserBySocket(socket);
+	if (!user)
+		return false;
+
+	switch (type)
+	{
+	case 0:
+	{
+		// new slot from a sample map (or a copy of one of the player's maps): id = the source, title, description
+		ordered_json req = ReadSlotInfo(msg);
+		lock_guard<recursive_mutex> lock(m_StudioMutex);
+
+		int count = 0;
+		for (auto& s : m_Studio["slots"])
+		{
+			if (s.value("owner", 0) == user->GetID() && !s.value("deleted", false))
+				count++;
+		}
+
+		CSendPacket* reply = g_PacketManager.CreatePacket(socket, PacketId::Voxel);
+		reply->BuildHeader();
+		reply->WriteUInt8(0);
+		if (count >= STUDIO_MAX_SLOTS)
+		{
+			reply->WriteUInt8(1); // failure
+			socket->Send(reply);
+			return true;
+		}
+
+		string source = req.value("id", "");
+		ordered_json slot;
+		slot["id"] = NewId();
+		slot["owner"] = user->GetID();
+		slot["title"] = req.value("title", "New map");
+		slot["description"] = StripCode(req.value("description", ""));
+		slot["parent_id"] = source;
+		slot["creator_nickname"] = user->GetCharacter(UFLAG_LOW_GAMENAME).gameName;
+		slot["creator_username"] = user->GetUsername();
+		slot["resource_max_player"] = 16;
+		slot["resource_mode"] = 0;
+		slot["permission"] = 0;
+		slot["created"] = (long long)time(NULL);
+		slot["published"] = false;
+
+		// copy the source's map file, so editing the new slot never changes the original
+		string sourceResource = req.value("resource_id", "");
+		ordered_json t = ordered_json::parse(ReadFile(string(STUDIO_DIR) + "/templates.json"), nullptr, false, true);
+		if (!t.is_discarded() && t.contains("templates"))
+		{
+			for (auto& tm : t["templates"])
+			{
+				if (tm.value("id", "") == source)
+				{
+					sourceResource = tm.value("resource_id", "");
+					slot["resource_max_player"] = tm.value("resource_max_player", 16);
+					slot["resource_mode"] = tm.value("resource_mode", 0);
+				}
+			}
+		}
+		if (ordered_json* src = FindSlot(source))
+		{
+			sourceResource = src->value("resource_id", "");
+			slot["resource_max_player"] = src->value("resource_max_player", 16);
+			slot["resource_mode"] = src->value("resource_mode", 0);
+		}
+		slot["resource_id"] = "";
+		if (SafeId(sourceResource))
+		{
+			string data = ReadFile(string(STUDIO_DIR) + "/resources/" + sourceResource + ".vxl");
+			if (!data.empty())
+			{
+				string rid = NewId();
+				WriteFile(string(STUDIO_DIR) + "/resources/" + rid + ".vxl", data);
+				slot["resource_id"] = rid;
+			}
+		}
+
+		m_Studio["slots"].push_back(slot);
+		SaveStudio();
+		Logger().Info("Studio: %s created map %s '%s' from %s\n", user->GetUsername().c_str(), slot["id"].get<string>().c_str(),
+			slot["title"].get<string>().c_str(), source.c_str());
+
+		reply->WriteUInt8(0); // ok
+		WriteSlotInfo(reply, ClientSlot(slot));
+		socket->Send(reply);
+		return true;
+	}
+	case 9:
+		SendSlotList(socket, user->GetID());
+		return true;
+	case 0x0c:
+	{
+		// save from the editor: string slot id, u32 size -> u8 status, string upload location
+		// (the client then POSTs the map to /v4/upload/resources/<location> and sends 0x0d)
+		string slotId = msg->ReadString();
+		unsigned size = msg->ReadUInt32();
+		lock_guard<recursive_mutex> lock(m_StudioMutex);
+		ordered_json* s = FindSlot(slotId);
+		CSendPacket* reply = g_PacketManager.CreatePacket(socket, PacketId::Voxel);
+		reply->BuildHeader();
+		reply->WriteUInt8(0x0c);
+		if (!s || s->value("owner", 0) != user->GetID())
+		{
+			Logger().Warn("Studio: %s can't save map %s (not theirs)\n", user->GetUsername().c_str(), slotId.c_str());
+			reply->WriteUInt8(1);
+			socket->Send(reply);
+			return true;
+		}
+		string location = NewId();
+		m_PendingUploads[location] = slotId;
+		Logger().Info("Studio: %s saves map %s (%u bytes) -> %s\n", user->GetUsername().c_str(), slotId.c_str(), size, location.c_str());
+		reply->WriteUInt8(0);
+		reply->WriteString(location);
+		socket->Send(reply);
+		return true;
+	}
+	case 0x0d:
+	{
+		// upload finished: string location -> u8 status, slot info
+		string location = msg->ReadString();
+		lock_guard<recursive_mutex> lock(m_StudioMutex);
+		CSendPacket* reply = g_PacketManager.CreatePacket(socket, PacketId::Voxel);
+		reply->BuildHeader();
+		reply->WriteUInt8(0x0d);
+		auto it = m_PendingUploads.find(location);
+		ordered_json* s = it == m_PendingUploads.end() ? NULL : FindSlot(it->second);
+		bool stored = SafeId(location) && !ReadFile(string(STUDIO_DIR) + "/resources/" + location + ".vxl").empty();
+		if (!s || !stored)
+		{
+			Logger().Warn("Studio: upload %s finished but %s\n", location.c_str(), s ? "no file arrived" : "no map waits for it");
+			reply->WriteUInt8(1);
+			socket->Send(reply);
+			return true;
+		}
+		string old = s->value("resource_id", "");
+		(*s)["resource_id"] = location;
+		(*s)["updated"] = (long long)time(NULL);
+		m_PendingUploads.erase(it);
+		SaveStudio();
+		if (SafeId(old) && old.rfind("tmpl_", 0) != 0)
+			remove((string(STUDIO_DIR) + "/resources/" + old + ".vxl").c_str());
+		Logger().Info("Studio: map %s saved (resource %s)\n", s->value("id", "").c_str(), location.c_str());
+		g_PacketManager.SendUMsgNoticeMessageInChat(socket, "Map saved. Share code: " + ShareCode(s->value("id", "")) +
+			(s->value("published", false) ? " (it's in the online list: other players get the new version)" :
+			" - other players type it in the Studio search. Shop > Studio maps publishes it for everyone online."));
+		reply->WriteUInt8(0);
+		WriteSlotInfo(reply, ClientSlot(*s));
+		socket->Send(reply);
+		return true;
+	}
+	case 0x31:
+	{
+		// asked when a map is selected: u8 status, string slot id, u16 n + n strings (its tags; none offline)
+		string id = msg->ReadString();
+		CSendPacket* reply = g_PacketManager.CreatePacket(socket, PacketId::Voxel);
+		reply->BuildHeader();
+		reply->WriteUInt8(0x31);
+		reply->WriteUInt8(0);
+		reply->WriteString(id);
+		reply->WriteUInt16(0);
+		socket->Send(reply);
+		return true;
+	}
+	}
+	return false;
+}
diff --git a/src/manager/studionet.cpp b/src/manager/studionet.cpp
new file mode 100644
index 0000000..62948ed
--- /dev/null
+++ b/src/manager/studionet.cpp
@@ -0,0 +1,796 @@
+// Studio maps between PCs: share codes, the online catalog and maps sent over Steam.
+//
+// Share code: 8 letters/digits made from the map's slot id (ShareCode), so every PC finds the same map for the same code
+// without asking anyone. The game shows it at the start of the map's description; its Studio browser's search takes it.
+//
+// Online catalog: the Steam bridge (mod/tools/steambridge) puts this PC's published maps in its Spacewar lobby
+// (GET /studio/net/catalog) and writes the maps of every other lobby to Data/StudioNet.json. Those maps show up in the
+// game's Studio browser next to this PC's own, and in the Studio maps page (/maps/, MapsApi).
+//
+// Fetching: a map this PC doesn't have (picked in the browser, a code typed in, a room on another player's server whose
+// map the game asks this PC's server for) becomes a request the bridge takes from GET /studio/net/outbox. It asks the
+// PCs that have the map for it (GET /studio/net/export on theirs) and posts what comes back to /studio/net/result; the
+// map is kept in Data/Studio like this PC's own (a slot with "remote": true, owned by nobody here).
+// None of this runs without the bridge: offline play stays as it was.
+#include "voxelmanager.h"
+#include "usermanager.h"
+#include "common/logger.h"
+#include "interface/iuser.h"
+#include "definitions.h"
+#include "command.h"
+
+#include <fstream>
+#include <sstream>
+#include <ctime>
+#include <condition_variable>
+#include <thread>
+#include <sys/stat.h>
+
+using namespace std;
+using json = nlohmann::json;
+using ordered_json = nlohmann::ordered_json;
+
+static const char* STUDIO_DIR = "Data/Studio";
+static const char* CATALOG_FILE = "Data/StudioNet.json";
+static const int MAX_PUBLISHED = 60; // maps one PC puts in its lobby
+static const int REQUEST_SECONDS = 75; // a request nobody answered in this time has failed
+
+static bool SafeId(const string& id)
+{
+	if (id.empty() || id.size() > 64)
+		return false;
+	for (char c : id)
+		if (!isalnum((unsigned char)c) && c != '_' && c != '-')
+			return false;
+	return true;
+}
+
+static string ReadFile(const string& path)
+{
+	ifstream f(path, ios::binary);
+	if (!f)
+		return "";
+	return string(istreambuf_iterator<char>(f), istreambuf_iterator<char>());
+}
+
+static bool WriteFile(const string& path, const string& data)
+{
+	ofstream f(path + ".tmp", ios::binary | ios::trunc);
+	if (!f)
+		return false;
+	f.write(data.data(), data.size());
+	f.close();
+	if (!f)
+		return false;
+	remove(path.c_str());
+	return rename((path + ".tmp").c_str(), path.c_str()) == 0;
+}
+
+static string QueryValue(const string& query, const string& key)
+{
+	istringstream ss(query);
+	string pair;
+	while (getline(ss, pair, '&'))
+	{
+		size_t eq = pair.find('=');
+		if (eq == string::npos || pair.substr(0, eq) != key)
+			continue;
+		string v = pair.substr(eq + 1), out;
+		for (size_t i = 0; i < v.size(); i++)
+		{
+			if (v[i] == '%' && i + 2 < v.size())
+			{
+				out += (char)strtol(v.substr(i + 1, 2).c_str(), NULL, 16);
+				i += 2;
+			}
+			else
+				out += v[i] == '+' ? ' ' : v[i];
+		}
+		return out;
+	}
+	return "";
+}
+
+// ordered_json (the Studio's own files keep their key order) -> json (the web API's answers)
+static json Plain(const ordered_json& o)
+{
+	return json::parse(o.dump(-1, ' ', false, json::error_handler_t::replace));
+}
+
+static const char B64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static string Base64Encode(const string& in)
+{
+	string out;
+	out.reserve((in.size() + 2) / 3 * 4);
+	size_t i = 0;
+	for (; i + 2 < in.size(); i += 3)
+	{
+		unsigned v = (unsigned char)in[i] << 16 | (unsigned char)in[i + 1] << 8 | (unsigned char)in[i + 2];
+		out += B64[v >> 18];
+		out += B64[(v >> 12) & 63];
+		out += B64[(v >> 6) & 63];
+		out += B64[v & 63];
+	}
+	if (i < in.size())
+	{
+		unsigned v = (unsigned char)in[i] << 16 | (i + 1 < in.size() ? (unsigned char)in[i + 1] << 8 : 0);
+		out += B64[v >> 18];
+		out += B64[(v >> 12) & 63];
+		out += i + 1 < in.size() ? B64[(v >> 6) & 63] : '=';
+		out += '=';
+	}
+	return out;
+}
+
+static bool Base64Decode(const string& in, string& out)
+{
+	static int table[256];
+	static bool ready = false;
+	if (!ready)
+	{
+		for (int& t : table)
+			t = -1;
+		for (int i = 0; i < 64; i++)
+			table[(unsigned char)B64[i]] = i;
+		ready = true;
+	}
+	out.clear();
+	out.reserve(in.size() / 4 * 3);
+	unsigned v = 0;
+	int bits = 0;
+	for (unsigned char c : in)
+	{
+		if (c == '=' || c == '\r' || c == '\n')
+			continue;
+		if (table[c] < 0)
+			return false;
+		v = v << 6 | table[c];
+		bits += 6;
+		if (bits >= 8)
+		{
+			bits -= 8;
+			out += (char)((v >> bits) & 0xff);
+		}
+	}
+	return true;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// share codes: Crockford's base32 (no I, L, O, U), 40 bits of a hash of the slot id
+static const char CODE_CHARS[] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+
+string CVoxelManager::ShareCode(const string& slotId)
+{
+	unsigned long long h = 1469598103934665603ULL;
+	for (char c : "csnz-studio:" + slotId)
+	{
+		h ^= (unsigned char)c;
+		h *= 1099511628211ULL;
+	}
+	// splitmix64's finish: every character of the id changes every letter of the code
+	h ^= h >> 30;
+	h *= 0xbf58476d1ce4e5b9ULL;
+	h ^= h >> 27;
+	h *= 0x94d049bb133111ebULL;
+	h ^= h >> 31;
+	string code;
+	for (int i = 0; i < 8; i++)
+	{
+		code += CODE_CHARS[h & 31];
+		h >>= 5;
+		if (i == 3)
+			code += '-';
+	}
+	return code;
+}
+
+string CVoxelManager::NormalizeCode(const string& text)
+{
+	string code;
+	for (char ch : text)
+	{
+		char c = (char)toupper((unsigned char)ch);
+		if (c == '-' || c == ' ' || c == '_')
+			continue;
+		if (c == 'O')
+			c = '0';
+		else if (c == 'I' || c == 'L')
+			c = '1';
+		else if (c == 'U')
+			c = 'V';
+		if (!strchr(CODE_CHARS, c) || c == 0)
+			return "";
+		code += c;
+	}
+	if (code.size() != 8)
+		return "";
+	return code.substr(0, 4) + "-" + code.substr(4);
+}
+
+string CVoxelManager::DescriptionWithCode(const ordered_json& s)
+{
+	string desc = s.value("description", "");
+	size_t a = desc.find_first_not_of(' ');
+	desc = a == string::npos ? "" : desc.substr(a);
+	string id = s.value("id", "");
+	if (id.empty() || id.rfind("tmpl_", 0) == 0)
+		return desc;
+	return "Share code: " + ShareCode(id) + (desc.empty() ? "" : "  -  " + desc);
+}
+
+ordered_json* CVoxelManager::FindSlotByKey(const string& key)
+{
+	string code = NormalizeCode(key);
+	for (auto& s : m_Studio["slots"])
+	{
+		if (s.value("deleted", false) || s.value("resource_id", "").empty())
+			continue;
+		string id = s.value("id", "");
+		if (id == key || s.value("resource_id", "") == key || (!code.empty() && ShareCode(id) == code))
+			return &s;
+	}
+	return NULL;
+}
+
+// what the Studio maps page and the lobbies see of a map
+ordered_json CVoxelManager::MapEntry(const ordered_json& s, bool withSize)
+{
+	ordered_json m;
+	string id = s.value("id", "");
+	m["id"] = id;
+	m["code"] = ShareCode(id);
+	m["resource_id"] = s.value("resource_id", "");
+	m["title"] = s.value("title", "");
+	string desc = s.value("description", "");
+	if (desc.find_first_not_of(' ') == string::npos)
+		desc = "";
+	m["description"] = desc.size() > 160 ? desc.substr(0, 160) : desc;
+	m["creator_nickname"] = s.value("creator_nickname", "");
+	m["resource_mode"] = s.value("resource_mode", 0);
+	m["resource_max_player"] = s.value("resource_max_player", 16);
+	m["updated"] = s.value("updated", s.value("created", 0LL));
+	if (withSize)
+	{
+		struct stat st;
+		string path = string(STUDIO_DIR) + "/resources/" + s.value("resource_id", "") + ".vxl";
+		m["size"] = stat(path.c_str(), &st) == 0 ? (long long)st.st_size : 0LL;
+	}
+	return m;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// the catalog: Data/StudioNet.json {"updated": unix, "hosts": [{"steamID", "name", "maps": [MapEntry...], "have": [code...]}]}
+void CVoxelManager::ReadCatalog()
+{
+	struct stat st;
+	if (stat(CATALOG_FILE, &st) != 0)
+	{
+		m_Catalog = ordered_json::array();
+		m_CatalogTime = 0;
+		m_CatalogStamp = -1;
+		return;
+	}
+	if ((long long)st.st_mtime == m_CatalogStamp)
+		return;
+	ordered_json j = ordered_json::parse(ReadFile(CATALOG_FILE), nullptr, false);
+	if (j.is_discarded() || !j.is_object())
+		return; // being rewritten: the next request reads it
+	m_CatalogStamp = (long long)st.st_mtime;
+	m_CatalogTime = j.value("updated", 0LL);
+	m_Catalog = ordered_json::array();
+	map<string, size_t> seen;
+	for (auto& h : j.value("hosts", ordered_json::array()))
+	{
+		for (auto& m : h.value("maps", ordered_json::array()))
+		{
+			string id = m.value("id", ""), rid = m.value("resource_id", "");
+			if (!SafeId(id) || !SafeId(rid))
+				continue;
+			ordered_json e = m;
+			e["code"] = ShareCode(id);
+			e["owner"] = h.value("steamID", "");
+			e["ownerName"] = h.value("name", "");
+			auto it = seen.find(id);
+			if (it != seen.end())
+			{
+				if (e.value("updated", 0LL) > m_Catalog[it->second].value("updated", 0LL))
+					m_Catalog[it->second] = e;
+				continue;
+			}
+			seen[id] = m_Catalog.size();
+			m_Catalog.push_back(e);
+		}
+	}
+}
+
+bool CVoxelManager::BridgeOnline()
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	ReadCatalog();
+	return m_CatalogTime && llabs((long long)time(NULL) - m_CatalogTime) < 30;
+}
+
+vector<ordered_json> CVoxelManager::CatalogMaps()
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	vector<ordered_json> list;
+	if (!BridgeOnline())
+		return list;
+	for (auto& m : m_Catalog)
+	{
+		// a map this PC has (its own, or fetched before) shows as the local copy
+		ordered_json* local = FindSlot(m.value("id", ""));
+		if (local && !local->value("deleted", false) && !local->value("remote", false))
+			continue;
+		list.push_back(m);
+	}
+	return list;
+}
+
+const ordered_json* CVoxelManager::CatalogFind(const string& key)
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	if (!BridgeOnline())
+		return NULL;
+	string code = NormalizeCode(key);
+	for (auto& m : m_Catalog)
+	{
+		if (m.value("id", "") == key || m.value("resource_id", "") == key || (!code.empty() && m.value("code", "") == code))
+			return &m;
+	}
+	return NULL;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// requests to the other PCs
+struct NetRequest_s
+{
+	string key;
+	string status; // waiting (for the bridge), sent, done, failed
+	string error;
+	string slotId; // done: the map it brought
+	string from; // done: who sent it
+	time_t created = 0, changed = 0;
+};
+static mutex g_NetMutex;
+static condition_variable g_NetCv;
+static map<int, NetRequest_s> g_NetRequests;
+static int g_NextNetRequest = 1;
+
+int CVoxelManager::NetRequest(const string& key)
+{
+	if (key.empty() || !BridgeOnline())
+		return 0;
+	lock_guard<mutex> lock(g_NetMutex);
+	time_t now = time(NULL);
+	for (auto it = g_NetRequests.begin(); it != g_NetRequests.end();)
+	{
+		if ((it->second.status == "done" || it->second.status == "failed") && now - it->second.changed > 600)
+			it = g_NetRequests.erase(it);
+		else
+			++it;
+	}
+	for (auto& r : g_NetRequests)
+		if (r.second.key == key && (r.second.status == "waiting" || r.second.status == "sent"))
+			return r.first;
+	int id = g_NextNetRequest++;
+	NetRequest_s& r = g_NetRequests[id];
+	r.key = key;
+	r.status = "waiting";
+	r.created = r.changed = now;
+	Logger().Info("Studio: asking the other players' PCs for map %s (request %d)\n", key.c_str(), id);
+	return id;
+}
+
+bool CVoxelManager::NetWait(int id, int ms)
+{
+	if (!id)
+		return false;
+	unique_lock<mutex> lock(g_NetMutex);
+	g_NetCv.wait_for(lock, chrono::milliseconds(ms), [id] {
+		auto it = g_NetRequests.find(id);
+		return it == g_NetRequests.end() || it->second.status == "done" || it->second.status == "failed";
+	});
+	auto it = g_NetRequests.find(id);
+	return it != g_NetRequests.end() && it->second.status == "done";
+}
+
+bool CVoxelManager::ImportMap(const ordered_json& in, const string& vxl, const string& from, string& error)
+{
+	lock_guard<recursive_mutex> lock(m_StudioMutex);
+	string id = in.value("id", ""), rid = in.value("resource_id", "");
+	if (!SafeId(id) || !SafeId(rid) || id.rfind("tmpl_", 0) == 0 || rid.rfind("tmpl_", 0) == 0)
+	{
+		error = "bad map id";
+		return false;
+	}
+	if (vxl.size() < 16 || vxl.compare(0, 4, "csov") != 0)
+	{
+		error = "not a Studio map file";
+		return false;
+	}
+	ordered_json* s = FindSlot(id);
+	if (s && !s->value("remote", false) && !s->value("deleted", false))
+		return true; // this PC's own map
+	if (!WriteFile(string(STUDIO_DIR) + "/resources/" + rid + ".vxl", vxl))
+	{
+		error = "can't write the map file";
+		return false;
+	}
+	if (!s)
+	{
+		m_Studio["slots"].push_back(ordered_json::object());
+		s = &m_Studio["slots"].back();
+	}
+	string old = s->value("resource_id", "");
+	(*s)["id"] = id;
+	(*s)["owner"] = 0;
+	(*s)["remote"] = true;
+	(*s)["from"] = from;
+	(*s)["title"] = in.value("title", "Studio map");
+	(*s)["description"] = in.value("description", "");
+	(*s)["creator_nickname"] = in.value("creator_nickname", "");
+	(*s)["creator_username"] = ""; // nobody here can save over it
+	(*s)["resource_id"] = rid;
+	(*s)["resource_mode"] = in.value("resource_mode", 39);
+	(*s)["resource_max_player"] = in.value("resource_max_player", 16);
+	(*s)["permission"] = 0;
+	(*s)["updated"] = in.value("updated", (long long)time(NULL));
+	(*s)["fetched"] = (long long)time(NULL);
+	(*s)["published"] = false;
+	s->erase("deleted");
+	if (!old.empty() && old != rid && SafeId(old) && old.rfind("tmpl_", 0) != 0)
+		remove((string(STUDIO_DIR) + "/resources/" + old + ".vxl").c_str());
+	SaveStudio();
+	Logger().Info("Studio: got map %s '%s' by %s (%d bytes) from %s\n", id.c_str(), (*s)["title"].get<string>().c_str(),
+		(*s)["creator_nickname"].get<string>().c_str(), (int)vxl.size(), from.c_str());
+	return true;
+}
