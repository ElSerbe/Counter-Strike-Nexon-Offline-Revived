+string ServerTransfer::IssueTicket(const string& userName, int seconds)
+{
+	static const char alphabet[] = "abcdefghijklmnopqrstuvwxyz0123456789";
+	static mt19937 rng(random_device{}());
+	uniform_int_distribution<int> any(0, sizeof(alphabet) - 2);
+
+	time_t now = time(NULL);
+	for (auto it = g_Tickets.begin(); it != g_Tickets.end();)
+		it = now > it->second.expires ? g_Tickets.erase(it) : next(it);
+
+	string ticket;
+	for (int i = 0; i < 24; i++)
+		ticket += alphabet[any(rng)];
+	g_Tickets[ticket] = { userName, now + seconds };
+	return ticket;
+}
+
+bool ServerTransfer::TakeTicket(const string& ticket, string& userName)
+{
+	auto it = g_Tickets.find(ticket);
+	if (it == g_Tickets.end() || time(NULL) > it->second.expires)
+		return false;
+	userName = it->second.userName;
+	g_Tickets.erase(it);
+	return true;
+}
+
+void ServerTransfer::RegisterRemote(int userID, const string& steamID, int tunnelPort)
+{
+	int slot = 0;
+	for (bool used = true; used && slot < 64; )
+	{
+		used = false;
+		for (auto& r : g_Remotes)
+			if (r.first != userID && r.second.slot == slot)
+			{
+				used = true;
+				slot++;
+				break;
+			}
+	}
+	g_Remotes[userID] = { steamID, slot, tunnelPort };
+	Logger().Info("Remote player %d (Steam %s): match ports 127.0.0.1:%d-%d here, came through port %d\n", userID, steamID.c_str(),
+		HOST_UDP_BASE + slot * 2, HOST_UDP_BASE + slot * 2 + 1, tunnelPort);
+}
+
+void ServerTransfer::UnregisterRemote(int userID)
+{
+	g_Remotes.erase(userID);
+}
+
+UserNetworkConfig_s ServerTransfer::NetworkFor(IUser* subject, IUser* viewer)
+{
+	UserNetworkConfig_s n = subject->GetNetworkConfig();
+	auto s = g_Remotes.find(subject->GetID());
+	auto v = viewer ? g_Remotes.find(viewer->GetID()) : g_Remotes.end();
+	auto at = [&](int server, int client)
+	{
+		n.m_szExternalIpAddress = n.m_szLocalIpAddress = "127.0.0.1";
+		n.m_nExternalServerPort = n.m_nLocalServerPort = server;
+		n.m_nExternalClientPort = n.m_nLocalClientPort = client;
+	};
+	if (v == g_Remotes.end())
+	{
+		// this PC's game sees a remote player at that player's ports on this PC's bridge
+		if (s != g_Remotes.end())
+			at(HOST_UDP_BASE + s->second.slot * 2, HOST_UDP_BASE + s->second.slot * 2 + 1);
+	}
+	else if (s == g_Remotes.end())
+	{
+		// a remote player sees this PC's player at their own bridge's ports for this PC
+		int k = v->second.tunnelPort - 30003;
+		at(JOINER_UDP_BASE + k * 2, JOINER_UDP_BASE + k * 2 + 1);
+	}
+	else
+	{
+		// another remote player (or themselves): no route between two other PCs yet
+		at(0, 0);
+	}
+	if (g_bVerboseLog)
+		Logger().Info("detail: user %d sees user %d at %s ports %d (server) / %d (client)\n", viewer ? viewer->GetID() : 0, subject->GetID(),
+			n.m_szExternalIpAddress.c_str(), n.m_nExternalServerPort, n.m_nExternalClientPort);
+	return n;
+}
+
+void ServerTransfer::SetLocalGamePort(int portID, int port)
+{
+	if (portID == 0 || portID == 1)
+		g_LocalGamePorts[portID] = port;
+}
+
+string ServerTransfer::UdpJson()
+{
+	json remotes = json::array();
+	for (auto& r : g_Remotes)
+		remotes.push_back({ { "steamID", r.second.steamID }, { "slot", r.second.slot } });
+	return json({ { "myPorts", { g_LocalGamePorts[0], g_LocalGamePorts[1] } }, { "remotes", remotes } }).dump();
+}
