+int CUserDatabaseSQLite::AddCounters(int userID, const vector<UserCounter_s>& counters, bool best)
+{
+	try
+	{
+		SQLite::Transaction transaction(m_Database);
+		SQLite::Statement query(m_Database, best
+			? "INSERT INTO UserCounter VALUES (?, ?, ?, ?) ON CONFLICT (userID, mode, name) DO UPDATE SET value = MAX(value, excluded.value)"
+			: "INSERT INTO UserCounter VALUES (?, ?, ?, ?) ON CONFLICT (userID, mode, name) DO UPDATE SET value = value + excluded.value");
+		for (auto& c : counters)
+		{
+			query.bind(1, userID);
+			query.bind(2, c.mode);
+			query.bind(3, c.name);
+			query.bind(4, (int64_t)c.value);
+			query.exec();
+			query.reset();
+		}
+		transaction.commit();
+	}
+	catch (exception& e)
+	{
+		Logger().Error(OBFUSCATE("CUserDatabaseSQLite::AddCounters: database internal error: %s, %d\n"), e.what(), m_Database.getErrorCode());
