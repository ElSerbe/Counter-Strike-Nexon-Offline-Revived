+#pragma once
+
+// offline build: other people's servers in the game's server list, reached through the client's own "server
+// transfer" (Packet_Transfer -> the client reconnects to 127.0.0.1:<port> and sends TransferLogin).
+// The list is Data/RemoteServers.json, written by the Steam bridge (missing file: only this server is listed).
+
+#include <string>
+#include <vector>
+
+struct RemoteServer_s
+{
+	std::string name;
+	int port;          // on 127.0.0.1: the bridge's tunnel to that server (30003-30199; 30002 is this server)
+};
+
+namespace ServerTransfer
+{
+	std::vector<RemoteServer_s> LoadRemoteServers();
+	// a one-use ticket for the user's next TransferLogin (2 minutes)
+	std::string IssueTicket(const std::string& userName);
+	bool TakeTicket(const std::string& ticket, std::string& userName);
+}
