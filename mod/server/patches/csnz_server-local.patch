+// offline build: the medals as the client's honor quests (hw.dll Packet_Quest type 1, the full quest list): they are
+// what My Info's Medals tab shows, with a gauge per requirement. Quest ID = 2000 + title ID.
+void CPacketManager::SendHonorQuests(IExtendedSocket* socket, const vector<HonorQuest_s>& quests, int honorPoints)
+{
+	CSendPacket* msg = CreatePacket(socket, PacketId::Quest);
+	msg->BuildHeader();
+
+	msg->WriteUInt8(1);
+	msg->WriteUInt8(0); // kept by the quest manager (+100), unknown
+	msg->WriteUInt16(quests.size());
+	for (auto& q : quests)
+	{
+		// main info: flag 1 present, 2 type, 0x20 status, 0x400 title, 0x800 tab; any flag adds the "hidden" byte
+		msg->WriteUInt32(2000 + q.titleID);
+		msg->WriteUInt16(0x1 | 0x2 | 0x20 | 0x400 | 0x800);
+		msg->WriteUInt8(0);                 // hidden: 0 shows the medal's name and text
+		msg->WriteUInt8(2);                 // type: honor
+		msg->WriteUInt8(q.done ? 2 : 0);    // status: 0 in progress, 1 done, 2 done and rewarded
+		msg->WriteUInt16(q.titleID);
+		msg->WriteUInt8(q.category);
+
+		// tasks (the requirements): flag 1 present, 4 goals (cumulative, one per stage), 8 progress
+		msg->WriteUInt8(q.tasks.size());
+		for (size_t i = 0; i < q.tasks.size(); i++)
+		{
+			msg->WriteUInt8(i);
+			msg->WriteUInt8(0x1 | 0x4 | 0x8);
+			msg->WriteUInt8(1);
+			msg->WriteUInt32((unsigned int)min(q.tasks[i].first, 0x7fffffffLL));
+			msg->WriteUInt32((unsigned int)min(q.tasks[i].second, 0x7fffffffLL));
+		}
+		msg->WriteUInt8(0); // no rewards
+	}
+	// quest stat: flag 1 = honor points (the Medals tab's "Honor Points": the medals currency here)
+	msg->WriteUInt16(1);
+	msg->WriteUInt32(honorPoints);
+
+	socket->Send(msg);
+}
+
+// offline build: the game's Steam achievements (hw.dll Packet_Steam, id 192, calls ISteamUserStats). Type 0: stats
+// (SetStat, optionally IndicateAchievementProgress); type 1: achievements (SetAchievement), then StoreStats.
+// Only for clients started through Steam: the game has no ISteamUserStats otherwise.
+void CPacketManager::SendSteamStats(IExtendedSocket* socket, const vector<SteamStat_s>& stats, const vector<string>& achievements)
+{
+	if (!stats.empty())
+	{
+		CSendPacket* msg = CreatePacket(socket, PacketId::Steam);
+		msg->BuildHeader();
+		msg->WriteUInt8(0);
+		msg->WriteUInt16(stats.size());
+		for (auto& s : stats)
+		{
+			msg->WriteString(s.stat);
+			msg->WriteUInt32(s.value);
+			msg->WriteUInt8(s.indicate);
+			if (s.indicate)
+			{
+				msg->WriteUInt32(s.max);
+				msg->WriteString(s.achievement);
+			}
+		}
+		socket->Send(msg);
+	}
+
+	CSendPacket* msg = CreatePacket(socket, PacketId::Steam);
+	msg->BuildHeader();
+	msg->WriteUInt8(1);
+	msg->WriteUInt16(achievements.size());
+	for (auto& a : achievements)
+		msg->WriteString(a);
 	socket->Send(msg);
 }
 
