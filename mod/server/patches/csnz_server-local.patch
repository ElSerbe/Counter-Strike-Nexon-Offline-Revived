+// every mode with zombies (humans CT, zombies T): kills there are zombie kills or infections
+bool IsZombieModeOffline(int mode)
+{
+	static const int modes[] = { 8, 9, 14, 20, 24, 29, 30, 32, 35, 36, 37, 43, 44, 45, 54, 56, 58 };
+	return find(begin(modes), end(modes), mode) != end(modes);
+}
