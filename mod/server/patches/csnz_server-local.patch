+	int id;
+	std::string name;
+	std::string type; // "Season", "Event", ...
+	std::string description;
+	std::string image;
+	int cost; // medals to unlock the pass itself (0 = free)
+	std::vector<std::string> theme; // optional [dark, light] colours of the pass page
+	std::vector<WarbondPage> pages;
+};
+
+struct WarbondOrder
+{
+	int id;
+	std::string period; // "Daily", "Weekly" or "Challenge" (permanent, completed once)
+	std::string group;  // challenge book section
+	std::string text;
+	std::string type;   // see CWarbondManager::AdvanceOrders
+	std::vector<int> gameModes; // empty: any mode
+	int target;
+	int reward;
+	int tickets; // Bingo Tickets given on completion (besides the medals)
+};
+
+struct MedalRules
