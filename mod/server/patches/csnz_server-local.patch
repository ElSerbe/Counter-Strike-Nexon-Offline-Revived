diff --git a/src/manager/guestprofile.cpp b/src/manager/guestprofile.cpp
new file mode 100644
index 0000000..13016e4
--- /dev/null
+++ b/src/manager/guestprofile.cpp
@@ -0,0 +1,552 @@
+// offline build: a player's profile on another PC's server and back (see guestprofile.h)
+#include "guestprofile.h"
+#include "transfer.h"
+#include "usermanager.h"
+#include "packetmanager.h"
+#include "userdatabase.h"
+#include "bingomanager.h"
+#include "zsriftmanager.h"
+#include "interface/iroom.h"
+#include "interface/iuser.h"
+#include "command.h"
+
+#include <ctime>
+#include <fstream>
+#include <algorithm>
+#include <filesystem>
+#include <functional>
+#include <map>
+#include <vector>
+
+using namespace std;
+using json = nlohmann::json;
+
+namespace
+{
+	const char* kCheckoutsFile = "Data/GuestCheckouts.json";
+	const int kMailTimeout = 30;          // s: the bridge answers within 20 s
+	const int kProfileLifetime = 10 * 60; // s: a profile that came for a transfer that never happened is dropped
+	const int kResultRetries = 20, kResultRetryEvery = 30;
+
+	struct Mail_s
+	{
+		int id;
+		string to;
+		json body;
+		time_t created = 0, notBefore = 0, takenAt = 0;
+		bool taken = false;
+		int tries = 0;
+		function<void(bool ok, const string& error)> done;
+	};
+	vector<Mail_s> g_Outbox;
+	int g_NextMail = 1;
+
+	// home: this PC's accounts that are away, by user id
+	struct Checkout_s
+	{
+		string hostID, hostName, userName;
+		time_t since;
+	};
+	map<int, Checkout_s> g_Checkouts;
+	bool g_CheckoutsLoaded = false;
+
+	// host: profiles that came for a transfer (by the sender's Steam ID), and the guests on this server (by user id)
+	struct Incoming_s
+	{
+		json profile;
+		time_t at;
+	};
+	map<string, Incoming_s> g_Incoming;
+	struct Guest_s
+	{
+		string steamID;
+		bool finalSent = false;
+	};
+	map<int, Guest_s> g_Guests;
+
+	void LoadCheckouts()
+	{
+		if (g_CheckoutsLoaded)
+			return;
+		g_CheckoutsLoaded = true;
+		ifstream f(kCheckoutsFile);
+		if (!f.is_open())
+			return;
+		json j = json::parse(f, nullptr, false);
+		if (!j.is_object())
+			return;
+		for (auto& [key, c] : j.items())
+			g_Checkouts[atoi(key.c_str())] = { c.value("hostID", string()), c.value("hostName", string()), c.value("userName", string()), (time_t)c.value("since", (int64_t)0) };
+	}
+
+	void SaveCheckouts()
+	{
+		json j = json::object();
+		for (auto& [userID, c] : g_Checkouts)
+			j[to_string(userID)] = { { "hostID", c.hostID }, { "hostName", c.hostName }, { "userName", c.userName }, { "since", (int64_t)c.since } };
+		ofstream f(kCheckoutsFile);
+		f << j.dump(1);
+	}
+
+	int Send(const string& to, const json& body, function<void(bool, const string&)> done)
+	{
+		Mail_s m;
+		m.id = g_NextMail++;
+		m.to = to;
+		m.body = body;
+		m.done = done;
+		m.created = time(NULL);
+		g_Outbox.push_back(m);
+		return m.id;
+	}
+
+	// the profile as it travels: the database's profile tables plus the bingo and rift state
+	bool Export(int userID, json& out)
+	{
+		string tables;
+		if (!g_UserDatabase.ExportUserData(userID, tables))
+			return false;
+		out = json::parse(tables, nullptr, false);
+		if (!out.is_object())
+			return false;
+		out["bingo"] = g_BingoManager.ExportUser(userID);
+		out["zsrift"] = g_ZSRiftManager.ExportUser(userID);
+		out["version"] = 1;
+		return true;
+	}
+
+	string CharacterName(const json& profile);
+
+	bool Import(int userID, json profile, bool asGuest)
+	{
+		// a profile without its character would wipe the account: refused
+		if (!profile.is_object() || !profile.contains("tables") || CharacterName(profile).empty())
+		{
+			Logger().Warn("GuestProfiles: a profile without a character was refused (account %d)\n", userID);
+			return false;
+		}
+		if (!asGuest)
+		{
+			// this PC's own account: what it was before goes to Data/GuestBackups first (the last 10 are kept)
+			json before;
+			if (Export(userID, before))
+			{
+				namespace fs = std::filesystem;
+				std::error_code ec;
+				fs::create_directories("Data/GuestBackups", ec);
+				ofstream("Data/GuestBackups/" + to_string(userID) + "-" + to_string((long long)time(NULL)) + ".json") << before.dump();
+				vector<string> old;
+				for (auto& entry : fs::directory_iterator("Data/GuestBackups", ec))
+				{
+					string name = entry.path().filename().string();
+					if (name.rfind(to_string(userID) + "-", 0) == 0)
+						old.push_back(name);
+				}
+				sort(old.begin(), old.end());
+				for (size_t i = 0; i + 10 < old.size(); i++)
+					fs::remove("Data/GuestBackups/" + old[i], ec);
+			}
+		}
+		if (asGuest)
+		{
+			// no game master rights on someone else's server
+			auto ext = profile["tables"].find("UserCharacterExtended");
+			if (ext != profile["tables"].end())
+			{
+				const json& cols = (*ext)["columns"];
+				for (size_t c = 0; c < cols.size(); c++)
+					if (cols[c] == "gameMaster")
+						for (auto& row : (*ext)["rows"])
+							row[c] = 0;
+			}
+		}
+		if (!g_UserDatabase.ImportUserData(userID, json({ { "tables", profile["tables"] } }).dump(), asGuest, !asGuest))
+			return false;
+		g_BingoManager.ImportUser(userID, profile.value("bingo", json()));
+		g_ZSRiftManager.ImportUser(userID, profile.value("zsrift", json()));
+		return true;
+	}
+
+	string CharacterName(const json& profile)
+	{
+		try
+		{
+			const json& t = profile.at("tables").at("UserCharacter");
+			const json& cols = t.at("columns");
+			for (size_t c = 0; c < cols.size(); c++)
+				if (cols[c] == "gameName" && !t.at("rows").empty())
+					return t["rows"][0][c].get<string>();
+		}
+		catch (exception&) {}
+		return string();
+	}
+
+	// one try to hand a guest's profile to their PC; a last copy that doesn't get there is tried again for 10 minutes
+	// (their game may be restarting)
+	void SendResultMail(const string& steamID, const json& body, bool final, function<void(bool)> then, int tries)
+	{
+		Send(steamID, body, [steamID, body, final, then, tries](bool ok, const string& error)
+		{
+			bool again = !ok && final && tries + 1 < kResultRetries;
+			if (ok)
+				Logger().Info("GuestProfiles: Steam %s's PC took their profile back\n", steamID.c_str());
+			else
+				Logger().Warn("GuestProfiles: Steam %s's PC didn't take their profile (%s)%s\n", steamID.c_str(), error.c_str(), again ? ", trying again in 30 s" : "");
+			if (then)
+				then(ok);
+			if (again)
+			{
+				SendResultMail(steamID, body, final, nullptr, tries + 1);
+				g_Outbox.back().notBefore = time(NULL) + kResultRetryEvery;
+			}
+		});
+	}
+
+	// the host's server sends a guest's profile back home
+	void SendResult(int userID, bool final, function<void(bool)> then = nullptr)
+	{
+		auto g = g_Guests.find(userID);
+		json profile;
+		if (g == g_Guests.end() || !Export(userID, profile))
+		{
+			if (g != g_Guests.end())
+				Logger().Warn("GuestProfiles: couldn't read guest %d's profile to send it home\n", userID);
+			if (then)
+				then(false);
+			return;
+		}
+		Logger().Info("GuestProfiles: sending guest %d's profile back to their PC (Steam %s)%s\n", userID, g->second.steamID.c_str(), final ? ", their last copy" : "");
+		SendResultMail(g->second.steamID, { { "kind", "result" }, { "final", final }, { "profile", profile } }, final, then, 0);
+	}
+}
+// ------------------------------------------------------------ home side
+bool GuestProfiles::JoinRemote(IUser* user, const RemoteRoom_s& room, int port, const string& ticket)
+{
+	LoadCheckouts();
+	IExtendedSocket* socket = user->GetExtendedSocket();
+	if (room.hostID.empty())
+	{
+		g_PacketManager.SendUMsgNoticeMsgBoxToUuid(socket, room.host + "'s game is on an older version that can't take your profile.\nBoth of you need the latest version (the launcher's Update button).");
+		return false;
+	}
+	json profile;
+	if (!Export(user->GetID(), profile))
+	{
+		g_PacketManager.SendUMsgNoticeMsgBoxToUuid(socket, "Your profile couldn't be read, so you can't join other players' rooms right now.");
+		return false;
+	}
+	string gameName = user->GetCharacter(UFLAG_LOW_GAMENAME).gameName;
+	int userID = user->GetID();
+	string userName = user->GetUsername(), hostID = room.hostID, hostName = room.host;
+	g_PacketManager.SendUMsgNoticeMessageInChat(socket, "Sending your profile to " + hostName + "'s PC...");
+	Logger().Info("GuestProfiles: sending user %d's profile to %s (Steam %s) before joining their room\n", userID, hostName.c_str(), hostID.c_str());
+	Send(hostID, { { "kind", "profile" }, { "name", gameName }, { "profile", profile } },
+		[userID, userName, hostID, hostName, port, ticket, socket](bool ok, const string& error)
+	{
+		IUser* u = g_UserManager.GetUserById(userID);
+		if (!u || u->GetExtendedSocket() != socket || u->GetCurrentRoom())
+			return; // they left or did something else meanwhile
+		if (!ok)
+		{
+			Logger().Warn("GuestProfiles: %s's PC didn't take user %d's profile: %s\n", hostName.c_str(), userID, error.c_str());
+			g_PacketManager.SendUMsgNoticeMsgBoxToUuid(socket, "Your profile couldn't be sent to " + hostName + "'s PC (" + error + ").\nTry again in a moment.");
+			return;
+		}
+		g_Checkouts[userID] = { hostID, hostName, userName, time(NULL) };
+		SaveCheckouts();
+		Logger().Info("GuestProfiles: user %d plays on %s's server now; their profile comes back after every match\n", userID, hostName.c_str());
+		g_PacketManager.SendTransfer(socket, "127.0.0.1", port, ticket);
+	});
+	return true;
+}
+
+void GuestProfiles::OnLocalLogin(int userID)
+{
+	LoadCheckouts();
+	auto it = g_Checkouts.find(userID);
+	if (it == g_Checkouts.end())
+		return;
+	Logger().Info("GuestProfiles: user %d is back on this server; copies of their profile from %s that come later are ignored\n", userID, it->second.hostName.c_str());
+	g_Checkouts.erase(it);
+	SaveCheckouts();
+}
+
+bool GuestProfiles::AwayOnHost(string& hostName)
+{
+	LoadCheckouts();
+	if (g_Checkouts.empty())
+		return false;
+	hostName = g_Checkouts.begin()->second.hostName;
+	return true;
+}
+
+// ------------------------------------------------------------ host side
+bool GuestProfiles::LoadIncoming(const string& steamID, int userID)
+{
+	auto it = g_Incoming.find(steamID);
+	if (it == g_Incoming.end())
+		return false;
+	json profile = it->second.profile;
+	g_Incoming.erase(it);
+	if (!Import(userID, profile, true))
+	{
+		Logger().Warn("GuestProfiles: couldn't load Steam %s's profile into account %d\n", steamID.c_str(), userID);
+		return false;
+	}
+	// the character name must be free on this server
+	string name = CharacterName(profile);
+	if (!name.empty())
+	{
+		string use = name;
+		for (int i = 2; i < 30; i++)
+		{
+			int owner = g_UserDatabase.IsUserExists(use, false);
+			if (owner == 0 || owner == userID)
+				break;
+			use = name.substr(0, 13) + "_" + to_string(i);
+		}
+		if (use != name)
+		{
+			CUserCharacter character = {};
+			character.lowFlag = UFLAG_LOW_GAMENAME;
+			character.gameName = use;
+			g_UserDatabase.UpdateCharacter(userID, character);
+			Logger().Info("GuestProfiles: '%s' is taken here, Steam %s plays as '%s'\n", name.c_str(), steamID.c_str(), use.c_str());
+		}
+	}
+	Logger().Info("GuestProfiles: Steam %s plays here with their own profile (account %d)\n", steamID.c_str(), userID);
+	return true;
+}
+
+void GuestProfiles::OnGuestLogin(int userID, const string& steamID)
+{
+	g_Guests[userID] = { steamID, false };
+}
+
+bool GuestProfiles::IsGuest(int userID)
+{
+	return g_Guests.count(userID) != 0;
+}
+
+void GuestProfiles::OnMatchEnd(IRoom* room)
+{
+	if (!room || g_Guests.empty())
+		return;
+	for (auto u : room->GetUsers())
+		if (IsGuest(u->GetID()))
+			SendResult(u->GetID(), false);
+}
+
+bool GuestProfiles::GoHome(IUser* user, const string& back)
+{
+	auto g = g_Guests.find(user->GetID());
+	if (g == g_Guests.end())
+		return false;
+	g->second.finalSent = true;
+	int userID = user->GetID();
+	IExtendedSocket* socket = user->GetExtendedSocket();
+	g_PacketManager.SendUMsgNoticeMessageInChat(socket, "Sending your profile home...");
+	SendResult(userID, true, [userID, socket, back](bool ok)
+	{
+		IUser* u = g_UserManager.GetUserById(userID);
+		if (!u || u->GetExtendedSocket() != socket)
+			return;
+		if (!ok)
+			g_PacketManager.SendUMsgNoticeMessageInChat(socket, "Your PC didn't answer: this server keeps trying to send your profile home for 10 minutes.");
+		g_PacketManager.SendTransfer(socket, "127.0.0.1", 30002, back);
+	});
+	return true;
+}
+
+void GuestProfiles::Forget(int userID)
+{
+	g_Guests.erase(userID);
+}
+
+void GuestProfiles::OnGuestLeft(int userID)
+{
+	auto g = g_Guests.find(userID);
+	if (g == g_Guests.end())
+		return;
+	if (!g->second.finalSent)
+		SendResult(userID, true);
+	g_Guests.erase(userID);
+}
+
+// ------------------------------------------------------------ a test on one PC
+// Console: guesttest <userName> (the account logged out, the Steam bridge running with --loopback). The whole trip
+// through the bridge: the profile goes "away" to this same server's steam_<own Steam ID> guest account, the guest gets
+// 1000 points there, the profile comes back into the account. The log tells each step; Data/GuestBackups keeps the
+// account as it was.
+static void GuestTest(CCommand*, const vector<string>& args)
+{
+	if (args.size() < 2)
+	{
+		Logger().Info("guesttest <userName>\n");
+		return;
+	}
+	string userName = args[1], steamID, steamName;
+	int userID = g_UserDatabase.IsUserExists(userName, true);
+	if (userID <= 0 || g_UserManager.GetUserById(userID))
+	{
+		Logger().Info("guesttest: no account '%s', or it's logged in\n", userName.c_str());
+		return;
+	}
+	if (!ServerTransfer::LoadSteamIdentity(steamID, steamName))
+	{
+		Logger().Info("guesttest: the Steam bridge isn't running\n");
+		return;
+	}
+	json profile;
+	if (!Export(userID, profile))
+		return;
+	auto points = [](int id) { CUserCharacter c = {}; c.lowFlag = UFLAG_LOW_POINTS | UFLAG_LOW_GAMENAME; g_UserDatabase.GetCharacter(id, c); return c; };
+	Logger().Info("guesttest: '%s' has %d points; sending their profile to this PC's own Steam ID %s\n", userName.c_str(), points(userID).points, steamID.c_str());
+	Send(steamID, { { "kind", "profile" }, { "name", userName }, { "profile", profile } }, [=](bool ok, const string& error)
+	{
+		if (!ok)
+		{
+			Logger().Info("guesttest: the profile didn't go through: %s\n", error.c_str());
+			return;
+		}
+		string guestName = "steam_" + steamID;
+		int guestID = g_UserDatabase.IsUserExists(guestName, true);
+		if (guestID <= 0)
+			g_UserDatabase.Register(guestName, "ptest" + steamID.substr(steamID.size() - 6), "steam-" + steamID);
+		guestID = g_UserDatabase.IsUserExists(guestName, true);
+		if (guestID <= 0 || !GuestProfiles::LoadIncoming(steamID, guestID))
+		{
+			Logger().Info("guesttest: the guest account couldn't take the profile\n");
+			return;
+		}
+		CUserCharacter g = points(guestID);
+		Logger().Info("guesttest: guest account %d is '%s' with %d points; +1000 as a match reward\n", guestID, g.gameName.c_str(), g.points);
+		CUserCharacter add = {};
+		add.lowFlag = UFLAG_LOW_POINTS;
+		add.points = g.points + 1000;
+		g_UserDatabase.UpdateCharacter(guestID, add);
+		g_Checkouts[userID] = { steamID, "this PC (test)", userName, time(NULL) };
+		SaveCheckouts();
+		GuestProfiles::OnGuestLogin(guestID, steamID);
+		SendResult(guestID, true, [=](bool back)
+		{
+			g_Guests.erase(guestID);
+			CUserCharacter after = points(userID);
+			Logger().Info("guesttest: %s; '%s' (%s) has %d points now, checkout %s\n", back ? "the profile came back" : "the profile did NOT come back",
+				userName.c_str(), after.gameName.c_str(), after.points, g_Checkouts.count(userID) ? "still open" : "closed");
+		});
+	});
+}
+static CCommand guesttest("guesttest", "Test of carrying a profile to another server and back (Steam bridge with --loopback)", "guesttest <userName>", GuestTest);
+
+// ------------------------------------------------------------ the bridge's API
+json GuestProfiles::Outbox()
+{
+	LoadCheckouts();
+	time_t now = time(NULL);
+	Tick(now);
+	json mail = json::array();
+	for (auto& m : g_Outbox)
+		if (!m.taken && now >= m.notBefore)
+		{
+			m.taken = true;
+			m.takenAt = now;
+			mail.push_back({ { "id", m.id }, { "to", m.to }, { "text", m.body.dump() } }); // the bridge passes the text on as it is
+		}
+	// the bridge accepts P2P sessions from these PCs: the hosts this PC's players are away on, and this server's guests
+	json peers = json::array();
+	for (auto& [userID, c] : g_Checkouts)
+		peers.push_back(c.hostID);
+	for (auto& [userID, g] : g_Guests)
+		peers.push_back(g.steamID);
+	for (auto& m : g_Outbox)
+		peers.push_back(m.to);
+	return { { "mail", mail }, { "peers", peers } };
+}
+
+json GuestProfiles::Sent(const json& body)
+{
+	int id = body.value("id", 0);
+	bool ok = body.value("ok", false);
+	string error = body.value("error", string(ok ? "" : "no answer"));
+	for (auto it = g_Outbox.begin(); it != g_Outbox.end(); ++it)
+		if (it->id == id)
+		{
+			auto done = it->done;
+			g_Outbox.erase(it);
+			if (done)
+				done(ok, error);
+			return { { "ok", true } };
+		}
+	return { { "ok", false } };
+}
+
+json GuestProfiles::Inbox(const json& body)
+{
+	LoadCheckouts();
+	string from = body.value("from", string());
+	const json& mail = body.contains("body") ? body["body"] : json();
+	string kind = mail.is_object() ? mail.value("kind", string()) : string();
+	if (from.empty() || from.find_first_not_of("0123456789") != string::npos)
+		return { { "ok", false }, { "error", "bad sender" } };
+
+	if (kind == "profile")
+	{
+		// a player's server, just before their game transfers here
+		if (!mail.contains("profile") || !mail["profile"].is_object())
+			return { { "ok", false }, { "error", "no profile" } };
+		g_Incoming[from] = { mail["profile"], time(NULL) };
+		Logger().Info("GuestProfiles: Steam %s's profile came (%s), for their transfer to this server\n", from.c_str(), mail.value("name", string()).c_str());
+		return { { "ok", true } };
+	}
+	if (kind == "result")
+	{
+		// a host's server sends a player of this PC their profile back
+		for (auto& [userID, c] : g_Checkouts)
+		{
+			if (c.hostID != from)
+				continue;
+			if (g_UserManager.GetUserById(userID))
+			{
+				Logger().Info("GuestProfiles: ignored a profile from %s: user %d is playing on this server\n", c.hostName.c_str(), userID);
+				return { { "ok", true }, { "ignored", true } };
+			}
+			bool final = mail.value("final", false);
+			if (!Import(userID, mail.value("profile", json()), false))
+				return { { "ok", false }, { "error", "couldn't store the profile" } };
+			Logger().Info("GuestProfiles: user %d's profile came back from %s's server%s\n", userID, c.hostName.c_str(), final ? " (they left it)" : "");
+			if (final)
+			{
+				g_Checkouts.erase(userID);
+				SaveCheckouts();
+			}
+			return { { "ok", true } };
+		}
+		Logger().Info("GuestProfiles: ignored a profile from Steam %s: no player of this PC is away on their server\n", from.c_str());
+		return { { "ok", true }, { "ignored", true } };
+	}
+	return { { "ok", false }, { "error", "unknown mail" } };
+}
+
+void GuestProfiles::Tick(time_t now)
+{
+	// mail the bridge took but never answered for, or that no bridge picked up (online play isn't running), fails
+	for (size_t i = 0; i < g_Outbox.size(); )
+	{
+		Mail_s& m = g_Outbox[i];
+		time_t waiting = max(m.created, m.notBefore);
+		bool stale = m.taken ? now - m.takenAt > kMailTimeout : now >= m.notBefore && now - waiting > kMailTimeout;
+		if (!stale)
+		{
+			i++;
+			continue;
+		}
+		auto done = m.done;
+		bool taken = m.taken;
+		g_Outbox.erase(g_Outbox.begin() + i);
+		if (done)
+			done(false, taken ? "no answer from the other PC" : "online play isn't running");
+	}
+	for (auto it = g_Incoming.begin(); it != g_Incoming.end();)
+		it = now - it->second.at > kProfileLifetime ? g_Incoming.erase(it) : next(it);
+}
diff --git a/src/manager/guestprofile.h b/src/manager/guestprofile.h
new file mode 100644
index 0000000..361d895
--- /dev/null
+++ b/src/manager/guestprofile.h
@@ -0,0 +1,46 @@
+#pragma once
+
+// offline build: a player's own profile travels with them to another PC's server (Steam online play) and back.
+//
+// The player's server ("home") sends their whole profile (every profile table of the database, bingo and Zombie
+// Disaster Zone state) to the room host's server before the transfer; the host loads it into the player's guest account
+// there (steam_<Steam ID>), so they play with their own level, inventory, loadouts, medals and missions. After every
+// match and when they leave, the host sends the profile back and home stores it in the player's account ("checkout":
+// home only takes it from that host while the player is away; once they log in at home again, late copies are ignored).
+//
+// The servers talk through their Steam bridges ("mail"): GET /api/guest/outbox gives the bridge what to send (and the
+// Steam IDs whose P2P sessions it should accept), POST /api/guest/sent says whether the other side took it, POST
+// /api/guest/inbox hands over what came from another PC. The bridge proves who sent what (the P2P sender's Steam ID).
+
+#include <string>
+#include "nlohmann/json.hpp"
+
+class IUser;
+class IRoom;
+struct RemoteRoom_s;
+
+namespace GuestProfiles
+{
+	// home: sends the profile to the room's host, then transfers the client there with the ticket
+	bool JoinRemote(IUser* user, const RemoteRoom_s& room, int port, const std::string& ticket);
+	// home: the player logged in here again: their checkout ends
+	void OnLocalLogin(int userID);
+	// home: a player of this PC is away on another PC's server (for the web pages' message); hostName gets its name
+	bool AwayOnHost(std::string& hostName);
+
+	// host: loads the profile a player's server sent into their guest account; false when none came
+	bool LoadIncoming(const std::string& steamID, int userID);
+	void OnGuestLogin(int userID, const std::string& steamID);
+	bool IsGuest(int userID);
+	// host: the profiles go back after every match and when the guest leaves
+	void OnMatchEnd(IRoom* room);
+	bool GoHome(IUser* user, const std::string& back); // /home: profile back first, then the transfer
+	void OnGuestLeft(int userID);
+	void Forget(int userID); // an old connection of a guest who is coming in again: nothing goes home from it
+
+	// the bridge's API
+	nlohmann::json Outbox();
+	nlohmann::json Sent(const nlohmann::json& body);
+	nlohmann::json Inbox(const nlohmann::json& body);
+	void Tick(time_t now);
+}
