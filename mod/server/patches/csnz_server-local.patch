+// ---------------------------------------------------------------- the calendar
+
+int CMissionManager::PeriodStart(int day)
+{
+	int n = max(1, m_PeriodDays), d = day - FirstSunday;
+	return FirstSunday + (d >= 0 ? d / n : -((-d + n - 1) / n)) * n;
+}
+
+// local midnight `offset` days from today
+static time_t LocalMidnight(int offset)
+{
+	time_t now = time(NULL);
+	tm t = *localtime(&now);
+	t.tm_hour = t.tm_min = t.tm_sec = 0;
+	t.tm_mday += offset;
+	t.tm_isdst = -1;
+	return mktime(&t);
+}
+
+static int PopCount(unsigned long long v)
+{
+	int n = 0;
+	for (; v; v &= v - 1)
+		n++;
+	return n;
+}
+
+// counters: LoginPeriod = the day the user's current calendar started, LoginCollected = its days collected (bits),
+// LoginBonuses = its bonuses given (bits), LoginRewards = days ever collected (a statistic). Another period: all clear.
+CMissionManager::LoginState CMissionManager::GetLoginState(int userID)
+{
+	vector<UserCounter_s> counters;
+	g_UserDatabase.GetCounters(userID, counters);
+	LoginState s = { 0, 0, 0 };
+	for (auto& c : counters)
+		if (c.mode != -1)
+			continue;
+		else if (c.name == "LoginPeriod")
+			s.period = (int)c.value;
+		else if (c.name == "LoginCollected")
+			s.collected = c.value;
+		else if (c.name == "LoginBonuses")
+			s.bonuses = c.value;
+	int start = PeriodStart(Today());
+	if (s.period != start)
+		s = { start, 0, 0 };
+	return s;
+}
+
+static RewardItem ShownItem(const LoginReward& r)
+{
+	RewardItem item = {};
+	item.itemID = r.itemID;
+	item.count = r.count;
+	item.duration = r.days;
+	return item;
+}
+
+void CMissionManager::SendLoginSupplies(IUser* user)
+{
+	if (!m_LoginEnabled || !user)
+		return;
+	int today = Today(), start = PeriodStart(today), index = today - start;
+	LoginState s = GetLoginState(user->GetID());
+
+	LoginSuppliesInfo info;
+	info.canGet = index >= 0 && index < m_PeriodDays && !((s.collected >> index) & 1);
+	info.start = (unsigned int)LocalMidnight(start - today);
+	info.end = (unsigned int)LocalMidnight(start + m_PeriodDays - today) - 1;
+	info.collected = (unsigned long long)s.collected;
+	info.collectedCount = PopCount(info.collected);
+	info.bonusMask = (int)s.bonuses;
+	for (auto& d : m_LoginDays)
+		info.days.push_back(ShownItem(d));
+	for (auto& b : m_LoginBonuses)
+		info.bonuses.push_back({ b.after, ShownItem(b) });
+	g_PacketManager.SendItemDailyRewardsUpdate(user->GetExtendedSocket(), info);
+	m_LoginSentDay[user->GetID()] = today;
+}
+
+void CMissionManager::OnLogin(IUser* user)
+{
+	if (!m_LoginEnabled || !user)
+		return;
+	SendLoginSupplies(user);
+	int today = Today(), index = today - PeriodStart(today);
+	LoginState s = GetLoginState(user->GetID());
+	if (index < m_PeriodDays && !((s.collected >> index) & 1))
+		g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(),
+			va("Today's Login Supplies are ready (%s): Login Supplies button, bottom right of the lobby.", RewardName(m_LoginDays[index]).c_str()));
+}
+
+void CMissionManager::OnMatchEnd(IUser* user)
+{
+	if (!m_LoginEnabled || !user)
+		return;
+	auto it = m_LoginSentDay.find(user->GetID());
+	if (it == m_LoginSentDay.end() || it->second != Today())
+		SendLoginSupplies(user);
+}
+
+string CMissionManager::RewardName(const LoginReward& r)
+{
+	string name = r.name;
+	if (name.empty() && r.itemID)
+	{
+		name = g_WarbondManager.ItemName(r.itemID);
+		if (name.empty())
+			name = va("item %d", r.itemID);
+	}
+	if (!name.empty() && r.count > 1)
+		name += va(" x%d", r.count);
+	return name;
+}
+
+// gives a reward: its item (shown in the window) and currencies; the text for the chat line
+string CMissionManager::Give(IUser* user, const LoginReward& r, vector<RewardItem>& shown)
+{
+	int userID = user->GetID();
+	vector<string> parts;
+	if (r.itemID)
+	{
+		int added = g_ItemManager.AddItem(userID, user, r.itemID, r.count, r.days);
+		if (added == ITEM_ADD_SUCCESS)
+		{
+			shown.push_back(ShownItem(r));
+			parts.push_back(RewardName(r));
+		}
+		else
+			Logger().Warn("MissionManager: couldn't give item %d to user %d (%d)\n", r.itemID, userID, added);
+	}
+	if (r.medals)
+	{
+		user->UpdatePoints(r.medals);
+		parts.push_back(va("%d medals", r.medals));
+	}
+	if (r.badges)
+	{
+		g_MedalManager.AddCounter(user, "BlackBadges", r.badges);
+		parts.push_back(va("%d Black Badge%s", r.badges, r.badges == 1 ? "" : "s"));
+	}
+	if (r.riftTickets)
+	{
+		g_MedalManager.AddCounter(user, "RiftTickets", r.riftTickets);
+		parts.push_back(va("%d Rift Ticket%s", r.riftTickets, r.riftTickets == 1 ? "" : "s"));
+	}
+	if (r.bingoTickets)
+	{
+		g_BingoManager.GiveTickets(user, r.bingoTickets, NULL);
+		parts.push_back(va("%d Bingo Ticket%s", r.bingoTickets, r.bingoTickets == 1 ? "" : "s"));
+	}
+	string text;
+	for (size_t i = 0; i < parts.size(); i++)
+		text += (i ? ", " : "") + parts[i];
+	return text;
+}
+
+void CMissionManager::OnLoginSuppliesRequest(IUser* user, int request)
+{
+	if (!user)
+		return;
+	if (!m_LoginEnabled)
+	{
+		g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), "Login Supplies are off on this server (Data/DailyLogin.json).");
+		return;
+	}
+	if (request != 1)
+	{
+		if (request != 0)
+			Logger().Warn("MissionManager: Login Supplies request %d from user %d\n", request, user->GetID());
+		SendLoginSupplies(user);
+		return;
+	}
+
+	int userID = user->GetID(), today = Today(), index = today - PeriodStart(today);
+	LoginState s = GetLoginState(userID);
+	if (index >= m_PeriodDays || ((s.collected >> index) & 1))
+	{
+		g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), "Today's Login Supplies are already collected. Come back tomorrow!");
+		SendLoginSupplies(user);
+		return;
+	}
+
+	// written first: a second click while this one runs gives nothing
+	s.collected |= 1LL << index;
+	int count = PopCount((unsigned long long)s.collected);
+	vector<int> bonuses;
+	for (size_t b = 0; b < m_LoginBonuses.size(); b++)
+		if (!((s.bonuses >> b) & 1) && count >= m_LoginBonuses[b].after)
+		{
+			s.bonuses |= 1LL << b;
+			bonuses.push_back((int)b);
+		}
+	g_UserDatabase.SetCounter(userID, { -1, "LoginPeriod", s.period });
+	g_UserDatabase.SetCounter(userID, { -1, "LoginCollected", s.collected });
+	g_UserDatabase.SetCounter(userID, { -1, "LoginBonuses", s.bonuses });
+	g_MedalManager.AddCounter(user, "LoginRewards", 1);
+
+	vector<RewardItem> shown;
+	string text = Give(user, m_LoginDays[index], shown);
+	for (int b : bonuses)
+	{
+		string bonus = Give(user, m_LoginBonuses[b], shown);
+		if (!bonus.empty())
+			text += va("%s%s (bonus for %d days)", text.empty() ? "" : "; ", bonus.c_str(), m_LoginBonuses[b].after);
+	}
+	g_PacketManager.SendItemDailyRewardsSpinResult(user->GetExtendedSocket(), (unsigned long long)s.collected, count, shown);
+	g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(),
+		va("Login Supplies, day %d of %d (%d collected): %s.", index + 1, m_PeriodDays, count, text.c_str()));
+	Logger().Info("MissionManager: user %d collected Login Supplies day %d of %d (%d collected): %s\n", userID, index + 1, m_PeriodDays, count, text.c_str());
+	m_LoginSentDay[userID] = today;
+	g_MedalManager.CheckMedals(user);
+}
+
+json CMissionManager::RewardJson(const LoginReward& r)
+{
+	return { { "name", RewardName(r) }, { "itemID", r.itemID }, { "count", r.count }, { "days", r.days }, { "medals", r.medals },
+		{ "badges", r.badges }, { "riftTickets", r.riftTickets }, { "bingoTickets", r.bingoTickets }, { "after", r.after } };
+}
+
+// the Missions page's Login Supplies tab: the same calendar as the game's window
+json CMissionManager::LoginJson(IUser* user)
+{
+	if (!m_LoginEnabled)
+		return nullptr;
+	int today = Today(), start = PeriodStart(today);
+	LoginState s = GetLoginState(user->GetID());
+	json days = json::array(), bonuses = json::array();
+	for (size_t i = 0; i < m_LoginDays.size(); i++)
+	{
+		json d = RewardJson(m_LoginDays[i]);
+		d["collected"] = ((s.collected >> i) & 1) != 0;
+		days.push_back(d);
+	}
+	for (size_t b = 0; b < m_LoginBonuses.size(); b++)
+	{
+		json d = RewardJson(m_LoginBonuses[b]);
+		d["given"] = ((s.bonuses >> b) & 1) != 0;
+		bonuses.push_back(d);
+	}
+	return { { "days", days }, { "bonuses", bonuses }, { "today", today - start }, { "start", (long long)LocalMidnight(start - today) },
+		{ "collected", PopCount((unsigned long long)s.collected) }, { "nextIn", SecondsToMidnight() } };
+}
+
+// ---------------------------------------------------------------- the tutorial
+
+int CMissionManager::TutorialFlags(int userID)
+{
+	auto it = m_TutorialFlags.find(userID);
+	if (it != m_TutorialFlags.end())
+		return it->second;
+	vector<UserCounter_s> counters;
+	g_UserDatabase.GetCounters(userID, counters);
+	int flags = 0;
+	for (auto& c : counters)
+		if (c.mode == -1 && c.name == "TutorialFlags")
+			flags = (int)c.value;
+	m_TutorialFlags[userID] = flags;
+	return flags;
+}
+
+void CMissionManager::OnTutorialUpdate(IUser* user, int value)
+{
+	if (!user)
+		return;
+	int userID = user->GetID(), before = TutorialFlags(userID), after = before | (value & 0xff);
+	Logger().Info("MissionManager: user %d tutorial update %d (bits %d -> %d)\n", userID, value, before, after);
+	if (after == before)
+		return;
+	m_TutorialFlags[userID] = after;
+	g_UserDatabase.SetCounter(userID, { -1, "TutorialFlags", after });
+
+	vector<RewardItem> shown;
+	string text;
+	int medals = 0;
+	for (auto& r : m_TutorialRewards)
+	{
+		if (r.bit < 0 || r.bit > 7 || !((after >> r.bit) & 1) || ((before >> r.bit) & 1))
+			continue;
+		string part = Give(user, r, shown);
+		medals += r.medals;
+		if (!part.empty())
+			text += (text.empty() ? "" : ", ") + part;
+	}
+	if (!text.empty())
+	{
+		RewardNotice notice = {};
+		notice.status = true;
+		notice.points = medals;
+		notice.items = shown;
+		g_PacketManager.SendUMsgRewardNotice(user->GetExtendedSocket(), notice, "Tutorial reward",
+			"Thanks for playing the tutorial! Use the coupons from the Inventory.", false);
+		g_PacketManager.SendUMsgNoticeMessageInChat(user->GetExtendedSocket(), "Tutorial reward: " + text + ".");
+		Logger().Info("MissionManager: user %d tutorial reward: %s\n", userID, text.c_str());
+	}
+	// the tutorial window's progress
+	CUserCharacter character = user->GetCharacter(UFLAG_LOW_UNK15);
+	g_PacketManager.SendUserUpdateInfo(user->GetExtendedSocket(), user, character);
+}
