+#pragma once
+
+#include <string>
+#include <functional>
+
+#include "common/thread.h"
+
+struct WebRequest
+{
+	std::string clientIP;
+	std::string method;
+	std::string path; // without the query string
+	std::string query; // after '?', raw
+	std::string contentType;
+	std::string headers; // raw header lines, for logging
+	std::string body;
+};
+
+struct WebResponse
+{
+	int status = 200;
+	std::string contentType = "application/json; charset=utf-8";
+	std::string body;
+};
+
+/**
+ * Offline build: minimal HTTP/1.1 server for the in-game web shop (CEF). Serves static files from a folder and
+ * passes /api/ requests to a handler. One thread per connection, "Connection: close" on every response.
+ */
+class CWebServer
+{
+public:
+	typedef std::function<WebResponse(const WebRequest&)> ApiHandler;
+
+	CWebServer();
+	~CWebServer();
+
+	bool Start(const std::string& bindIP, int port, const std::string& root, const ApiHandler& apiHandler);
+	void Stop();
+	// Studio (voxel maps): the game's own REST paths (/v4/, /v5/, /v6/, /resources_prod/, /images_prod/)
+	void SetStudioHandler(const ApiHandler& handler) { m_StudioHandler = handler; }
+	static bool IsStudioPath(const std::string& path);
+
+private:
+	static void* ListenThread(void* data);
+	void Listen();
+	void HandleClient(unsigned long long clientSocket, const std::string& clientIP);
+	WebResponse ServeFile(const std::string& path);
+
+	CThread m_Thread;
+	unsigned long long m_ListenSocket;
+	volatile bool m_bRunning;
+	std::string m_Root;
+	ApiHandler m_ApiHandler;
+	ApiHandler m_StudioHandler;
+};
