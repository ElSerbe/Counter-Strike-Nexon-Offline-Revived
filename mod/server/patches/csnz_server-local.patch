+int CUserDatabaseSQLite::GetWarbondUnlocks(int userID, vector<WarbondUnlock_s>& unlocks)
+{
+	try
+	{
+		SQLite::Statement query(m_Database, OBFUSCATE("SELECT warbondID, itemID, cost FROM UserWarbondUnlock WHERE userID = ?"));
+		query.bind(1, userID);
+		while (query.executeStep())
+			unlocks.push_back({ query.getColumn(0), query.getColumn(1), query.getColumn(2) });
+	}
+	catch (exception& e)
+	{
+		Logger().Error(OBFUSCATE("CUserDatabaseSQLite::GetWarbondUnlocks: database internal error: %s, %d\n"), e.what(), m_Database.getErrorCode());
+		return 0;
+	}
+
+	return 1;
+}
